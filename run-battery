#!/bin/bash
# run-battery -- run the full raptor-test battery consistently across
# every backend a target exposes, from a targets/<name>.conf manifest.
#
# The point: the SAME comprehensive suite runs on every target and
# every backend (rsd, rsd-555, SRT). Legs a target does not expose are
# recorded as n/a, never silently dropped, so coverage cannot drift
# between devices.
#
#   ./run-battery <target>        one target, all its backends
#   ./run-battery --all           every targets/*.conf, then a matrix
#   ./run-battery --list          list defined targets
#
# Bring-up: opt-in per target. A manifest that declares DAEMONS_BASE
# (plus DAEMON_BIN and SSH) hands the runner its daemon lifecycle, and
# each pass then runs the production-shaped set for that backend —
# service daemons included, the RTSP twins never together. Manifests
# without DAEMONS_BASE are untouched: the runner tests whatever is
# already running and manages nothing. Building and deploying binaries
# is always the caller's job. See targets/README.md.
set -u

DIR="$(cd "$(dirname "$0")" && pwd)"
TDIR="$DIR/targets"
SUITE="$DIR/raptor-test"

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

list_targets() {
    for f in "$TDIR"/*.conf; do
        [ "$(basename "$f")" = "_template.conf" ] && continue
        [ -e "$f" ] && basename "$f" .conf
    done
}

[ $# -ge 1 ] || usage 1
case "$1" in
    -h|--help) usage 0 ;;
    --list) list_targets; exit 0 ;;
esac

# Canonical start order: the ring producer first (it creates the rings
# every consumer opens), then audio, then the service daemons, then the
# stream backends. Also the kill list.
CANON_ORDER="rvd rfs rad rod ric rmd rmr rsd rsd-555 rsr rhd rwd rsp rwc"

# Each daemon gates on its own config section, so a profile is config
# plus processes: starting rwd while [webrtc] is disabled just makes it
# log and exit, and the leg that needed it fails for a reason that has
# nothing to do with the code under test. Bring-up enables exactly the
# sections its set needs (never disables anything else). RVD and RFS
# have no gate.
section_for() {
    case $1 in
    rad) echo audio ;;      rod) echo osd ;;         ric) echo ircut ;;
    rmd) echo motion ;;     rmr) echo recording ;;   rsd|rsd-555) echo rtsp ;;
    rsr) echo srt ;;        rhd) echo http ;;        rwd) echo webrtc ;;
    rsp) echo push ;;       rwc) echo webcam ;;      *) echo "" ;;
    esac
}

# bringup <listen-port|-> <daemon...> — replace whatever is running on
# the target with exactly this set. No-op unless the manifest opted in.
bringup() {
    local wait_port=$1
    shift
    [ -n "$DAEMONS_BASE" ] || return 0
    if [ -z "$SSH" ] || [ -z "$DAEMON_BIN" ]; then
        echo "  BRING-UP SKIPPED: DAEMONS_BASE set but SSH=/DAEMON_BIN= missing" >&2
        return 1
    fi
    local want=$* ordered="" d w
    for d in $CANON_ORDER; do
        for w in $want; do
            [ "$d" = "$w" ] && ordered="$ordered $d"
        done
    done
    local sections="" s
    for d in $ordered; do
        s=$(section_for "$d")
        [ -n "$s" ] && case " $sections " in *" $s "*) ;; *) sections="$sections $s" ;; esac
    done
    echo "--- bring-up:$ordered ---"
    # Readiness is polled, never slept: the ring must exist before
    # consumers start (a consumer racing rvd gets a video-less SDP) and
    # an NFS-hosted binary path may mount seconds after boot.
    if ! ssh -o ConnectTimeout=10 "$SSH" "
        set -u
        case '$DAEMON_BIN' in /mnt/nfs*)
            for i in \$(seq 30); do mount | grep -q /mnt/nfs && break; sleep 1; done ;;
        esac
        # Graceful first, and WAIT: RVD tears down the ISP/encoder in
        # its SIGTERM path, and SIGKILLing it mid-teardown leaves the
        # driver dirty enough that the next RVD hangs in IMP init.
        # Poll for exit instead of guessing a sleep; anything still
        # alive after 20s gets -9 and is named (a daemon that will not
        # exit on TERM is itself a bug worth seeing).
        killall $CANON_ORDER 2>/dev/null
        for i in \$(seq 40); do
            pidof $CANON_ORDER >/dev/null 2>&1 || break
            sleep 0.5
        done
        if pidof $CANON_ORDER >/dev/null 2>&1; then
            for p in \$(pidof $CANON_ORDER); do
                echo \"  WARNING: \$(cat /proc/\$p/comm 2>/dev/null) ignored SIGTERM, killing\"
            done
            killall -9 $CANON_ORDER 2>/dev/null
            sleep 2
        fi
        rm -f /dev/shm/rss_ring_* 2>/dev/null
        for s in$sections; do
            grep -q \"^\\[\$s\\]\" '$CONFIG_PATH' || printf '\\n[%s]\\n' \"\$s\" >>'$CONFIG_PATH'
            sed -i \"/^\\[\$s\\]/,/^\\[/{/^enabled *=/d}\" '$CONFIG_PATH'
            sed -i \"/^\\[\$s\\]/a enabled = true\" '$CONFIG_PATH'
        done
        # Manifest config overrides (CONF_SET: section.key=value,
        # space-separated, values without spaces) — some legs need the
        # device pointed at the runner, e.g. push.url for the RTMP leg.
        for kv in $CONF_SET; do
            sec=\${kv%%.*}; rest=\${kv#*.}
            key=\${rest%%=*}; val=\${rest#*=}
            grep -q \"^\\[\$sec\\]\" '$CONFIG_PATH' || printf '\\n[%s]\\n' \"\$sec\" >>'$CONFIG_PATH'
            sed -i \"/^\\[\$sec\\]/,/^\\[/{/^\$key *=/d}\" '$CONFIG_PATH'
            sed -i \"/^\\[\$sec\\]/a \$key = \$val\" '$CONFIG_PATH'
        done
        # Pre-flight: a binary whose loader cannot resolve it dies
        # instantly and reads as a mysterious start failure. Deploying
        # --static binaries without --static-stdcxx cost a full battery
        # exactly this way (rsr and rsd-555 need libstdc++, which the
        # image does not ship), so name the missing library up front
        # instead of leaving it in a daemon log.
        missing=''
        for d in$ordered; do
            if ldd '$DAEMON_BIN'/\$d 2>&1 | grep -q 'not found'; then
                missing=\"\$missing \$d(\$(ldd '$DAEMON_BIN'/\$d 2>&1 | \
                    sed -n 's/^[[:space:]]*\\([^ ]*\\) => not found/\\1/p' | tr '\\n' ',' ))\"
            fi
        done
        if [ -n \"\$missing\" ]; then
            echo \"UNRESOLVED LIBRARIES:\$missing\"
            echo \"  (a --static deploy still needs --static-stdcxx for the C++ daemons)\"
            exit 1
        fi

        # Pre-fault every binary before the liveness clock starts: a
        # cold binary demand-paged over NFS can stall in execve long
        # enough to blow any reasonable budget, and until execve
        # completes the process still carries the shell's name, so
        # pidof cannot see it. The stall also bills whichever daemon
        # started last, not whichever binary was cold.
        for d in$ordered; do cat '$DAEMON_BIN'/\$d >/dev/null 2>&1; done
        cat '$DAEMON_BIN'/ringdump >/dev/null 2>&1
        for d in$ordered; do
            [ -x '$DAEMON_BIN'/\$d ] || { echo \"MISSING \$d\"; exit 1; }
            nohup '$DAEMON_BIN'/\$d >/tmp/\$d.log 2>&1 </dev/null &
            launcher=\$!; found=0
            # Wait on the launcher, not on a stopwatch. Until execve
            # completes the process still carries the shell's name, so
            # pidof cannot see a start that is genuinely in progress --
            # and on a 64MB device the pages of a big static binary get
            # evicted while RVD builds its pipeline, so that exec can
            # take tens of seconds off NFS no matter how warm the cache
            # was. While the launcher pid is alive the start has not
            # failed; the cap is only a backstop against a true hang.
            tries=240; case \$d in rvd|rfs) tries=360 ;; esac
            for i in \$(seq \$tries); do
                pidof \$d >/dev/null && break
                kill -0 \$launcher 2>/dev/null || break
                sleep 0.25
            done
            # A daemon whose feature is off in raptor.conf logs and
            # exits by design; that is a legitimate shape, not a
            # failure. The line lands in syslog rather than the capture
            # file when the daemon has already forked, so check both.
            # Anything else that is not running is a real failure.
            # One pidof scan is not proof of death: it has been seen to
            # miss a daemon that is demonstrably running and streaming
            # while the device is busy. Re-verify, and consult /proc
            # directly, before condemning it.
            # Retry existence (not readiness) for up to 20s: pidof and
            # a single /proc sweep have both missed live daemons under
            # load, and a slow HAL init behind rvd's ISP re-init keeps
            # the process valid the whole time. A crashed daemon stays
            # absent, so the longer window cannot mask a real failure.
            tries=0
            while [ \$tries -lt 10 ]; do
                pidof \$d >/dev/null && { found=1; break; }
                for pd in /proc/[0-9]*; do
                    [ \"\$(cat \$pd/comm 2>/dev/null)\" = \"\$d\" ] && { found=1; break; }
                done
                [ \"\${found:-0}\" = 1 ] && break
                tries=\$((tries+1))
                sleep 2
            done
            if ! pidof \$d >/dev/null && [ \"\${found:-0}\" != 1 ]; then
                if grep -q 'disabled in config' /tmp/\$d.log 2>/dev/null ||
                   logread 2>/dev/null | tail -80 | grep -q \"\$d.*disabled in config\"; then
                    echo \"  (\$d disabled in config)\"
                elif grep -q 'already running' /tmp/\$d.log 2>/dev/null; then
                    # A survivor of the previous pass still holds the
                    # pidfile, so the new instance refused to daemonize.
                    echo \"FAILED \$d: an older instance survived teardown\"
                    tail -3 /tmp/\$d.log; exit 1
                else
                    echo \"FAILED \$d\"; tail -3 /tmp/\$d.log; exit 1
                fi
            fi
            case \$d in rvd|rfs)
                # Readiness is FRAMES, not a file: the ring appears as
                # soon as the producer maps it, but a consumer that
                # connects before the first frame advertises a media-less
                # SDP, and the suite fetches that SDP exactly once.
                for i in \$(seq 60); do
                    [ -e /dev/shm/rss_ring_main ] || { sleep 0.5; continue; }
                    # ringdump reports on stderr, so 2>/dev/null threw
                    # away the very line being parsed: this gate has
                    # been waiting out its full timeout on every
                    # bring-up and proceeding on the ring file alone,
                    # which is exactly what it was written not to do.
                    seq=\$('$DAEMON_BIN'/ringdump main 2>&1 |
                        sed -n 's/.*Write seq: *\\([0-9]*\\).*/\\1/p')
                    [ -n \"\$seq\" ] && [ \"\$seq\" -gt 0 ] && break
                    sleep 0.5
                done
                if [ ! -e /dev/shm/rss_ring_main ]; then echo 'FAILED ring'; exit 1; fi ;;
            esac
        done
        # A consumer's pid exists before it binds: rings open first.
        # The suite's very first DESCRIBE would race that, and since it
        # fetches the SDP exactly once, a lost race poisons every check
        # that reads it.
        if [ '$wait_port' != '-' ] && [ -n '$wait_port' ]; then
            for i in \$(seq 60); do
                netstat -ln 2>/dev/null | grep -q ':$wait_port ' && break
                sleep 0.5
            done
            netstat -ln 2>/dev/null | grep -q ':$wait_port ' ||
                { echo 'FAILED: port $wait_port never listened'; exit 1; }
        fi
        sleep 2
        echo READY"; then
        echo "  BRING-UP FAILED (see above)" >&2
        printf '%s\t%s\tBRING-UP FAILED\n' "$CURRENT_TARGET" "${BRINGUP_LABEL:-?}" >>"$MATRIX_FILE"
        OVERALL_FAIL=1
        return 1
    fi
    # Per-profile memory accounting: headroom differs by an order of
    # magnitude across the fleet (a 64MB SoC carves most of RAM away
    # for rmem/ispmem), so the shape each measurement ran under is
    # worth recording next to the numbers.
    ssh -o ConnectTimeout=10 "$SSH" "
        free | awk '/Mem:/{printf \"  mem: %dMB used, %dMB free\", \$3/1024, \$4/1024}'
        for p in \$(pidof $CANON_ORDER 2>/dev/null); do
            n=\$(cat /proc/\$p/comm 2>/dev/null)
            r=\$(awk '/VmRSS/{print \$2}' /proc/\$p/status 2>/dev/null)
            printf ' | %s %dk' \"\$n\" \"\${r:-0}\"
        done
        echo" 2>/dev/null || true
    return 0
}

# One line of the final matrix per (target,backend): "target backend result"
MATRIX_FILE=$(mktemp)
trap 'rm -f "$MATRIX_FILE"' EXIT
OVERALL_FAIL=0

# run_suite <label> <url> [extra args...] — invoke raptor-test, echo a
# live-tailed run, and append a parsed result row to the matrix.
run_suite() {
    local label=$1 url=$2
    shift 2
    echo
    echo "################################################################"
    echo "# $label"
    echo "#   $url ${*}"
    echo "################################################################"
    local out
    out=$("$SUITE" "$url" "$@" 2>&1)
    echo "$out"
    local res
    res=$(echo "$out" | grep -oE '[0-9]+ passed, [0-9]+ failed, [0-9]+ skipped' | tail -1)
    if [ -z "$res" ]; then
        printf '%s\t%s\tERROR (no result line)\n' "$CURRENT_TARGET" "$label" >>"$MATRIX_FILE"
        OVERALL_FAIL=1
        return
    fi
    local failed
    failed=$(echo "$res" | grep -oE '[0-9]+ failed' | grep -oE '[0-9]+')
    printf '%s\t%s\t%s\n' "$CURRENT_TARGET" "$label" "$res" >>"$MATRIX_FILE"
    [ "${failed:-1}" -ne 0 ] && OVERALL_FAIL=1
    return 0
}

battery_for_target() {
    local name=$1
    local conf="$TDIR/$name.conf"
    if [ ! -f "$conf" ]; then
        echo "no such target: $name (see --list)" >&2
        OVERALL_FAIL=1
        return
    fi
    # Reset every field so a sparse conf can't inherit the previous
    # target's values (matters for --all).
    SOC=''; HOST=''; HOST6=''; SSH=''; SRT=''; SRT_PASS=''; RHD=''; USER=''; PASS=''
    SIGN_PASS=''
    RTSP_PORT=554; PATH0=stream0; PATH1=stream1
    R555_PORT=''; R555_PATH0=stream0; R555_PATH1=stream1
    GO2RTC=''; FRIGATE=no; RECORD_CHECK=''; NOTES=''; GOP=''
    TLS=''; RTMP=''; WEBRTC=''
    # Daemon profiles (opt-in; empty DAEMONS_BASE = manage nothing)
    DAEMON_BIN=''; DAEMONS_BASE=''; DAEMONS_RECORD=''
    DAEMONS_RTSP='rsd'; DAEMONS_R555='rsd-555'; DAEMONS_SRT='rsr'
    DAEMONS_RHD='rhd'; DAEMONS_WEBRTC='rwd'; DAEMONS_RTMP='rsp'
    DAEMONS_UVC='rwc'; RAM_MB=''; CONFIG_PATH=/etc/raptor.conf; CONF_SET=''
    # A syntax error (e.g. unquoted parens in NOTES) makes bash abort
    # sourcing mid-file, silently dropping every field after the bad
    # line. That must be a hard error, never a partial run.
    # shellcheck disable=SC1090
    if ! . "$conf"; then
        echo "CONF PARSE ERROR: $conf -- quote values containing spaces or ()" >&2
        printf '%s\t%s\tCONF PARSE ERROR\n' "$name" "-" >>"$MATRIX_FILE"
        OVERALL_FAIL=1
        return
    fi
    CURRENT_TARGET=$name

    echo "================================================================"
    echo "TARGET $name  (SoC $SOC, host $HOST)"
    [ -n "$NOTES" ] && echo "  $NOTES"
    echo "================================================================"

    # Shared optional legs, assembled once.
    local -a common=()
    [ -n "$SSH" ]          && common+=(--ssh "$SSH")
    [ -n "$USER" ]         && common+=(--user "$USER" --pass "$PASS")
    [ -n "$GO2RTC" ]       && common+=(--go2rtc "$GO2RTC")
    [ "$FRIGATE" = yes ]   && common+=(--frigate)
    [ -n "$RECORD_CHECK" ] && common+=(--record-check "$RECORD_CHECK")
    [ -n "$GOP" ] && common+=(--gop "$GOP")
    [ -n "$RHD" ]          && common+=(--rhd "$RHD")

    # Base shape: what a deployed camera of this kind always runs.
    # OSD and day/night are load, not decoration (ROD re-renders every
    # second; RIC polls exposure and can switch ISP modes mid-run), so
    # measurements taken without them would flatter the encoder.
    local -a base_set=()
    [ -n "$DAEMONS_BASE" ] && read -r -a base_set <<<"$DAEMONS_BASE"
    if [ -n "$RECORD_CHECK" ] && [ -n "$DAEMONS_RECORD" ]; then
        local -a rec_set=()
        read -r -a rec_set <<<"$DAEMONS_RECORD"
        base_set+=("${rec_set[@]}")
    fi

    # Backend 1: rsd (compy) — also carries the backend-independent
    # legs (SRT, TLS, RTMP) since it is always present.
    local -a rsd_args=("${common[@]}")
    [ -n "$SRT" ]  && rsd_args+=(--srt "$SRT")
    [ -n "$SRT_PASS" ] && rsd_args+=(--srt-passphrase "$SRT_PASS")
    [ -n "$RHD" ]  && rsd_args+=(--cold)
    # Both legs deliberately disturb the stream, so they run last
    # inside this pass, and every later pass brings its daemons up
    # from scratch anyway. They need ssh to reach the device.
    [ -n "$SSH" ]  && rsd_args+=(--clock-step --producer-restart)
    [ -n "$TLS" ]  && rsd_args+=(--tls "$TLS")
    [ -n "$RTMP" ] && rsd_args+=(--rtmp "$RTMP")
    [ -n "$WEBRTC" ] && rsd_args+=(--webrtc "$WEBRTC")
    # This pass's daemons: base + rsd + whichever extra backends its
    # legs exercise. Multi-protocol coexistence is a real deployment;
    # two RTSP backends at once is not, so rsd-555 is excluded here and
    # gets its own pass.
    BRINGUP_LABEL="rsd (compy RTSP)"
    local -a p1=("${base_set[@]}" $DAEMONS_RTSP)
    [ -n "$SRT" ]    && p1+=($DAEMONS_SRT)
    [ -n "$RHD" ]    && p1+=($DAEMONS_RHD)
    [ -n "$WEBRTC" ] && p1+=($DAEMONS_WEBRTC)
    [ -n "$RTMP" ]   && p1+=($DAEMONS_RTMP)
    bringup "$RTSP_PORT" "${p1[@]}" || return
    run_suite "rsd (compy RTSP)" \
        "rtsp://$HOST:$RTSP_PORT/$PATH0" \
        --sub "rtsp://$HOST:$RTSP_PORT/$PATH1" "${rsd_args[@]}"

    # Backend 2: rsd-555 (live555), if exposed. Reuse the common legs
    # minus SRT/RHD (those are backend-independent, covered above).
    if [ -n "$R555_PORT" ]; then
        local -a r555_args=()
        [ -n "$SSH" ]        && r555_args+=(--ssh "$SSH")
        [ -n "$USER" ]       && r555_args+=(--user "$USER" --pass "$PASS")
        [ -n "$GO2RTC" ]     && r555_args+=(--go2rtc "$GO2RTC")
        [ "$FRIGATE" = yes ] && r555_args+=(--frigate)
        BRINGUP_LABEL="rsd-555 (live555 RTSP)"
        bringup "$R555_PORT" "${base_set[@]}" $DAEMONS_R555 || return
        run_suite "rsd-555 (live555 RTSP)" \
            "rtsp://$HOST:$R555_PORT/$R555_PATH0" \
            --sub "rtsp://$HOST:$R555_PORT/$R555_PATH1" "${r555_args[@]}"
    else
        printf '%s\t%s\tn/a\n' "$name" "rsd-555 (live555 RTSP)" >>"$MATRIX_FILE"
    fi

    # Backend 3: H.265. Every other pass runs H.264, so RFC 7798
    # packetization, its parameter-set attributes and the HEVC decode
    # path are otherwise never exercised. Gated on the SoC: T30, T31,
    # T32, T33, T40 and T41 encode H.265; the older parts do not, and
    # asking them to would fail for the wrong reason. The sub stream is
    # flipped rather than the main one, so a target keeps a working
    # H.264 endpoint throughout.
    case " t30 t31 t32 t33 t40 t41 " in
    *" $SOC "*) H265_OK=1 ;;
    *) H265_OK='' ;;
    esac
    if [ -n "$H265_OK" ] && [ -n "$DAEMONS_BASE" ]; then
        local -a h265_args=(--core)
        [ -n "$SSH" ]  && h265_args+=(--ssh "$SSH")
        [ -n "$USER" ] && h265_args+=(--user "$USER" --pass "$PASS")
        BRINGUP_LABEL="h265 (sub stream)"
        local saved_conf=$CONF_SET
        CONF_SET="$CONF_SET stream1.codec=h265"
        if bringup "$RTSP_PORT" "${base_set[@]}" $DAEMONS_RTSP; then
            run_suite "h265 (sub stream)" "rtsp://$HOST:$RTSP_PORT/$PATH1" "${h265_args[@]}"
        fi
        CONF_SET=$saved_conf
    else
        printf '%s\t%s\t%s\n' "$name" "h265 (sub stream)" \
            "$([ -n "$H265_OK" ] && echo 'n/a' || echo "n/a (SOC $SOC has no H.265 encoder)")" \
            >>"$MATRIX_FILE"
    fi

    # Backend 4: signing. Every pass above runs with sei_timecode and
    # sign_snapshots off, which is how they ship, so the SEI check
    # skips and no signed artifact is ever produced -- the provenance
    # path is the one feature the battery cannot see. Signing rewrites
    # what a decoder receives (per-frame SEI in the elementary stream,
    # an APP segment in the JPEG), so "still decodes" is the assertion
    # that matters. Core subset plus RHD: this is about the artifacts,
    # not another full protocol sweep.
    if [ -n "$SIGN_PASS" ] && [ -n "$DAEMONS_BASE" ]; then
        local -a sign_args=(--core)
        [ -n "$SSH" ]  && sign_args+=(--ssh "$SSH")
        [ -n "$USER" ] && sign_args+=(--user "$USER" --pass "$PASS")
        [ -n "$RHD" ]  && sign_args+=(--rhd "$RHD")
        BRINGUP_LABEL="signing (SEI + signed snapshots)"
        local saved_conf=$CONF_SET
        CONF_SET="$CONF_SET rtsp.sei_timecode=true http.sign_snapshots=true"
        local -a ps=("${base_set[@]}" $DAEMONS_RTSP)
        [ -n "$RHD" ] && ps+=($DAEMONS_RHD)
        if bringup "$RTSP_PORT" "${ps[@]}"; then
            run_suite "signing (SEI + signed snapshots)" \
                "rtsp://$HOST:$RTSP_PORT/$PATH0" \
                --sub "rtsp://$HOST:$RTSP_PORT/$PATH1" "${sign_args[@]}"
        fi
        CONF_SET=$saved_conf
    else
        printf '%s\t%s\tn/a\n' "$name" "signing (SEI + signed snapshots)" >>"$MATRIX_FILE"
    fi

    # Backend 5: IPv6. The lab is dual-stacked and the policy is
    # v6-first, so the core suite must also pass against an IPv6
    # literal, not just the v4 address every other pass dials. Same
    # daemons as the rsd pass; what changes is the wire.
    if [ -n "$HOST6" ]; then
        local -a v6_args=(--core)
        [ -n "$USER" ] && v6_args+=(--user "$USER" --pass "$PASS")
        BRINGUP_LABEL="ipv6 (core suite over v6 literal)"
        if bringup "$RTSP_PORT" "${base_set[@]}" $DAEMONS_RTSP; then
            run_suite "ipv6 (core suite over v6 literal)" \
                "rtsp://[$HOST6]:$RTSP_PORT/$PATH0" "${v6_args[@]}"
        fi
    else
        printf '%s\t%s\tn/a (no HOST6 in target conf)\n' "$name" \
            "ipv6 (core suite over v6 literal)" >>"$MATRIX_FILE"
    fi

    # Backend 6: SR wall-clock mapping. rlatency maps RTP timestamps to
    # NTP via the Sender Reports and compares against this host's clock.
    # With a synced camera the p50 sits within a few ms (network flight
    # plus residual clock offset), so the budget is 25ms. This is the
    # leg for anchor-class bugs: a sub-second truncation in compy's
    # mono-to-NTP offset read a steady -519ms here while every in-band
    # check stayed green, because both tracks shared the bias. A p50
    # beyond a second is the camera's clock, not raptor, and reports
    # n/a. Auth is cleared for the pass (rlatency speaks plain RTSP);
    # the device conf is restored from backup afterwards, and runs last
    # so the running daemons carry the cleared conf only until the next
    # bring-up.
    local rlat="$DIR/tools/rlatency"
    local rlat_src="$DIR/../raptor/rlatency/rlatency.c"
    if [ -f "$rlat_src" ] && { [ ! -x "$rlat" ] || [ "$rlat_src" -nt "$rlat" ]; }; then
        cc -O2 -o "$rlat" "$rlat_src" -lm 2>/dev/null || true
    fi
    if [ -x "$rlat" ] && [ -n "$DAEMONS_BASE" ] && [ -n "$SSH" ]; then
        BRINGUP_LABEL="sr-wallclock (rlatency)"
        local saved_conf=$CONF_SET
        CONF_SET="$CONF_SET rtsp.username= rtsp.password="
        ssh -o ConnectTimeout=10 "$SSH" "cp '$CONFIG_PATH' '$CONFIG_PATH.srwall-bak'"
        if bringup "$RTSP_PORT" "${base_set[@]}" $DAEMONS_RTSP; then
            echo
            echo "################################################################"
            echo "# sr-wallclock (rlatency)"
            echo "#   rtsp://$HOST:$RTSP_PORT/$PATH0 -n 200"
            echo "################################################################"
            local rlat_out p50 verdict
            rlat_out=$(timeout 60 "$rlat" "rtsp://$HOST:$RTSP_PORT/$PATH0" -n 200 -q 2>&1)
            echo "$rlat_out" | tail -9
            p50=$(echo "$rlat_out" | sed -n 's/.*P50: *\(-*[0-9.]*\) ms.*/\1/p')
            if [ -z "$p50" ]; then
                verdict="FAIL (no samples: $(echo "$rlat_out" | tail -1))"
                OVERALL_FAIL=1
            else
                verdict=$(awk -v p="$p50" 'BEGIN {
                    a = p < 0 ? -p : p
                    if (a <= 25) print "PASS (p50=" p "ms)"
                    else if (a > 1000)
                        print "n/a (host-camera clocks unsynced: p50=" p "ms)"
                    else print "FAIL (SR anchor off by " p "ms)"
                }')
                case "$verdict" in FAIL*) OVERALL_FAIL=1 ;; esac
            fi
            printf '%s\t%s\t%s\n' "$name" "sr-wallclock (rlatency)" "$verdict" \
                >>"$MATRIX_FILE"
        fi
        ssh -o ConnectTimeout=10 "$SSH" "mv '$CONFIG_PATH.srwall-bak' '$CONFIG_PATH'" || true
        CONF_SET=$saved_conf
    else
        printf '%s\t%s\tn/a (rlatency tool or ssh unavailable)\n' "$name" \
            "sr-wallclock (rlatency)" >>"$MATRIX_FILE"
    fi
}

if [ "$1" = "--all" ]; then
    for t in $(list_targets); do battery_for_target "$t"; done
else
    battery_for_target "$1"
fi

echo
echo "================================================================"
echo "BATTERY MATRIX"
echo "================================================================"
printf '%-16s %-24s %s\n' TARGET BACKEND RESULT
while IFS=$'\t' read -r t b r; do
    printf '%-16s %-24s %s\n' "$t" "$b" "$r"
done <"$MATRIX_FILE"
echo
[ "$OVERALL_FAIL" -eq 0 ] && echo "ALL BACKENDS CLEAN" || echo "SOME BACKENDS HAD FAILURES (review above)"
exit "$OVERALL_FAIL"
