#!/bin/bash

# Run from a private copy: editing this file while a battery is live
# corrupts the running interpreter's parse (bash reads incrementally).
if [ -z "${RUN_BATTERY_SELF:-}" ]; then
    RUN_BATTERY_HOME="$(cd "$(dirname "$0")" && pwd)"
    export RUN_BATTERY_HOME
    RUN_BATTERY_SELF=$(mktemp "${TMPDIR:-/tmp}/run-battery.XXXXXX")
    export RUN_BATTERY_SELF
    cp "$0" "$RUN_BATTERY_SELF"
    cd "$RUN_BATTERY_HOME"
    exec /bin/bash "$RUN_BATTERY_SELF" "$@"
fi

# run-battery -- run the full raptor-test battery consistently across
# every backend a target exposes, from a targets/<name>.conf manifest.
#
# The point: the SAME comprehensive suite runs on every target and
# every backend (rsd, rsd-555, SRT). Legs a target does not expose are
# recorded as n/a, never silently dropped, so coverage cannot drift
# between devices.
#
#   ./run-battery <target>        one target, all its backends
#   ./run-battery <target> --backend <substr>   only matching pass(es)
#   ./run-battery --all           every targets/*.conf, then a matrix
#   ./run-battery --list          list defined targets
#
# Bring-up: opt-in per target. A manifest that declares DAEMONS_BASE
# (plus DAEMON_BIN and SSH) hands the runner its daemon lifecycle, and
# each pass then runs the production-shaped set for that backend —
# service daemons included, the RTSP twins never together. Manifests
# without DAEMONS_BASE are untouched: the runner tests whatever is
# already running and manages nothing. Building and deploying binaries
# is always the caller's job. See targets/README.md.
set -u

DIR="${RUN_BATTERY_HOME:-$(cd "$(dirname "$0")" && pwd)}"
TDIR="$DIR/targets"
SUITE="$DIR/raptor-test"

# Extra raptor-test flags appended to every pass, from the environment
# or a target conf (conf wins for its target). The knob exists for
# runs that need longer sample windows, e.g.:
#   SUITE_EXTRA="--dur 60 --srt-secs 60 --drift-secs 60" ./run-battery t31-z55
SUITE_EXTRA_ENV=${SUITE_EXTRA:-}

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

list_targets() {
    for f in "$TDIR"/*.conf; do
        [ "$(basename "$f")" = "_template.conf" ] && continue
        [ -e "$f" ] && basename "$f" .conf
    done
}

[ $# -ge 1 ] || usage 1
case "$1" in
    -h|--help) usage 0 ;;
    --list) list_targets; exit 0 ;;
esac

# Every battery keeps its own complete transcript: one careless pipe on
# the invoking side must never be able to lose the per-leg results
# again (a tail -30 once ate five failure identities).
mkdir -p "$DIR/battery-logs"
BATTERY_LOG="$DIR/battery-logs/$(echo "$1" | tr -d '-' | tr '/' '_')-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$BATTERY_LOG") 2>&1
echo "# full transcript: $BATTERY_LOG"
# Suite provenance stamps the transcript before anything runs; the
# per-pass daemon provenance (build hash + binary checksum) follows
# each bring-up.
SUITE_REV=$(git -C "$DIR" describe --always --dirty 2>/dev/null || echo unknown)
echo "# suite: $SUITE_REV  invoked: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --backend <substr>: run only the pass(es) whose matrix label matches.
# Everything else is recorded as skipped, so the matrix stays complete.
ONLY_BACKEND=""
if [ "${2:-}" = "--backend" ] && [ -n "${3:-}" ]; then
    ONLY_BACKEND=${3:-}
fi

want_backend() {
    [ -z "$ONLY_BACKEND" ] && return 0
    case "$1" in *"$ONLY_BACKEND"*) return 0 ;; *) return 1 ;; esac
}

# Canonical start order: the ring producer first (it creates the rings
# every consumer opens), then audio, then the service daemons, then the
# stream backends. Also the kill list.
CANON_ORDER="rvd rfs rad rod ric rmd rmr rsd rsd-555 rsr rhd rwd rsp rwc"

# Each daemon gates on its own config section, so a profile is config
# plus processes: starting rwd while [webrtc] is disabled just makes it
# log and exit, and the leg that needed it fails for a reason that has
# nothing to do with the code under test. Bring-up enables exactly the
# sections its set needs (never disables anything else). RVD and RFS
# have no gate.
section_for() {
    case $1 in
    rad) echo audio ;;      rod) echo osd ;;         ric) echo ircut ;;
    rmd) echo motion ;;     rmr) echo recording ;;   rsd|rsd-555) echo rtsp ;;
    rsr) echo srt ;;        rhd) echo http ;;        rwd) echo webrtc ;;
    rsp) echo push ;;       rwc) echo webcam ;;      *) echo "" ;;
    esac
}

# bringup <listen-port|-> <daemon...> — replace whatever is running on
# the target with exactly this set. No-op unless the manifest opted in.
bringup() {
    local wait_port=$1
    shift
    # Rings whose first frame gates readiness. A pass that tests a
    # stream other than main (the h265 pass runs against ch1) must
    # name that ring too, or its early legs race a silent encoder.
    local rings=${BRINGUP_RINGS:-main}
    if ! want_backend "${BRINGUP_LABEL:-}"; then
        printf '%s\t%s\tskipped (--backend %s)\n' "$CURRENT_TARGET" \
            "${BRINGUP_LABEL:-?}" "$ONLY_BACKEND" >>"$MATRIX_FILE"
        return 3
    fi
    [ -n "$DAEMONS_BASE" ] || return 0
    if [ -z "$SSH" ] || [ -z "$DAEMON_BIN" ]; then
        echo "  BRING-UP SKIPPED: DAEMONS_BASE set but SSH=/DAEMON_BIN= missing" >&2
        return 1
    fi
    local want=$* ordered="" d w
    for d in $CANON_ORDER; do
        for w in $want; do
            [ "$d" = "$w" ] && ordered="$ordered $d"
        done
    done
    local sections="" s
    for d in $ordered; do
        s=$(section_for "$d")
        [ -n "$s" ] && case " $sections " in *" $s "*) ;; *) sections="$sections $s" ;; esac
    done
    echo "--- bring-up:$ordered ---"
    # The config baseline is the REPO's stock template, pushed fresh
    # every bring-up: never anything found on the device, which may
    # predate the binaries under test. A target conf states every
    # deviation from stock via CONF_SET, so a battery's config inputs
    # are exactly two reviewable things: the template and the manifest.
    if [ ! -f "$STOCK_CONF" ]; then
        echo "  BRING-UP FAILED: STOCK_CONF not found: $STOCK_CONF" >&2
        printf '%s\t%s\tBRING-UP FAILED (no stock conf)\n' "$CURRENT_TARGET" \
            "${BRINGUP_LABEL:-?}" >>"$MATRIX_FILE"
        OVERALL_FAIL=1
        return 1
    fi
    if ! ssh -o ConnectTimeout=10 "$SSH" "cat > /tmp/raptor-test.stock" <"$STOCK_CONF"; then
        echo "  BRING-UP FAILED: could not push stock conf" >&2
        printf '%s\t%s\tBRING-UP FAILED (conf push)\n' "$CURRENT_TARGET" \
            "${BRINGUP_LABEL:-?}" >>"$MATRIX_FILE"
        OVERALL_FAIL=1
        return 1
    fi
    # Readiness is polled, never slept: the ring must exist before
    # consumers start (a consumer racing rvd gets a video-less SDP) and
    # an NFS-hosted binary path may mount seconds after boot.
    # The script travels over STDIN, not as the ssh command argument:
    # dropbear caps the command string near 8KB (v2026.92 rejects the
    # session outright) and this script is comfortably past it.
    if ! printf '%s' "
        set -u
        case '$DAEMON_BIN' in /mnt/nfs*)
            for i in \$(seq 30); do mount | grep -q /mnt/nfs && break; sleep 1; done ;;
        esac
        # Graceful first, and WAIT: RVD tears down the ISP/encoder in
        # its SIGTERM path, and SIGKILLing it mid-teardown leaves the
        # driver dirty enough that the next RVD hangs in IMP init.
        # Poll for exit instead of guessing a sleep; anything still
        # alive after 20s gets -9 and is named (a daemon that will not
        # exit on TERM is itself a bug worth seeing).
        killall $CANON_ORDER 2>/dev/null
        for i in \$(seq 40); do
            pidof $CANON_ORDER >/dev/null 2>&1 || break
            sleep 0.5
        done
        if pidof $CANON_ORDER >/dev/null 2>&1; then
            for p in \$(pidof $CANON_ORDER); do
                echo \"  WARNING: \$(cat /proc/\$p/comm 2>/dev/null) ignored SIGTERM, killing\"
            done
            killall -9 $CANON_ORDER 2>/dev/null
            sleep 2
        fi
        rm -f /dev/shm/rss_ring_* 2>/dev/null
        # The device's real config is never read or edited: the runner
        # pushed the repo's stock template just above, every bring-up
        # starts from a fresh copy of it, and daemons launch with -c.
        # Nothing on the device can skew a battery and nothing a
        # battery does can persist.
        cp /tmp/raptor-test.stock /tmp/raptor-test.conf
        for s in$sections; do
            grep -q \"^\\[\$s\\]\" /tmp/raptor-test.conf || printf '\\n[%s]\\n' \"\$s\" >>/tmp/raptor-test.conf
            sed -i \"/^\\[\$s\\]/,/^\\[/{/^enabled *=/d}\" /tmp/raptor-test.conf
            sed -i \"/^\\[\$s\\]/a enabled = true\" /tmp/raptor-test.conf
        done
        # Manifest config overrides (CONF_SET: section.key=value,
        # space-separated, values without spaces) — some legs need the
        # device pointed at the runner, e.g. push.url for the RTMP leg.
        for kv in $CONF_SET; do
            sec=\${kv%%.*}; rest=\${kv#*.}
            key=\${rest%%=*}; val=\${rest#*=}
            grep -q \"^\\[\$sec\\]\" /tmp/raptor-test.conf || printf '\\n[%s]\\n' \"\$sec\" >>/tmp/raptor-test.conf
            sed -i \"/^\\[\$sec\\]/,/^\\[/{/^\$key *=/d}\" /tmp/raptor-test.conf
            sed -i \"/^\\[\$sec\\]/a \$key = \$val\" /tmp/raptor-test.conf
        done
        # Pre-flight: a binary whose loader cannot resolve it dies
        # instantly and reads as a mysterious start failure. Deploying
        # --static binaries without --static-stdcxx cost a full battery
        # exactly this way (rsr and rsd-555 need libstdc++, which the
        # image does not ship), so name the missing library up front
        # instead of leaving it in a daemon log.
        missing=''
        for d in$ordered; do
            if ldd '$DAEMON_BIN'/\$d 2>&1 | grep -q 'not found'; then
                missing=\"\$missing \$d(\$(ldd '$DAEMON_BIN'/\$d 2>&1 | \
                    sed -n 's/^[[:space:]]*\\([^ ]*\\) => not found/\\1/p' | tr '\\n' ',' ))\"
            fi
        done
        if [ -n \"\$missing\" ]; then
            echo \"UNRESOLVED LIBRARIES:\$missing\"
            echo \"  (a --static deploy still needs --static-stdcxx for the C++ daemons)\"
            exit 1
        fi

        # Pre-fault every binary before the liveness clock starts: a
        # cold binary demand-paged over NFS can stall in execve long
        # enough to blow any reasonable budget, and until execve
        # completes the process still carries the shell's name, so
        # pidof cannot see it. The stall also bills whichever daemon
        # started last, not whichever binary was cold.
        for d in$ordered; do cat '$DAEMON_BIN'/\$d >/dev/null 2>&1; done
        cat '$DAEMON_BIN'/ringdump >/dev/null 2>&1
        for d in$ordered; do
            [ -x '$DAEMON_BIN'/\$d ] || { echo \"MISSING \$d\"; exit 1; }
            nohup '$DAEMON_BIN'/\$d -c /tmp/raptor-test.conf >/tmp/\$d.log 2>&1 </dev/null &
            launcher=\$!; found=0
            # Wait on the launcher, not on a stopwatch. Until execve
            # completes the process still carries the shell's name, so
            # pidof cannot see a start that is genuinely in progress --
            # and on a 64MB device the pages of a big static binary get
            # evicted while RVD builds its pipeline, so that exec can
            # take tens of seconds off NFS no matter how warm the cache
            # was. While the launcher pid is alive the start has not
            # failed; the cap is only a backstop against a true hang.
            tries=240; case \$d in rvd|rfs) tries=360 ;; esac
            for i in \$(seq \$tries); do
                pidof \$d >/dev/null && break
                kill -0 \$launcher 2>/dev/null || break
                sleep 0.25
            done
            # A daemon whose feature is off in raptor.conf logs and
            # exits by design; that is a legitimate shape, not a
            # failure. The line lands in syslog rather than the capture
            # file when the daemon has already forked, so check both.
            # Anything else that is not running is a real failure.
            # One pidof scan is not proof of death: it has been seen to
            # miss a daemon that is demonstrably running and streaming
            # while the device is busy. Re-verify, and consult /proc
            # directly, before condemning it.
            # Retry existence (not readiness) for up to 20s: pidof and
            # a single /proc sweep have both missed live daemons under
            # load, and a slow HAL init behind rvd's ISP re-init keeps
            # the process valid the whole time. A crashed daemon stays
            # absent, so the longer window cannot mask a real failure.
            tries=0
            while [ \$tries -lt 10 ]; do
                pidof \$d >/dev/null && { found=1; break; }
                for pd in /proc/[0-9]*; do
                    [ \"\$(cat \$pd/comm 2>/dev/null)\" = \"\$d\" ] && { found=1; break; }
                done
                [ \"\${found:-0}\" = 1 ] && break
                tries=\$((tries+1))
                sleep 2
            done
            if ! pidof \$d >/dev/null && [ \"\${found:-0}\" != 1 ]; then
                if grep -q 'disabled in config' /tmp/\$d.log 2>/dev/null ||
                   logread 2>/dev/null | tail -80 | grep -q \"\$d.*disabled in config\"; then
                    echo \"  (\$d disabled in config)\"
                elif grep -q 'already running' /tmp/\$d.log 2>/dev/null; then
                    # A survivor of the previous pass still holds the
                    # pidfile, so the new instance refused to daemonize.
                    echo \"FAILED \$d: an older instance survived teardown\"
                    tail -3 /tmp/\$d.log; exit 1
                else
                    echo \"FAILED \$d\"; tail -3 /tmp/\$d.log; exit 1
                fi
            fi
            case \$d in rvd|rfs)
                # Readiness is FRAMES, not a file: the ring appears as
                # soon as the producer maps it, but a consumer that
                # connects before the first frame advertises a media-less
                # SDP, and the suite fetches that SDP exactly once.
                for ring in $rings; do
                for i in \$(seq 60); do
                    [ -e /dev/shm/rss_ring_\$ring ] || { sleep 0.5; continue; }
                    # ringdump reports on stderr, so 2>/dev/null threw
                    # away the very line being parsed: this gate has
                    # been waiting out its full timeout on every
                    # bring-up and proceeding on the ring file alone,
                    # which is exactly what it was written not to do.
                    seq=\$('$DAEMON_BIN'/ringdump \$ring 2>&1 |
                        sed -n 's/.*Write seq: *\\([0-9]*\\).*/\\1/p')
                    [ -n \"\$seq\" ] && [ \"\$seq\" -gt 0 ] && break
                    sleep 0.5
                done
                if [ ! -e /dev/shm/rss_ring_\$ring ]; then echo \"FAILED ring \$ring\"; exit 1; fi
                done ;;
            esac
        done
        # A consumer's pid exists before it binds: rings open first.
        # The suite's very first DESCRIBE would race that, and since it
        # fetches the SDP exactly once, a lost race poisons every check
        # that reads it.
        if [ '$wait_port' != '-' ] && [ -n '$wait_port' ]; then
            for i in \$(seq 60); do
                netstat -ln 2>/dev/null | grep -q ':$wait_port ' && break
                sleep 0.5
            done
            netstat -ln 2>/dev/null | grep -q ':$wait_port ' ||
                { echo 'FAILED: port $wait_port never listened'; exit 1; }
        fi
        sleep 2
        echo READY" | ssh -o ConnectTimeout=10 "$SSH" sh; then
        echo "  BRING-UP FAILED (see above)" >&2
        printf '%s\t%s\tBRING-UP FAILED\n' "$CURRENT_TARGET" "${BRINGUP_LABEL:-?}" >>"$MATRIX_FILE"
        OVERALL_FAIL=1
        return 1
    fi
    # Provenance: a result without it is an anecdote with a
    # timestamp. Record what actually ran -- the daemon's own
    # compiled-in build hash (read from the banner the process it
    # PRINTED, not from any file we assume matches) plus a checksum
    # of the binary on disk -- next to every pass. The old-ROM trap
    # is systemic without this: nothing else in the battery proves
    # the code under test is the code you built.
    PROV=$(ssh -o ConnectTimeout=10 "$SSH" "
        h=\$(sed -n 's/.*\[\([0-9a-f]\{6,\}\)\].*/\1/p' /tmp/rvd.log 2>/dev/null | head -1)
        s=\$( (sha256sum '$DAEMON_BIN'/rvd 2>/dev/null || md5sum '$DAEMON_BIN'/rvd 2>/dev/null) | cut -d' ' -f1 | cut -c1-16)
        echo \"build=\${h:-unknown} rvd_bin=\${s:-unknown}\"" 2>/dev/null)
    echo "  provenance: ${PROV:-unavailable} bin_path=$DAEMON_BIN suite=$SUITE_REV"
    printf '# provenance\t%s\t%s bin_path=%s suite=%s\n' "$CURRENT_TARGET" \
        "${PROV:-unavailable}" "$DAEMON_BIN" "$SUITE_REV" >>"$MATRIX_FILE"
    # Per-profile memory accounting: headroom differs by an order of
    # magnitude across the fleet (a 64MB SoC carves most of RAM away
    # for rmem/ispmem), so the shape each measurement ran under is
    # worth recording next to the numbers.
    ssh -o ConnectTimeout=10 "$SSH" "
        free | awk '/Mem:/{printf \"  mem: %dMB used, %dMB free\", \$3/1024, \$4/1024}'
        for p in \$(pidof $CANON_ORDER 2>/dev/null); do
            n=\$(cat /proc/\$p/comm 2>/dev/null)
            r=\$(awk '/VmRSS/{print \$2}' /proc/\$p/status 2>/dev/null)
            printf ' | %s %dk' \"\$n\" \"\${r:-0}\"
        done
        echo" 2>/dev/null || true
    return 0
}

# One line of the final matrix per (target,backend): "target backend result"
MATRIX_FILE=$(mktemp)
WORKROOT=$(mktemp -d)
trap 'rm -rf "$WORKROOT"' EXIT
trap 'rm -f "$MATRIX_FILE"' EXIT
OVERALL_FAIL=0

# run_suite <label> <url> [extra args...] — invoke raptor-test, echo a
# live-tailed run, and append a parsed result row to the matrix.
run_suite() {
    local label=$1 url=$2
    shift 2
    echo
    echo "################################################################"
    echo "# $label"
    echo "#   $url ${*} ${SUITE_EXTRA:-}"
    echo "################################################################"
    local out
    # shellcheck disable=SC2086  # SUITE_EXTRA is a flag list, split intended
    out=$("$SUITE" "$url" "$@" ${SUITE_EXTRA:-} 2>&1)
    echo "$out"
    local res
    res=$(echo "$out" | grep -oE '[0-9]+ passed, [0-9]+ failed, [0-9]+ skipped' | tail -1)
    if [ -z "$res" ]; then
        printf '%s\t%s\tERROR (no result line)\n' "$CURRENT_TARGET" "$label" >>"$MATRIX_FILE"
        OVERALL_FAIL=1
        return
    fi
    local failed
    failed=$(echo "$res" | grep -oE '[0-9]+ failed' | grep -oE '[0-9]+')
    printf '%s\t%s\t%s\n' "$CURRENT_TARGET" "$label" "$res" >>"$MATRIX_FILE"
    [ "${failed:-1}" -ne 0 ] && OVERALL_FAIL=1
    return 0
}

battery_for_target() {
    local name=$1
    local conf="$TDIR/$name.conf"
    if [ ! -f "$conf" ]; then
        echo "no such target: $name (see --list)" >&2
        OVERALL_FAIL=1
        return
    fi
    # Reset every field so a sparse conf can't inherit the previous
    # target's values (matters for --all).
    SOC=''; HOST=''; HOST6=''; SSH=''; SRT=''; SRT_PASS=''; RHD=''; USER=''; PASS=''; WEBRTC_MAIN=''
    SIGN_PASS=''
    RTSP_PORT=554; PATH0=stream0; PATH1=stream1
    R555_PORT=''; R555_PATH0=stream0; R555_PATH1=stream1
    GO2RTC=''; MEDIAMTX=''; FRIGATE=no; RECORD_CHECK=''; NOTES=''; GOP=''
    # Lights/bench commands must not leak between targets under --all
    LIGHTS_ON_CMD=''; LIGHTS_OFF_CMD=''; LIGHTS_SET_CMD=''; LIGHTS_RAMP_SECS=''; LIGHT_CAL_FILE=''
    LIGHTS_CAST_CMD=''; COLORCAST_FILE=''; CAST_KEY_LEVEL=''
    BENCH_QUIESCE_CMD=''; BENCH_RESTORE_CMD=''
    TLS=''; RTMP=''; WEBRTC=''
    # Daemon profiles (opt-in; empty DAEMONS_BASE = manage nothing)
    DAEMON_BIN=''; DAEMONS_BASE=''; DAEMONS_RECORD=''
    DAEMONS_RTSP='rsd'; DAEMONS_R555='rsd-555'; DAEMONS_SRT='rsr'
    DAEMONS_RHD='rhd'; DAEMONS_WEBRTC='rwd'; DAEMONS_RTMP='rsp'
    DAEMONS_UVC='rwc'; RAM_MB=''; CONFIG_PATH=/etc/raptor.conf; CONF_SET=''
    STOCK_CONF="$DIR/../raptor/config/raptor.conf"
    SUITE_EXTRA=$SUITE_EXTRA_ENV
    # A syntax error (e.g. unquoted parens in NOTES) makes bash abort
    # sourcing mid-file, silently dropping every field after the bad
    # line. That must be a hard error, never a partial run.
    # shellcheck disable=SC1090
    if ! . "$conf"; then
        echo "CONF PARSE ERROR: $conf -- quote values containing spaces or ()" >&2
        printf '%s\t%s\tCONF PARSE ERROR\n' "$name" "-" >>"$MATRIX_FILE"
        OVERALL_FAIL=1
        return
    fi
    # Ad-hoc env flags append AFTER the conf's own SUITE_EXTRA, so
    # SUITE_EXTRA="--only join" ./run-battery <t> --backend rsd works
    # on targets whose conf already declares flags (e.g. fps-tol).
    if [ -n "$SUITE_EXTRA_ENV" ] && [ "$SUITE_EXTRA" != "$SUITE_EXTRA_ENV" ]; then
        SUITE_EXTRA="$SUITE_EXTRA $SUITE_EXTRA_ENV"
    fi
    CURRENT_TARGET=$name

    echo "================================================================"
    echo "TARGET $name  (SoC $SOC, host $HOST)"
    [ -n "$NOTES" ] && echo "  $NOTES"
    echo "  config inputs: manifest=$(sha256sum "$conf" 2>/dev/null | cut -c1-12)" \
        "stock=$([ -f "$STOCK_CONF" ] && sha256sum "$STOCK_CONF" | cut -c1-12 || echo missing)"
    echo "================================================================"

    # Shared optional legs, assembled once.
    local -a common=()
    [ -n "$SSH" ]          && common+=(--ssh "$SSH")
    [ -n "$USER" ]         && common+=(--user "$USER" --pass "$PASS")
    [ -n "$GO2RTC" ]       && common+=(--go2rtc "$GO2RTC")
    [ -n "$MEDIAMTX" ]     && common+=(--mediamtx "$MEDIAMTX")
    [ "$FRIGATE" = yes ]   && common+=(--frigate)
    [ -n "$RECORD_CHECK" ] && common+=(--record-check "$RECORD_CHECK")
    [ -n "$GOP" ] && common+=(--gop "$GOP")
    [ -n "$RHD" ]          && common+=(--rhd "$RHD")

    # Base shape: what a deployed camera of this kind always runs.
    # OSD and day/night are load, not decoration (ROD re-renders every
    # second; RIC polls exposure and can switch ISP modes mid-run), so
    # measurements taken without them would flatter the encoder.
    local -a base_set=()
    [ -n "$DAEMONS_BASE" ] && read -r -a base_set <<<"$DAEMONS_BASE"
    if [ -n "$RECORD_CHECK" ] && [ -n "$DAEMONS_RECORD" ]; then
        local -a rec_set=()
        read -r -a rec_set <<<"$DAEMONS_RECORD"
        base_set+=("${rec_set[@]}")
    fi

    # Backend 1: rsd (compy) — also carries the backend-independent
    # legs (SRT, TLS, RTMP) since it is always present.
    local -a rsd_args=("${common[@]}")
    [ -n "$SRT" ]  && rsd_args+=(--srt "$SRT")
    [ -n "$SRT_PASS" ] && rsd_args+=(--srt-passphrase "$SRT_PASS")
    [ -n "$RHD" ]  && rsd_args+=(--cold)
    # Both legs deliberately disturb the stream, so they run last
    # inside this pass, and every later pass brings its daemons up
    # from scratch anyway. They need ssh to reach the device.
    [ -n "$SSH" ]  && rsd_args+=(--clock-step --producer-restart)
    # Malformed-input robustness against the real device parser. The
    # flag existed and the battery never passed it, so every run has
    # been reporting a clean matrix with the fuzzer sitting out.
    rsd_args+=(--fuzz)
    # Day/night hardware cycle: bench targets that can switch the room
    # lights declare the commands in their conf; one cycle per battery,
    # attached to the main pass. Needs ssh to reach raptorctl.
    if [ -n "${LIGHTS_ON_CMD:-}" ] && [ -n "${LIGHTS_OFF_CMD:-}" ] && [ -n "$SSH" ]; then
        rsd_args+=(--daynight --lights-on "$LIGHTS_ON_CMD" --lights-off "$LIGHTS_OFF_CMD")
        [ -n "${LIGHTS_SET_CMD:-}" ] && rsd_args+=(--lights-set "$LIGHTS_SET_CMD")
        [ -n "${LIGHTS_RAMP_SECS:-}" ] && rsd_args+=(--lights-ramp "$LIGHTS_RAMP_SECS")
        [ -n "${LIGHT_CAL_FILE:-}" ] && rsd_args+=(--light-cal-file "$LIGHT_CAL_FILE")
        [ -n "${BENCH_QUIESCE_CMD:-}" ] && rsd_args+=(--bench-quiesce "$BENCH_QUIESCE_CMD")
        [ -n "${BENCH_RESTORE_CMD:-}" ] && rsd_args+=(--bench-restore "$BENCH_RESTORE_CMD")
    fi
    # Colored-ambient cast checks ride any pass with ssh + a wash.
    if [ -n "${LIGHTS_CAST_CMD:-}" ] && [ -n "$SSH" ]; then
        rsd_args+=(--lights-cast "$LIGHTS_CAST_CMD")
        [ -n "${COLORCAST_FILE:-}" ] && rsd_args+=(--colorcast-file "$COLORCAST_FILE")
        [ -n "${CAST_KEY_LEVEL:-}" ] && rsd_args+=(--cast-key "$CAST_KEY_LEVEL")
    fi
    [ -n "$TLS" ]  && rsd_args+=(--tls "$TLS")
    [ -n "$RTMP" ] && rsd_args+=(--rtmp "$RTMP")
    [ -n "$WEBRTC" ] && rsd_args+=(--webrtc "$WEBRTC")
    [ -n "${WEBRTC_MAIN:-}" ] && rsd_args+=(--webrtc-main "$WEBRTC_MAIN")
    # This pass's daemons: base + rsd + whichever extra backends its
    # legs exercise. Multi-protocol coexistence is a real deployment;
    # two RTSP backends at once is not, so rsd-555 is excluded here and
    # gets its own pass.
    BRINGUP_LABEL="rsd (compy RTSP)"
    local -a p1=("${base_set[@]}" $DAEMONS_RTSP)
    [ -n "$SRT" ]    && p1+=($DAEMONS_SRT)
    [ -n "$RHD" ]    && p1+=($DAEMONS_RHD)
    [ -n "$WEBRTC" ] && p1+=($DAEMONS_WEBRTC)
    [ -n "$RTMP" ]   && p1+=($DAEMONS_RTMP)
    local brc=0
    bringup "$RTSP_PORT" "${p1[@]}" || brc=$?
    if [ "$brc" -eq 0 ]; then
        run_suite "rsd (compy RTSP)" \
            "rtsp://$HOST:$RTSP_PORT/$PATH0" \
            --sub "rtsp://$HOST:$RTSP_PORT/$PATH1" "${rsd_args[@]}"
    elif [ "$brc" -ne 3 ]; then
        return
    fi

    # Backend 2: rsd-555 (live555), if exposed. Reuse the common legs
    # minus SRT/RHD (those are backend-independent, covered above).
    if [ -n "$R555_PORT" ]; then
        local -a r555_args=()
        [ -n "$SSH" ]        && r555_args+=(--ssh "$SSH")
        [ -n "$USER" ]       && r555_args+=(--user "$USER" --pass "$PASS")
        [ -n "$GO2RTC" ]     && r555_args+=(--go2rtc "$GO2RTC")
        [ -n "$MEDIAMTX" ]   && r555_args+=(--mediamtx "$MEDIAMTX")
        [ "$FRIGATE" = yes ] && r555_args+=(--frigate)
        BRINGUP_LABEL="rsd-555 (live555 RTSP)"
        brc=0
        bringup "$R555_PORT" "${base_set[@]}" $DAEMONS_R555 || brc=$?
        if [ "$brc" -eq 0 ]; then
            run_suite "rsd-555 (live555 RTSP)" \
                "rtsp://$HOST:$R555_PORT/$R555_PATH0" \
                --sub "rtsp://$HOST:$R555_PORT/$R555_PATH1" "${r555_args[@]}"
        elif [ "$brc" -ne 3 ]; then
            return
        fi
    else
        printf '%s\t%s\tn/a\n' "$name" "rsd-555 (live555 RTSP)" >>"$MATRIX_FILE"
    fi

    # Backend 3: H.265. Every other pass runs H.264, so RFC 7798
    # packetization, its parameter-set attributes and the HEVC decode
    # path are otherwise never exercised. Gated on the SoC: T30, T31,
    # T32, T33, T40 and T41 encode H.265; the older parts do not, and
    # asking them to would fail for the wrong reason. The sub stream is
    # flipped rather than the main one, so a target keeps a working
    # H.264 endpoint throughout.
    case " t30 t31 t32 t33 t40 t41 " in
    *" $SOC "*) H265_OK=1 ;;
    *) H265_OK='' ;;
    esac
    if [ -n "$H265_OK" ] && [ -n "$DAEMONS_BASE" ]; then
        local -a h265_args=(--core)
        [ -n "$SSH" ]  && h265_args+=(--ssh "$SSH")
        [ -n "$USER" ] && h265_args+=(--user "$USER" --pass "$PASS")
        # Restream interop for HEVC: strict consumers (gortsplib) are
        # exactly where sprop/marker/AU bugs surface.
        [ -n "$GO2RTC" ]   && h265_args+=(--go2rtc "$GO2RTC")
        [ -n "$MEDIAMTX" ] && h265_args+=(--mediamtx "$MEDIAMTX")
        [ -n "$SRT" ]      && h265_args+=(--srt "$SRT")
        [ -n "$SRT_PASS" ] && h265_args+=(--srt-passphrase "$SRT_PASS")
        BRINGUP_LABEL="h265 (sub stream)"
        local saved_conf=$CONF_SET
        CONF_SET="$CONF_SET stream1.codec=h265"
        local -a p265=("${base_set[@]}" $DAEMONS_RTSP)
        [ -n "$SRT" ] && p265+=($DAEMONS_SRT)
        if BRINGUP_RINGS="main sub" bringup "$RTSP_PORT" "${p265[@]}"; then
            run_suite "h265 (sub stream)" "rtsp://$HOST:$RTSP_PORT/$PATH1" "${h265_args[@]}"
        fi
        CONF_SET=$saved_conf

        # H.265 on the MAIN stream. The sub-flip pass keeps main at
        # H.264 by design, which also means HEVC never rides the
        # full-size frames where the refmode copy budget and every
        # size-dependent bug actually live (the rwd main-stream storm
        # shipped precisely because nothing pulled main at real frame
        # sizes). Same suite against PATH0 with stream0 flipped and the
        # sub left at H.264, so a working H.264 endpoint survives this
        # pass too. rsd-555 rides along: its only other coverage is
        # H.264 main.
        BRINGUP_LABEL="h265 (main stream)"
        saved_conf=$CONF_SET
        CONF_SET="$CONF_SET stream0.codec=h265"
        if BRINGUP_RINGS="main sub" bringup "$RTSP_PORT" "${p265[@]}"; then
            run_suite "h265 (main stream)" "rtsp://$HOST:$RTSP_PORT/$PATH0" "${h265_args[@]}"
        fi
        if [ -n "$R555_PORT" ]; then
            local -a h265_555=(--core)
            [ -n "$SSH" ]  && h265_555+=(--ssh "$SSH")
            [ -n "$USER" ] && h265_555+=(--user "$USER" --pass "$PASS")
            BRINGUP_LABEL="h265 main (rsd-555)"
            if BRINGUP_RINGS="main sub" bringup "$R555_PORT" "${base_set[@]}" $DAEMONS_R555; then
                run_suite "h265 main (rsd-555)" \
                    "rtsp://$HOST:$R555_PORT/$R555_PATH0" "${h265_555[@]}"
            fi
        fi
        CONF_SET=$saved_conf
    else
        printf '%s\t%s\t%s\n' "$name" "h265 (sub stream)" \
            "$([ -n "$H265_OK" ] && echo 'n/a' || echo "n/a (SOC $SOC has no H.265 encoder)")" \
            >>"$MATRIX_FILE"
    fi

    # Backend 4: signing. Every pass above runs with sei_timecode and
    # sign_snapshots off, which is how they ship, so the SEI check
    # skips and no signed artifact is ever produced -- the provenance
    # path is the one feature the battery cannot see. Signing rewrites
    # what a decoder receives (per-frame SEI in the elementary stream,
    # an APP segment in the JPEG), so "still decodes" is the assertion
    # that matters. Core subset plus RHD: this is about the artifacts,
    # not another full protocol sweep.
    if [ -n "$SIGN_PASS" ] && [ -n "$DAEMONS_BASE" ]; then
        local -a sign_args=(--core)
        [ -n "$SSH" ]  && sign_args+=(--ssh "$SSH")
        [ -n "$USER" ] && sign_args+=(--user "$USER" --pass "$PASS")
        [ -n "$RHD" ]  && sign_args+=(--rhd "$RHD")
        BRINGUP_LABEL="signing (SEI + signed snapshots)"
        local saved_conf=$CONF_SET
        CONF_SET="$CONF_SET rtsp.sei_timecode=true http.sign_snapshots=true"
        local -a ps=("${base_set[@]}" $DAEMONS_RTSP)
        [ -n "$RHD" ] && ps+=($DAEMONS_RHD)
        if bringup "$RTSP_PORT" "${ps[@]}"; then
            run_suite "signing (SEI + signed snapshots)" \
                "rtsp://$HOST:$RTSP_PORT/$PATH0" \
                --sub "rtsp://$HOST:$RTSP_PORT/$PATH1" "${sign_args[@]}"
        fi
        CONF_SET=$saved_conf
    else
        printf '%s\t%s\tn/a\n' "$name" "signing (SEI + signed snapshots)" >>"$MATRIX_FILE"
    fi

    # Authed RTSP URL for the direct-probe passes below (raptor-test
    # takes credentials as flags; ffprobe wants them in the URL).
    local auth_main="rtsp://$HOST:$RTSP_PORT/$PATH0"
    [ -n "$USER" ] && auth_main="rtsp://$USER:$PASS@$HOST:$RTSP_PORT/$PATH0"

    # Backend 4b: audio codec matrix. Every other pass runs whichever
    # codec the device ships with, so the other four encoders are only
    # ever exercised by whoever remembers to reconfigure a camera by
    # hand. Ported from raptor/tests/stream-health.sh, which swept them
    # on-device but was orchestrated by nothing.
    if ! want_backend "audio codecs (5-codec sweep)"; then
        printf '%s\t%s\tskipped (--backend %s)\n' "$name" \
            "audio codecs (5-codec sweep)" "$ONLY_BACKEND" >>"$MATRIX_FILE"
    elif [ -n "$DAEMONS_BASE" ] && [ -n "$SSH" ]; then
        BRINGUP_LABEL="audio codecs (5-codec sweep)"
        local saved_conf=$CONF_SET
        local cpass=0 cfail=0
        # codec:rate:expected_ffprobe_codec:expected_ffprobe_rate
        local codec_matrix="pcmu:8000:pcm_mulaw:8000
pcma:8000:pcm_alaw:8000
l16:16000:pcm_s16be:16000
aac:16000:aac:16000
opus:16000:opus:48000"
        echo
        echo "################################################################"
        echo "# audio codecs (5-codec sweep)"
        echo "################################################################"
        # Each bring-up builds a fresh /tmp config from the repo's
        # stock template, so per-codec CONF_SET entries cannot outlive
        # their pass and nothing on the device is read or touched.
        local spec cid crate ecodec erate probe acodec arate
        for spec in $codec_matrix; do
            IFS=: read -r cid crate ecodec erate <<<"$spec"
            CONF_SET="$saved_conf audio.codec=$cid audio.sample_rate=$crate"
            if ! bringup "$RTSP_PORT" "${base_set[@]}" $DAEMONS_RTSP; then
                echo "  FAIL  $cid: bring-up"
                cfail=$((cfail + 1))
                continue
            fi
            probe=$(timeout -k 5 25 "$DIR/tools/ffprobe" -v error -rtsp_transport tcp \
                -select_streams a -show_entries stream=codec_name,sample_rate \
                -of csv=p=0 "$auth_main" 2>/dev/null | head -1)
            acodec=${probe%%,*}
            arate=${probe##*,}
            if [ "$acodec" = "$ecodec" ] && [ "$arate" = "$erate" ]; then
                echo "  PASS  $cid: decodes as $acodec @ ${arate}Hz"
                cpass=$((cpass + 1))
            else
                echo "  FAIL  $cid: got '${probe:-nothing}', expected $ecodec,$erate"
                cfail=$((cfail + 1))
            fi
        done
        CONF_SET=$saved_conf
        printf '%s\t%s\t%d passed, %d failed, 0 skipped\n' "$name" \
            "audio codecs (5-codec sweep)" "$cpass" "$cfail" >>"$MATRIX_FILE"
        [ "$cfail" -ne 0 ] && OVERALL_FAIL=1
    else
        printf '%s\t%s\tn/a\n' "$name" "audio codecs (5-codec sweep)" >>"$MATRIX_FILE"
    fi

    # Backend 4c: encoder RC modes. Which modes exist is a platform
    # capability, so the list comes from the encoder itself rather than
    # a hardcoded table. Ported from raptor/tests/device-test.sh.
    if ! want_backend "rc modes (encoder sweep)"; then
        printf '%s\t%s\tskipped (--backend %s)\n' "$name" \
            "rc modes (encoder sweep)" "$ONLY_BACKEND" >>"$MATRIX_FILE"
    elif [ -n "$DAEMONS_BASE" ] && [ -n "$SSH" ]; then
        BRINGUP_LABEL="rc modes (encoder sweep)"
        local saved_conf=$CONF_SET
        local rpass=0 rfail=0 caps rc_modes mode readback
        caps=$(ssh -n -o ConnectTimeout=8 "$SSH" "timeout 4 raptorctl rvd get-enc-caps" 2>/dev/null)
        rc_modes="cbr vbr fixqp"
        echo "$caps" | grep -q '"capped_rc":true' && rc_modes="$rc_modes capped_vbr capped_quality"
        echo "$caps" | grep -q '"smart_rc":true' && rc_modes="$rc_modes smart"
        echo
        echo "################################################################"
        echo "# rc modes (encoder sweep): $rc_modes"
        echo "################################################################"
        # Fresh /tmp config per bring-up: a capped_quality left behind
        # once changed the stream every later pass measured (it cost a
        # battery's openRTSP leg two decode errors); now it cannot.
        for mode in $rc_modes; do
            CONF_SET="$saved_conf stream0.rc_mode=$mode"
            if ! bringup "$RTSP_PORT" "${base_set[@]}" $DAEMONS_RTSP; then
                echo "  FAIL  $mode: bring-up"
                rfail=$((rfail + 1))
                continue
            fi
            readback=$(ssh -n -o ConnectTimeout=8 "$SSH" \
                "timeout 4 raptorctl rvd get-rc-mode 0" 2>/dev/null |
                grep -o '"rc_mode":"[a-z_]*"' | cut -d'"' -f4)
            probe=$(timeout -k 5 25 "$DIR/tools/ffprobe" -v error -rtsp_transport tcp \
                -select_streams v -show_entries stream=codec_name -of csv=p=0 \
                "$auth_main" 2>/dev/null | head -1)
            if [ "$readback" = "$mode" ] && [ -n "$probe" ]; then
                echo "  PASS  $mode: readback matches and encoder streams ($probe)"
                rpass=$((rpass + 1))
            elif [ -n "$readback" ] && [ "$readback" != "$mode" ]; then
                echo "  FAIL  $mode: readback says '$readback' -- SDK rejected or fell back"
                rfail=$((rfail + 1))
            else
                echo "  FAIL  $mode: stream='${probe:-nothing}' readback='${readback:-none}'"
                rfail=$((rfail + 1))
            fi
        done
        CONF_SET=$saved_conf
        printf '%s\t%s\t%d passed, %d failed, 0 skipped\n' "$name" \
            "rc modes (encoder sweep)" "$rpass" "$rfail" >>"$MATRIX_FILE"
        [ "$rfail" -ne 0 ] && OVERALL_FAIL=1
    else
        printf '%s\t%s\tn/a\n' "$name" "rc modes (encoder sweep)" >>"$MATRIX_FILE"
    fi

    # Backend 4d: recording. Continuous segments at 15s granularity:
    # every chained rotation must open on a wall-clock boundary (the
    # :00 the OSD shows) and every segment must decode. Ported from
    # raptor/tests/test-rmr-record.sh, which did this on-device from
    # the wrong repo and was orchestrated by nothing.
    if ! want_backend "recording (segments + alignment)"; then
        printf '%s\t%s\tskipped (--backend %s)\n' "$name" \
            "recording (segments + alignment)" "$ONLY_BACKEND" >>"$MATRIX_FILE"
    elif [ -n "$DAEMONS_BASE" ] && [ -n "$DAEMONS_RECORD" ] && [ -n "$SSH" ]; then
        BRINGUP_LABEL="recording (segments + alignment)"
        local saved_conf=$CONF_SET
        local recpass=0 recfail=0 recdir
        # Bench units often have no SD; NFS is a distinct filesystem so
        # rmr's rootfs auto-create refusal does not apply.
        if ssh -n -o ConnectTimeout=8 "$SSH" 'grep -q mmcblk /proc/mounts' 2>/dev/null; then
            recdir=/mnt/mmcblk0p1/raptor-battery
        else
            recdir=/mnt/nfs/tmp/raptor-battery-rec
            mkdir -p "$HOME/tmp/raptor-battery-rec" && chmod 1777 "$HOME/tmp/raptor-battery-rec"
        fi
        echo
        echo "################################################################"
        echo "# recording (segments + alignment) -> $recdir"
        echo "################################################################"
        ssh -n -o ConnectTimeout=10 "$SSH" "rm -rf '$recdir'; mkdir -p '$recdir'" 2>/dev/null
        CONF_SET="$saved_conf recording.enabled=true recording.mode=continuous"
        CONF_SET="$CONF_SET recording.storage_path=$recdir recording.segment_seconds=15"
        if bringup - "${base_set[@]}" $DAEMONS_RECORD; then
            sleep 55
            ssh -n -o ConnectTimeout=8 "$SSH" 'killall rmr 2>/dev/null' 2>/dev/null || true
            sleep 2
            local names align
            names=$(ssh -n -o ConnectTimeout=8 "$SSH" \
                "find '$recdir' -name '*.mp4' -type f" 2>/dev/null | xargs -rn1 basename | sort)
            if align=$(printf '%s\n' "$names" | python3 -c "
import sys
names = [l.strip() for l in sys.stdin if l.strip()]
secs = []
for n in names:
    try:
        h, m, s = n[:-4].split('-')
        secs.append((int(h) * 3600 + int(m) * 60 + int(s), n))
    except ValueError:
        pass
secs.sort()
pairs, bad = 0, []
for (a, _), (b, nm) in zip(secs, secs[1:]):
    if 13 <= b - a <= 17:
        pairs += 1
        if 1 < b % 15 < 14:
            bad.append(nm)
print(f'{len(secs)} segments, {pairs} chained rotations, misaligned: {bad}')
sys.exit(1 if bad or pairs < 2 else 0)"); then
                echo "  PASS  chained rotations open on wall-clock boundaries ($align)"
                recpass=$((recpass + 1))
            elif [ "$(echo "$names" | wc -w)" -le 1 ]; then
                # One segment in the window means the interval was not
                # applied: an rmr predating segment_seconds ignores the
                # key and falls back to segment_minutes.
                echo "  FAIL  segment alignment: $align -- device rmr may predate segment_seconds"
                recfail=$((recfail + 1))
            else
                echo "  FAIL  segment alignment: $align"
                recfail=$((recfail + 1))
            fi
            # Every segment must decode: a boundary-aligned file that
            # is not playable is worse than a misaligned one.
            local dec_bad=0 seg
            for seg in $names; do
                ssh -n -o ConnectTimeout=8 "$SSH" "cat '$recdir/$seg'" 2>/dev/null \
                    > "$WORKROOT/seg.mp4" || continue
                "$DIR/tools/ffprobe" -v error -show_entries stream=codec_name \
                    -of csv=p=0 "$WORKROOT/seg.mp4" >/dev/null 2>&1 || dec_bad=$((dec_bad + 1))
            done
            if [ "$dec_bad" -eq 0 ]; then
                echo "  PASS  every segment decodes ($(echo "$names" | wc -w) files)"
                recpass=$((recpass + 1))
            else
                echo "  FAIL  segment decode: $dec_bad unreadable"
                recfail=$((recfail + 1))
            fi
            ssh -n -o ConnectTimeout=8 "$SSH" "rm -rf '$recdir'" 2>/dev/null || true
        else
            echo "  FAIL  recording bring-up"
            recfail=$((recfail + 1))
        fi
        CONF_SET=$saved_conf
        printf '%s\t%s\t%d passed, %d failed, 0 skipped\n' "$name" \
            "recording (segments + alignment)" "$recpass" "$recfail" >>"$MATRIX_FILE"
        [ "$recfail" -ne 0 ] && OVERALL_FAIL=1
    else
        printf '%s\t%s\tn/a\n' "$name" "recording (segments + alignment)" >>"$MATRIX_FILE"
    fi

    # Backend 5: IPv6. The lab is dual-stacked and the policy is
    # v6-first, so the core suite must also pass against an IPv6
    # literal, not just the v4 address every other pass dials. Same
    # daemons as the rsd pass; what changes is the wire.
    if [ -n "$HOST6" ]; then
        local -a v6_args=(--core)
        [ -n "$USER" ] && v6_args+=(--user "$USER" --pass "$PASS")
        BRINGUP_LABEL="ipv6 (core suite over v6 literal)"
        if bringup "$RTSP_PORT" "${base_set[@]}" $DAEMONS_RTSP; then
            run_suite "ipv6 (core suite over v6 literal)" \
                "rtsp://[$HOST6]:$RTSP_PORT/$PATH0" "${v6_args[@]}"
        fi
    else
        printf '%s\t%s\tn/a (no HOST6 in target conf)\n' "$name" \
            "ipv6 (core suite over v6 literal)" >>"$MATRIX_FILE"
    fi

    # Backend 6: SR wall-clock mapping. rlatency maps RTP timestamps to
    # NTP via the Sender Reports and compares against this host's clock.
    # With a synced camera the p50 sits within a few ms (network flight
    # plus residual clock offset), so the budget is 25ms. This is the
    # leg for anchor-class bugs: a sub-second truncation in compy's
    # mono-to-NTP offset read a steady -519ms here while every in-band
    # check stayed green, because both tracks shared the bias. A p50
    # beyond a second is the camera's clock, not raptor, and reports
    # n/a. Auth is cleared for the pass (rlatency speaks plain RTSP);
    # the device conf is restored from backup afterwards, and runs last
    # so the running daemons carry the cleared conf only until the next
    # bring-up.
    local rlat="$DIR/tools/rlatency"
    local rlat_src="$DIR/../raptor/rlatency/rlatency.c"
    if [ -f "$rlat_src" ] && { [ ! -x "$rlat" ] || [ "$rlat_src" -nt "$rlat" ]; }; then
        cc -O2 -o "$rlat" "$rlat_src" -lm 2>/dev/null || true
    fi
    if [ -x "$rlat" ] && [ -n "$DAEMONS_BASE" ] && [ -n "$SSH" ]; then
        BRINGUP_LABEL="sr-wallclock (rlatency)"
        local saved_conf=$CONF_SET
        CONF_SET="$CONF_SET rtsp.username= rtsp.password="
        if bringup "$RTSP_PORT" "${base_set[@]}" $DAEMONS_RTSP; then
            echo
            echo "################################################################"
            echo "# sr-wallclock (rlatency)"
            echo "#   rtsp://$HOST:$RTSP_PORT/$PATH0 -n 200"
            echo "################################################################"
            # The SR anchor maps stream time to the DEVICE's wall clock;
            # rlatency compares against THIS host's clock, so the raw p50
            # includes however far the camera's ntpd sits from the host
            # (tens of ms between polls is routine for busybox ntpd, and
            # it reads as a rock-steady bias -- a bench cam has swung
            # 400ms across a day). Measure the offset by streaming the
            # device's seconds and host-timestamping the tick boundaries,
            # once BEFORE and once AFTER the rlatency run: the mean
            # cancels linear drift across the leg, and a disagreement
            # beyond 50ms means ntpd stepped mid-leg, which no single
            # correction can repair -- that run is n/a, not a verdict.
            # The one-way ssh pipe delay (a few ms on the bench LAN) is
            # common to both samples; the 25ms bound absorbs it.
            # Clock reads must not fork: date-per-tick on a loaded
            # single-core camera puts fork latency (tens of ms)
            # between the tick and the line, and the device reads
            # tens of ms less ahead than it is. awk reads systime()
            # in-process and only forks for the sleep afterwards; the
            # host timestamps arrivals in-process the same way.
            # First-seen tick detection overshoots the true boundary by
            # a uniform 0..sampling-period, so the mean is late by half
            # a period -- estimate the period from the arrival stream
            # and add it back, or the device reads ~period/2 less ahead
            # than it is (25ms of phantom bias at the observed rates).
            measure_clock_offset_ms() {
                ssh -o ConnectTimeout=8 "$SSH" \
                    'busybox awk "BEGIN { for (i = 0; i < 120; i++) { print systime(); fflush(); system(\"usleep 25000\") } }"' 2>/dev/null |
                    python3 -c '
import sys, time
samples = []
for line in sys.stdin:
    h = time.time()
    try:
        samples.append((int(line), h))
    except ValueError:
        continue
deltas = sorted(b[1] - a[1] for a, b in zip(samples, samples[1:]))
period = deltas[len(deltas) // 2] if deltas else 0
first = {}
for d, h in samples:
    first.setdefault(d, h)
ds = sorted(first)[1:]  # first second is joined mid-tick, discard
offs = [-(first[d] - d) * 1000 for d in ds]
if offs:
    print(f"{sum(offs) / len(offs) + period * 1000 / 2:.1f}")
' 2>/dev/null
            }
            local rlat_out p50 verdict offset_ms off_before off_after stepped
            off_before=$(measure_clock_offset_ms)
            rlat_out=$(timeout 60 "$rlat" "rtsp://$HOST:$RTSP_PORT/$PATH0" -n 200 -q 2>&1)
            echo "$rlat_out" | tail -9
            p50=$(echo "$rlat_out" | sed -n 's/.*P50: *\(-*[0-9.]*\) ms.*/\1/p')
            off_after=$(measure_clock_offset_ms)
            offset_ms=""
            stepped=""
            if [ -n "$off_before" ] && [ -n "$off_after" ]; then
                if awk -v a="$off_before" -v b="$off_after" \
                    'BEGIN { d = a - b; if (d < 0) d = -d; exit !(d > 50) }'; then
                    stepped="clock stepped during leg (${off_before}ms -> ${off_after}ms)"
                else
                    offset_ms=$(awk -v a="$off_before" -v b="$off_after" \
                        'BEGIN { printf "%.1f", (a + b) / 2 }')
                fi
            else
                offset_ms=${off_before:-$off_after}
            fi
            if [ -z "$p50" ]; then
                verdict="FAIL (no samples: $(echo "$rlat_out" | tail -1))"
                OVERALL_FAIL=1
            elif [ -n "$stepped" ]; then
                verdict="n/a ($stepped)"
            elif [ -n "$offset_ms" ]; then
                echo "  device clock offset vs host: ${offset_ms}ms (positive = device ahead," \
                    "mean of ${off_before}/${off_after})"
                # Corrected p50 = SR anchor error + true pipeline
                # latency. Latency is always positive (tens of ms for
                # capture->encode->wire), so give it headroom on the
                # positive side. Meaningfully negative means the anchor
                # is off -- but the corrected value itself swings ~25ms
                # between same-day runs on a busybox-ntpd camera
                # (measured -3.6 to -28.9 across one afternoon), so the
                # negative bound sits at -50: wide enough to absorb
                # measurement variance, still a fraction of the
                # hundreds-of-ms anchor bugs this leg exists to catch.
                verdict=$(awk -v p="$p50" -v o="$offset_ms" 'BEGIN {
                    c = p + o
                    a = c < 0 ? -c : c
                    if (a > 1000)
                        printf "n/a (host-camera clocks unsynced: corrected %.1fms)", c
                    else if (c > -50 && c <= 75)
                        printf "PASS (raw p50=%sms, clock offset %sms, corrected %.1fms)", p, o, c
                    else
                        printf "FAIL (SR anchor off: corrected %.1fms, raw %sms, offset %sms)", c, p, o
                }')
                case "$verdict" in FAIL*) OVERALL_FAIL=1 ;; esac
            else
                # Offset unmeasurable (no usleep on target, ssh hiccup):
                # fall back to the raw bound and say so.
                verdict=$(awk -v p="$p50" 'BEGIN {
                    a = p < 0 ? -p : p
                    if (a <= 25) print "PASS (p50=" p "ms, offset unmeasured)"
                    else if (a > 1000)
                        print "n/a (host-camera clocks unsynced: p50=" p "ms)"
                    else print "FAIL (SR anchor off by " p "ms, offset unmeasured)"
                }')
                case "$verdict" in FAIL*) OVERALL_FAIL=1 ;; esac
            fi
            printf '%s\t%s\t%s\n' "$name" "sr-wallclock (rlatency)" "$verdict" \
                >>"$MATRIX_FILE"
        fi
        CONF_SET=$saved_conf
    else
        printf '%s\t%s\tn/a (rlatency tool or ssh unavailable)\n' "$name" \
            "sr-wallclock (rlatency)" >>"$MATRIX_FILE"
    fi
}

if [ "$1" = "--all" ]; then
    for t in $(list_targets); do battery_for_target "$t"; done
else
    battery_for_target "$1"
fi

echo
echo "================================================================"
echo "BATTERY MATRIX"
echo "================================================================"
printf '%-16s %-24s %s\n' TARGET BACKEND RESULT
while IFS=$'\t' read -r t b r; do
    printf '%-16s %-24s %s\n' "$t" "$b" "$r"
done <"$MATRIX_FILE"
echo
[ "$OVERALL_FAIL" -eq 0 ] && echo "ALL BACKENDS CLEAN" || echo "SOME BACKENDS HAD FAILURES (review above)"
exit "$OVERALL_FAIL"
