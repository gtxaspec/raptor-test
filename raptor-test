#!/bin/bash
# raptor-test -- standalone live-stream conformance suite for RTSP
# servers. Built for the Raptor Streaming System, works against any
# RTSP source (generic checks self-skip when a feature is absent).
#
# Exercises what unit tests cannot: real sessions over TCP AND UDP,
# multiple concurrent clients, join/leave churn, wire-level sequence
# continuity, A/V timestamp sanity, and signaling byte-accuracy.
# Every check exists because an ad-hoc test once missed the bug it
# now catches.
#
# Usage:
#   raptor-test <rtsp-url> [options]
#
# Options:
#   --sub <url>        second stream URL (concurrency mix; default: main url)
#   --ssh <user@host>  enable device-side health checks (raptor bench)
#   --duration <s>     base capture duration (default 12)
#   --go2rtc <apiurl>  test through a go2rtc restream (e.g. http://host:1984)
#   --frigate          record via a local dockerized Frigate (both transports)
#                      and verify the recorded clips
#   --record-check <d> verify the newest .mp4 in a directory (e.g. rmr output)
#   --keep-logs        keep the log directory even on success
#
# Requirements: ffmpeg+ffprobe (FFMPEG/FFPROBE env override), python3.
# mpv used if present. All log matching is case-insensitive; failing
# checks print the exact matched lines; logs persist on failure.
# Background clients are killed via their own process tree -- never
# kill only a timeout wrapper (orphaned ffmpeg streams forever).
set -u

URL=${1:?usage: raptor-test <rtsp-url> [--sub url] [--ssh user@host] [--user u --pass p] [--duration s] [--keep-logs]}
shift
SUB_URL=""
SSH_TARGET=""
DUR=12
KEEP=0
GO2RTC=""
FRIGATE=0
RECDIR=""
RTSP_USER=""
RTSP_PASS=""
while [ $# -gt 0 ]; do
    case "$1" in
    --sub) SUB_URL=$2; shift 2 ;;
    --ssh) SSH_TARGET=$2; shift 2 ;;
    --duration) DUR=$2; shift 2 ;;
    --go2rtc) GO2RTC=$2; shift 2 ;;
    --frigate) FRIGATE=1; shift ;;
    --record-check) RECDIR=$2; shift 2 ;;
    --keep-logs) KEEP=1; shift ;;
    --user) RTSP_USER=$2; shift 2 ;;
    --pass) RTSP_PASS=$2; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done
[ -n "$SUB_URL" ] || SUB_URL=$URL

HOSTPORT=${URL#rtsp://}
HOSTPORT=${HOSTPORT%%/*}
case "$HOSTPORT" in
*@*)
    USERINFO=${HOSTPORT%%@*}
    RTSP_USER=${RTSP_USER:-${USERINFO%%:*}}
    RTSP_PASS=${RTSP_PASS:-${USERINFO#*:}}
    HOSTPORT=${HOSTPORT##*@}
    ;;
esac
HOST=${HOSTPORT%%:*}
PORT=${HOSTPORT##*:}
[ "$PORT" = "$HOST" ] && PORT=554
RPATH=/${URL#rtsp://*/}

# With --user/--pass, client legs (ffmpeg/mpv/go2rtc/frigate) get the
# credentials in the URL; raw probes take them as arguments and speak
# digest themselves. HOST/PORT/RPATH always stay credential-free.
if [ -n "$RTSP_USER" ]; then
    case "$URL" in *@*) : ;; *) URL="rtsp://$RTSP_USER:$RTSP_PASS@${URL#rtsp://}" ;; esac
    case "$SUB_URL" in *@*) : ;; *) SUB_URL="rtsp://$RTSP_USER:$RTSP_PASS@${SUB_URL#rtsp://}" ;; esac
fi

DIR="$(cd "$(dirname "$0")" && pwd)"
PROBES="$DIR/probes"
# Client pinning: RTSP behavior shifts between ffmpeg majors (7.1
# streamcopy silently drops RTSP AAC audio; 8.x fixed it). Prefer the
# pinned build in tools/ (tools/fetch-tools.sh) over the system one;
# an explicit FFMPEG/FFPROBE env override still wins.
if [ -z "${FFMPEG:-}" ] && [ -x "$DIR/tools/ffmpeg" ]; then
    FFMPEG="$DIR/tools/ffmpeg"
    FFPROBE="$DIR/tools/ffprobe"
fi
FFMPEG=${FFMPEG:-ffmpeg}
FFPROBE=${FFPROBE:-ffprobe}
# Fail fast if a probe is missing or unimportable (a deleted helper
# module once surfaced as a mid-run traceback instead)
if ! python3 - "$PROBES" <<'EOF'
import pathlib, py_compile, sys
for p in sorted(pathlib.Path(sys.argv[1]).glob("*.py")):
    py_compile.compile(str(p), doraise=True)
sys.path.insert(0, sys.argv[1])
import rtsplib  # noqa: F401  (shared helper the probes import)
EOF
then
    echo "FATAL: probe scripts under $PROBES do not compile/import" >&2
    exit 2
fi

# Baseline established RTSP sessions before we generate any traffic
# (a deployed camera may have an NVR attached; that context changes
# how capacity rejections and the final connection count are judged).
EXTERNAL_SESSIONS=0
if [ -n "$SSH_TARGET" ]; then
    EXTERNAL_SESSIONS=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        "netstat -tn 2>/dev/null | grep ESTABLISHED | grep -c :$PORT" 2>/dev/null)
    EXTERNAL_SESSIONS=${EXTERNAL_SESSIONS:-0}
    [ "$EXTERNAL_SESSIONS" -gt 0 ] && \
        echo "    note: $EXTERNAL_SESSIONS pre-existing RTSP session(s) on the target"
fi
WORK="./raptor-test-logs/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$WORK"
PASS=0
FAIL=0
SKIP=0
declare -a FAILED_NAMES

# Error classes that mean broken media, matched case-insensitively.
# 'non monotonically increasing dts to muxer' is deliberately absent:
# -f null forces a 1/1000 timebase, so 30fps frames legally round to
# equal milliseconds and the muxer nags. True timestamp monotonicity
# is verified from a real capture in native timebases (section 4) and
# on the wire (RFC probe).
ERRPAT='missed|dropping|discontinuity|corrupt|concealing|invalid data|error while decoding'

ok() { echo "  PASS  $1"; PASS=$((PASS + 1)); }
skip() { echo "  SKIP  $1"; SKIP=$((SKIP + 1)); }
bad() {
    echo "  FAIL  $1${2:+ — $2}"
    FAIL=$((FAIL + 1))
    FAILED_NAMES+=("$1")
}

CLIENT_PIDS=""
FRIGATE_NAME=""
FRIGATE_DIR=""
cleanup() {
    for p in $CLIENT_PIDS; do
        # Kill the wrapper AND its children (pkill -P), then the wrapper.
        pkill -9 -P "$p" 2>/dev/null
        kill -9 "$p" 2>/dev/null
    done
    if [ -n "$FRIGATE_NAME" ]; then
        docker exec "$FRIGATE_NAME" sh -c 'rm -rf /media/frigate/recordings /media/frigate/clips' >/dev/null 2>&1
        docker rm -f "$FRIGATE_NAME" >/dev/null 2>&1
    fi
    [ -n "$FRIGATE_DIR" ] && rm -rf "$FRIGATE_DIR"
    [ "$KEEP" = 0 ] && [ "$FAIL" = 0 ] && rm -rf "$WORK"
}
trap cleanup EXIT

# show_errs <log> — print the matched error lines, indented.
show_errs() { grep -iE "$ERRPAT" "$1" | sort | uniq -c | sort -rn | head -3 | sed 's/^/          /'; }

# capture <name> <seconds> <url> [transport] — run a decoding client,
# fail if any error-class line appears.
capture() {
    local name=$1 secs=$2 url=$3 transport=${4:-}
    local targ=()
    [ -n "$transport" ] && targ=(-rtsp_transport "$transport")
    timeout -k 5 $((secs + 14)) "$FFMPEG" -nostdin -v warning "${targ[@]}" -i "$url" \
        -t "$secs" -f null - >"$WORK/$name.log" 2>&1
    [ "$(grep -ciE "$ERRPAT" "$WORK/$name.log")" -eq 0 ]
}

echo "=== raptor-test: $URL ==="
echo "    client: $("$FFMPEG" -version 2>/dev/null | head -1 | grep -oE 'version [^ ]+' || echo unknown) ($FFMPEG)"
echo "    logs: $WORK"

# ── 1. Signaling (DESCRIBE) ──
SDP=$(python3 - "$PROBES" "$HOST" "$PORT" "$RPATH" "${RTSP_USER:-}" "${RTSP_PASS:-}" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
user = sys.argv[5] or None
s = RtspSession(sys.argv[2], sys.argv[3], sys.argv[4], user=user, password=sys.argv[6])
status, sdp = s.describe()
s.close()
print(status)
print(sdp)
EOF
)
echo "$SDP" >"$WORK/sdp.txt"
if echo "$SDP" | grep -q 'm=video'; then ok "SDP: video track present"; else bad "SDP: video track present"; fi

# ── 1b. Auth battery (--user/--pass): the machinery must challenge,
# reject, accept, and enforce ──
if [ -n "$RTSP_USER" ]; then
    AUTHRPT=$(python3 - "$PROBES" "$HOST" "$PORT" "$RPATH" "$RTSP_USER" "$RTSP_PASS" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
host, port, path, user, pw = sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6]

def emit(ok, name, detail=""):
    print(("OK " if ok else "FAIL ") + name + (" -- " + detail if detail else ""))

s = RtspSession(host, port, path)  # no creds
st, _ = s.describe()
ch = s.last_challenge or {}
emit("401" in st and "realm" in ch and "nonce" in ch,
     "auth: unauthenticated DESCRIBE gets Digest challenge", st)
st2, _, _ = s.request("SETUP", s.url + "/video",
                      extra="Transport: RTP/AVP/TCP;unicast;interleaved=0-1\r\n")
emit("401" in st2, "auth: unauthenticated SETUP refused", st2)
s.close()

s = RtspSession(host, port, path, user=user, password="definitely-wrong")
st, _ = s.describe()
emit("401" in st, "auth: wrong password rejected", st)
s.close()

s = RtspSession(host, port, path, user=user, password=pw)
st, _ = s.describe()
emit("200" in st, "auth: correct digest accepted", st)
s.close()
EOF
)
    echo "$AUTHRPT" >"$WORK/auth.txt"
    while IFS= read -r line; do
        case $line in
            OK\ *)   ok "${line#OK }" ;;
            FAIL\ *) bad "${line#FAIL }" ;;
        esac
    done <<< "$AUTHRPT"
fi

CONFIG=$(echo "$SDP" | grep -o 'config=[0-9A-Fa-f]*' | head -1 | cut -d= -f2)
ACLK=$(echo "$SDP" | grep -oiE 'mpeg4-generic/[0-9]+' | head -1 | cut -d/ -f2)
if [ -n "$CONFIG" ] && [ -n "$ACLK" ]; then
    if python3 - "$CONFIG" "$ACLK" <<'EOF'
import sys
cfg, aclk = sys.argv[1], int(sys.argv[2])
rates = [96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350]
b = bytes.fromhex(cfg)
aot = b[0] >> 3
if len(b) == 2 and aot == 2:  # plain LC
    idx = ((b[0] & 0x7) << 1) | (b[1] >> 7)
    sys.exit(0 if rates[idx] == aclk else 1)
if len(b) == 5 and aot == 2:  # HE-AAC v1, backward-compatible explicit SBR
    core = ((b[0] & 0x7) << 1) | (b[1] >> 7)
    ext = (b[4] >> 3) & 0xF  # syncExtension extensionSamplingFrequencyIndex
    sys.exit(0 if (rates[core] == aclk // 2 and rates[ext] == aclk) else 1)
sys.exit(1)
EOF
    then ok "SDP: AAC config= consistent with clock ($CONFIG @ ${ACLK}Hz)"; else bad "SDP: AAC config= vs clock" "$CONFIG @ $ACLK"; fi
else
    skip "SDP AAC checks (no mpeg4-generic audio advertised)"
fi

# ── 2. Transport matrix ──
if capture tcp_main "$DUR" "$URL" tcp; then ok "TCP: clean media (${DUR}s)"; else bad "TCP: clean media" "see below"; show_errs "$WORK/tcp_main.log"; fi
if capture udp_main "$DUR" "$URL"; then ok "UDP: clean media (${DUR}s)"; else bad "UDP: clean media" "see below"; show_errs "$WORK/udp_main.log"; fi
if [ "$SUB_URL" != "$URL" ]; then
    if capture udp_sub "$DUR" "$SUB_URL"; then ok "UDP sub-stream: clean media"; else bad "UDP sub-stream" "see below"; show_errs "$WORK/udp_sub.log"; fi
fi

# ── 3. Wire-level RTP continuity (raw TCP-interleaved probe) ──
python3 "$PROBES/seq_gap.py" "$HOST" "$PORT" "$RPATH" 15 ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} >"$WORK/seqgap.txt" 2>&1
GAPRPT=$(head -1 "$WORK/seqgap.txt")
TSRPT=$(sed -n 2p "$WORK/seqgap.txt")
if echo "$GAPRPT" | grep -qE 'seq-lost=0.*seq-lost=0'; then
    ok "RTP sequence continuity, both tracks (15s)"
elif echo "$GAPRPT" | grep -qE 'seq-lost=0'; then
    ok "RTP sequence continuity, video (no audio track)"
else
    bad "RTP sequence continuity" "$GAPRPT"
fi
# Wire timestamps: never backward, no single-packet spikes; audio must
# hold one exact cadence (a bang-banging steering loop splits the modal
# share across cadence±nudge and file muxers drop packets around it)
if [ -n "$TSRPT" ]; then
    if echo "$TSRPT" | grep -qE 'backward=0.*backward=0'; then
        ok "RTP timestamps never step backward (wire)"
    else
        bad "RTP timestamps step backward on the wire" "$TSRPT"
    fi
    if echo "$TSRPT" | grep -qE 'spikes=0.*spikes=0'; then
        ok "no RTP timestamp spikes (wire)"
    else
        bad "RTP timestamp spike on the wire" "$TSRPT"
    fi
    # One-sided nudging tracks a genuinely off-rate source clock and is
    # fine; balanced two-sided nudging is a steering loop oscillating.
    A_STATS=$(echo "$TSRPT" | grep -oE 'audio ts-steps.*$')
    A_UP=$(echo "$A_STATS" | grep -oE 'up=[0-9]+' | grep -oE '[0-9]+')
    A_DOWN=$(echo "$A_STATS" | grep -oE 'down=[0-9]+' | grep -oE '[0-9]+')
    if [ -z "$A_UP" ]; then
        skip "audio wire cadence (no audio track)"
    else
        A_MINOR=$((A_UP < A_DOWN ? A_UP : A_DOWN))
        A_TOTAL=$((A_UP + A_DOWN))
        if [ "$A_TOTAL" -gt 20 ] && [ $((A_MINOR * 100 / A_TOTAL)) -ge 25 ]; then
            bad "audio RTP cadence oscillates (bang-bang steering)" "$A_STATS"
        else
            ok "audio RTP cadence steady ($A_STATS)"
        fi
    fi
fi
# UDP consumers need MTU-sized packets: bigger ones IP-fragment, so
# one lost fragment loses the whole packet (interleaved sizes mirror
# the same packetizer)
MAXRTP=$(echo "$GAPRPT" | grep -oE 'max-rtp=[0-9]+' | grep -oE '[0-9]+')
if [ -n "$MAXRTP" ]; then
    if [ "$MAXRTP" -le 1472 ]; then
        ok "RTP packets MTU-safe (max $MAXRTP bytes)"
    else
        bad "RTP packets exceed Ethernet MTU (IP-fragment on UDP)" "max $MAXRTP bytes"
    fi
fi

# ── 3b. Session lifecycle: silent-client reaping, transport re-SETUP ──
SESSRPT=$(timeout 40 python3 "$PROBES/session_probe.py" switch "$HOST" "$PORT" "$RPATH" ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} 2>&1)
echo "$SESSRPT" >"$WORK/switch.txt"
while IFS= read -r line; do
    case $line in
        OK\ *)   ok "${line#OK }" ;;
        FAIL\ *) bad "${line#FAIL }" ;;
        SKIP\ *) skip "${line#SKIP }" ;;
    esac
done <<< "$SESSRPT"
REAPRPT=$(timeout 110 python3 "$PROBES/session_probe.py" reap "$HOST" "$PORT" "$RPATH" ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} 2>&1)
echo "$REAPRPT" >"$WORK/reap.txt"
while IFS= read -r line; do
    case $line in
        OK\ *)   ok "${line#OK }" ;;
        FAIL\ *) bad "${line#FAIL }" ;;
        SKIP\ *) skip "${line#SKIP }" ;;
    esac
done <<< "$REAPRPT"

# ── 4. A/V timestamps in a real capture ──
# -copyinkf: ffmpeg's streamcopy waits for a key-flagged packet per
# stream, but its RTP AAC depacketizer never sets one (AAC is not
# intra-only to ffmpeg), so without it EVERY rtsp aac copy capture is
# silently audio-less — from any server, go2rtc included.
timeout -k 5 $((DUR * 2 + 20)) "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" \
    -c copy -copyinkf -t $((DUR * 2)) -y "$WORK/ts.mkv" 2>/dev/null
# Document the plain-copy behavior for NVR operators: no verdict on the
# server, but recorders using this ffmpeg without -copyinkf lose audio.
if grep -q "m=audio" "$WORK/sdp.txt" 2>/dev/null; then
    timeout -k 3 16 "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" \
        -c copy -t 6 -y "$WORK/plaincopy.mkv" 2>/dev/null
    PCA=$("$FFPROBE" -v error -select_streams a -show_entries packet=pts -of csv=p=0 "$WORK/plaincopy.mkv" 2>/dev/null | grep -c .)
    if [ "$PCA" -gt 0 ]; then
        ok "plain ffmpeg -c copy records audio ($PCA pkts/6s)"
    else
        skip "plain -c copy drops AAC audio (this ffmpeg never key-flags RTP AAC; recorders need -copyinkf or transcode)"
    fi
    rm -f "$WORK/plaincopy.mkv"
fi
VP=$("$FFPROBE" -v error -select_streams v -show_entries packet=pts_time -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | grep -vE 'N/A|^$' >"$WORK/v.pts"; wc -l <"$WORK/v.pts")
AP=$("$FFPROBE" -v error -select_streams a -show_entries packet=pts_time -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | grep -vE 'N/A|^$' >"$WORK/a.pts"; wc -l <"$WORK/a.pts")
if [ "$VP" -gt 30 ]; then
    TSRES=$(python3 - "$WORK/v.pts" "$WORK/a.pts" <<'EOF'
import sys
v = [float(x) for x in open(sys.argv[1])]
a = [float(x) for x in open(sys.argv[2])] if len(open(sys.argv[2]).read()) else []
mono_v = all(y >= x for x, y in zip(v, v[1:]))
if not a:
    print(f"video-only mono={mono_v} v={len(v)}")
    sys.exit(0 if mono_v else 1)
mono_a = all(y >= x for x, y in zip(a, a[1:]))
end_off = (a[-1] - v[-1]) * 1000
print(f"end_offset={end_off:+.0f}ms mono_v={mono_v} mono_a={mono_a} v={len(v)} a={len(a)}")
sys.exit(0 if (mono_v and mono_a and abs(end_off) < 500) else 1)
EOF
)
    if [ $? -eq 0 ]; then ok "A/V capture timestamps ($TSRES)"; else bad "A/V capture timestamps" "$TSRES"; fi
else
    bad "A/V capture timestamps" "capture produced only $VP video packets"
fi

# ── 4b. Audio cadence/drift (nominal-rate check from the capture) ──
if [ -n "$CONFIG" ] && [ "$AP" -gt 50 ]; then
    FS=1024
    [ ${#CONFIG} -ge 10 ] && FS=2048  # 5-byte BC-form ASC = HE-AAC, 2048/frame
    DRIFT=$(python3 - "$WORK/a.pts" "$FS" "$ACLK" <<'EOF'
import sys
a = [float(x) for x in open(sys.argv[1])]
fr = int(sys.argv[2]) / int(sys.argv[3])
n = len(a)
ppm = ((a[-1] - a[0]) / ((n - 1) * fr) - 1) * 1e6
print(f"{ppm:+.0f}ppm over {a[-1]-a[0]:.0f}s ({n} pkts)")
sys.exit(0 if abs(ppm) < 3000 else 1)
EOF
)
    if [ $? -eq 0 ]; then ok "audio cadence vs nominal ($DRIFT)"; else bad "audio cadence drift" "$DRIFT"; fi
else
    skip "audio drift (no AAC or too few audio packets)"
fi

# ── 4c. Decoded-content validation ──
if [ "$VP" -gt 30 ]; then
    VMETA=$("$FFPROBE" -v error -select_streams v -show_entries stream=width,height,r_frame_rate -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | head -1)
    W=$(echo "$VMETA" | cut -d, -f1)
    H=$(echo "$VMETA" | cut -d, -f2)
    NOMFPS=$(echo "$VMETA" | cut -d, -f3)
    FPSRES=$(python3 - "$WORK/v.pts" "$NOMFPS" <<'EOF'
import sys
v = [float(x) for x in open(sys.argv[1])]
num, den = (sys.argv[2].split("/") + ["1"])[:2]
nom = float(num) / float(den or 1)
meas = (len(v) - 1) / (v[-1] - v[0])
print(f"measured {meas:.2f}fps vs nominal {nom:.2f}")
sys.exit(0 if nom > 0 and abs(meas - nom) / nom < 0.15 else 1)
EOF
)
    if [ $? -eq 0 ]; then ok "video frame rate ($FPSRES)"; else bad "video frame rate" "$FPSRES"; fi
    if [ "${W:-0}" -ge 160 ] && [ "${H:-0}" -ge 120 ]; then
        ok "video resolution sane (${W}x${H})"
    else
        bad "video resolution" "${W}x${H}"
    fi
fi
if [ "$AP" -gt 30 ]; then
    ARATE=$("$FFPROBE" -v error -select_streams a -show_entries stream=sample_rate,channels -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | head -1)
    AR=$(echo "$ARATE" | cut -d, -f1)
    ACH=$(echo "$ARATE" | cut -d, -f2)
    ABYTES=$(timeout 60 "$FFMPEG" -nostdin -v quiet -i "$WORK/ts.mkv" -map a -f s16le - 2>/dev/null | wc -c)
    SAMPRES=$(python3 - "$WORK/a.pts" "$ABYTES" "${AR:-0}" "${ACH:-1}" <<'EOF'
import sys
a = [float(x) for x in open(sys.argv[1])]
span = a[-1] - a[0]
got = int(sys.argv[2]) // (2 * int(sys.argv[4]))
want = int(sys.argv[3]) * span
print(f"decoded {got} samples vs {want:.0f} expected over {span:.0f}s")
sys.exit(0 if want > 0 and abs(got - want) / want < 0.1 else 1)
EOF
)
    if [ $? -eq 0 ]; then ok "audio decodes at declared rate ($SAMPRES)"; else bad "audio decoded sample count" "$SAMPRES"; fi
fi

# Raw elementary stream: GOP cadence + per-frame SEI presence
VCODEC=$("$FFPROBE" -v error -select_streams v -show_entries stream=codec_name -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | head -1)
case "$VCODEC" in
h264) RAWFMT=h264 CEN=h264 ;;
hevc) RAWFMT=hevc CEN=h265 ;;
*) RAWFMT="" ;;
esac
if [ -n "$RAWFMT" ]; then
    timeout -k 5 24 "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" -map 0:v -c copy -t 15 -f "$RAWFMT" -y "$WORK/raw.es" 2>/dev/null
    CENSUS=$(python3 "$PROBES/nal_census.py" "$WORK/raw.es" "$CEN")
    echo "$CENSUS" >"$WORK/census.txt"
    IDRN=$(echo "$CENSUS" | grep -o 'idr=[0-9]*' | cut -d= -f2)
    VCLN=$(echo "$CENSUS" | grep -o 'vcl=[0-9]*' | cut -d= -f2)
    SEIN=$(echo "$CENSUS" | grep -o 'sei=[0-9]*' | cut -d= -f2)
    if [ "${IDRN:-0}" -ge 2 ]; then
        ok "GOP cadence: $IDRN keyframes in 15s ($CENSUS)"
    else
        bad "GOP cadence" "$CENSUS — a joiner may wait forever for a keyframe"
    fi
    if [ "${SEIN:-0}" -ge $((VCLN * 9 / 10)) ] && [ "${VCLN:-0}" -gt 0 ]; then
        ok "per-frame SEI present (${SEIN}/${VCLN} frames)"
    elif [ "${SEIN:-0}" -eq 0 ]; then
        skip "per-frame SEI (none in stream — raptor sei_timecode off or non-raptor server)"
    else
        bad "per-frame SEI coverage" "$SEIN of $VCLN frames"
    fi
fi

# ── 4d. RFC conformance (RFC 2326 / 4566 / 3550 / 3640) ──
python3 "$PROBES/rfc_check.py" "$HOST" "$PORT" "$RPATH" 8 ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} >"$WORK/rfc.txt" 2>&1
while IFS= read -r line; do
    case "$line" in
    OK\ *) ok "${line#OK }" ;;
    FAIL\ *) bad "${line#FAIL }" ;;
    esac
done <"$WORK/rfc.txt"

# ── 5a. Concurrency ladder: 2 -> 3 -> 4 simultaneous clients ──
# concurrent_check <label> <url> <n> <secs>: n clients (alternating
# TCP/UDP) run together; every one of them must come back clean.
concurrent_check() {
    local label=$1 curl=$2 n=$3 secs=$4
    local pids=() i
    for i in $(seq 1 "$n"); do
        local targ=()
        [ $((i % 2)) -eq 1 ] && targ=(-rtsp_transport tcp)
        timeout -k 5 $((secs + 14)) "$FFMPEG" -nostdin -v warning "${targ[@]}" -i "$curl"             -t "$secs" -f null - >"$WORK/conc_${label}_$i.log" 2>&1 &
        pids+=($!)
        CLIENT_PIDS="$CLIENT_PIDS $!"
    done
    for i in "${pids[@]}"; do wait "$i" 2>/dev/null; done
    local total=0 c rejected=0 streamed=0 missed=0 m
    for i in $(seq 1 "$n"); do
        if grep -qiE "Error opening input" "$WORK/conc_${label}_$i.log"; then
            rejected=$((rejected + 1))
            continue
        fi
        streamed=$((streamed + 1))
        # single-digit UDP loss is radio weather (see storm check)
        m=$(grep -ioE 'missed [0-9]+ packets' "$WORK/conc_${label}_$i.log" |
            grep -oE '[0-9]+' | awk '{s+=$1} END {print s+0}')
        missed=$((missed + m))
        c=$(grep -civE 'missed [0-9]+ packets' \
            <(grep -iE "$ERRPAT" "$WORK/conc_${label}_$i.log"))
        total=$((total + c))
    done
    if [ "$missed" -gt 0 ] && [ "$missed" -le 5 ] && [ "$total" -eq 0 ]; then
        echo "          note: $missed UDP packet(s) lost across $streamed clients (wireless-grade)"
    elif [ "$missed" -gt 5 ]; then
        total=$((total + missed))
    fi
    if [ "$total" -eq 0 ] && [ "$rejected" -eq 0 ]; then
        ok "$n concurrent clients on $label: all clean (${secs}s)"
    elif [ "$total" -eq 0 ] && [ "$streamed" -gt 0 ] && [ "${EXTERNAL_SESSIONS:-0}" -gt 0 ]; then
        # Server at its max_clients cap with pre-existing external
        # viewers: clean refusal + clean media for admitted clients is
        # correct behavior, not a stream defect.
        skip "$n clients on $label: $rejected refused at capacity ($EXTERNAL_SESSIONS external viewers), $streamed admitted all clean"
    else
        bad "$n concurrent clients on $label" "$rejected refused, $total error lines"
        cat "$WORK"/conc_"${label}"_*.log | grep -iE "$ERRPAT" | sort | uniq -c | sort -rn | head -3 | sed 's/^/          /'
    fi
}
for N in 2 3 4; do
    concurrent_check main "$URL" "$N" 10
done
if [ "$SUB_URL" != "$URL" ]; then
    concurrent_check sub "$SUB_URL" 2 10
    concurrent_check sub "$SUB_URL" 4 10
fi

# ── 5b. Concurrency: sustained UDP client vs join/leave churn ──
timeout -k 5 44 "$FFMPEG" -nostdin -v warning -i "$URL" -t 36 -f null - >"$WORK/sustained.log" 2>&1 &
APID=$!
CLIENT_PIDS="$CLIENT_PIDS $APID"
sleep 6
for joiner in "tcp $URL" "udp $URL" "udp $SUB_URL"; do
    set -- $joiner
    T=$1
    JURL=$2
    TARG=()
    [ "$T" = tcp ] && TARG=(-rtsp_transport tcp)
    timeout -k 3 10 "$FFMPEG" -nostdin -v quiet "${TARG[@]}" -i "$JURL" -t 7 -f null - >/dev/null 2>&1 &
    CLIENT_PIDS="$CLIENT_PIDS $!"
    sleep 9
done
wait $APID 2>/dev/null
if [ "$(grep -ciE "$ERRPAT" "$WORK/sustained.log")" -eq 0 ]; then
    ok "sustained UDP client clean across 3 join/leave cycles (36s)"
else
    bad "sustained client during joins" "see below"
    show_errs "$WORK/sustained.log"
fi

# ── 6. Regression: repeated default-transport probe sessions, then media ──
for i in 1 2 3; do
    timeout -k 3 12 "$FFPROBE" -v quiet -show_streams "$URL" >/dev/null 2>&1
done
if capture udp_after_probes "$DUR" "$URL"; then
    ok "UDP clean after 3x ffprobe (UDP dual-SETUP) sessions"
else
    # The fd-crosswiring regression this guards against loses THOUSANDS
    # of packets and decodes garbage; single-digit UDP loss on a
    # wireless link is radio weather, not that bug.
    STORM_MISSED=$(grep -ioE 'missed [0-9]+ packets' "$WORK/udp_after_probes.log" |
        grep -oE '[0-9]+' | awk '{s+=$1} END {print s+0}')
    STORM_OTHER=$(grep -icvE 'missed [0-9]+ packets|Last message repeated' \
        <(grep -iE "$ERRPAT" "$WORK/udp_after_probes.log"))
    if [ "${STORM_MISSED:-0}" -le 5 ] && [ "${STORM_OTHER:-0}" -le 2 ]; then
        ok "UDP after probe storm: minor wireless loss only ($STORM_MISSED pkts)"
    else
        bad "UDP after probe storm" "missed=$STORM_MISSED other=$STORM_OTHER"
        show_errs "$WORK/udp_after_probes.log"
    fi
fi

# ── 6b. Abrupt-kill client: RST mid-stream must not wound the server ──
timeout -k 3 20 "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" -f null - >/dev/null 2>&1 &
KPID=$!
CLIENT_PIDS="$CLIENT_PIDS $KPID"
sleep 4
pkill -9 -P "$KPID" 2>/dev/null
kill -9 "$KPID" 2>/dev/null
sleep 2
if capture after_kill 8 "$URL" tcp; then
    ok "clean media after an abruptly killed client"
else
    bad "media after abrupt client kill" "see below"
    show_errs "$WORK/after_kill.log"
fi

# ── 7. Device health (raptor bench, --ssh) ──
if [ -n "$SSH_TARGET" ]; then
    sleep 3
    RSDLINE=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" 'top -bn1' 2>/dev/null | grep -E '[r]sd -c' | head -1)
    # busybox top: PID PPID USER STAT VSZ %VSZ CPU %CPU COMMAND
    CPU=$(echo "$RSDLINE" | awk '{print $8}' | cut -d. -f1)
    if [ -n "$CPU" ] && [ "$CPU" -ge 0 ] 2>/dev/null && [ "$CPU" -lt 20 ]; then
        ok "rsd CPU sane post-suite (${CPU}%)"
    else
        bad "rsd CPU post-suite" "${RSDLINE:-no rsd process found}"
    fi
    # Compare against the baseline taken before any suite traffic:
    # external viewers (an NVR watching a deployed camera) are not
    # leaks, growth over the run is.
    NCONN=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" "netstat -tn 2>/dev/null | grep ESTABLISHED | grep -c :$PORT" 2>/dev/null)
    if [ "${NCONN:-1}" -le "${EXTERNAL_SESSIONS:-0}" ]; then
        ok "no leaked TCP connections (baseline $EXTERNAL_SESSIONS external, now ${NCONN:-0})"
    else
        bad "leaked TCP connections" "baseline ${EXTERNAL_SESSIONS:-0}, now ${NCONN:-?}"
    fi
    # IPv6 leg: dual-stack listeners have had v4/v6 path differences;
    # production NVRs commonly attach over v6.
    V6=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        "ip -6 addr show scope global 2>/dev/null | grep -oE 'inet6 [0-9a-f:]+' | head -1 | cut -d' ' -f2" 2>/dev/null)
    if [ -n "$V6" ]; then
        V6CRED=""
        [ -n "$RTSP_USER" ] && V6CRED="$RTSP_USER:$RTSP_PASS@"
        if capture ipv6_tcp "$DUR" "rtsp://${V6CRED}[$V6]:$PORT$RPATH" tcp; then
            ok "IPv6: clean media over TCP ([$V6])"
        else
            bad "IPv6 media" "see $WORK/ipv6_tcp.log"
            show_errs "$WORK/ipv6_tcp.log"
        fi
    else
        skip "IPv6 leg (no global v6 address on target)"
    fi
else
    skip "device health (--ssh not given)"
fi

# ── 8. mpv: real player over both transports ──
mpv_check() {
    local name=$1 turl=$2
    shift 2
    mpv --no-config --vo=null --ao=null "$@" --length=10 "$turl" >"$WORK/$name.log" 2>&1
    local errs
    errs=$(tr '\r' '\n' <"$WORK/$name.log" | grep -ciE "$ERRPAT")
    local av
    av=$(tr '\r' '\n' <"$WORK/$name.log" | grep -oE 'A-V: *-?[0-9.]+' | tail -1 | grep -oE '[-0-9.]+$')
    if [ "$errs" -gt 0 ]; then
        bad "$name" "see below"
        tr '\r' '\n' <"$WORK/$name.log" | grep -iE "$ERRPAT" | sort | uniq -c | sort -rn | head -3 | sed 's/^/          /'
    elif [ -n "$av" ] && ! python3 -c "import sys; sys.exit(0 if abs(float('$av')) < 0.1 else 1)"; then
        bad "$name" "A-V=${av}"
    else
        ok "$name (A-V=${av:-n/a})"
    fi
}
if command -v mpv >/dev/null 2>&1; then
    mpv_check "mpv TCP playback" "$URL" --rtsp-transport=tcp
    mpv_check "mpv UDP playback" "$URL" --rtsp-transport=udp
else
    skip "mpv (not installed)"
fi

# clip_verify <name> <file> — a recorded clip must have sane streams,
# matching durations, and decode with zero errors.
clip_verify() {
    local name=$1 f=$2
    local slug
    slug=$(echo "$name" | tr -c 'A-Za-z0-9._-' '_')
    if [ ! -s "$f" ]; then
        bad "$name" "no file"
        return
    fi
    local info vdur adur
    info=$("$FFPROBE" -v error -show_entries stream=codec_type,duration -of csv=p=0 "$f" 2>/dev/null)
    vdur=$(echo "$info" | grep '^video' | cut -d, -f2 | cut -d. -f1)
    adur=$(echo "$info" | grep '^audio' | cut -d, -f2 | cut -d. -f1)
    "$FFMPEG" -nostdin -v error -i "$f" -f null - >"$WORK/$slug.decode.log" 2>&1
    local derr
    # The null muxer re-times to 1/1000 and nags about colliding dts
    # (wallclock-stamped recorders collide for real under bursty WiFi
    # arrival); drop the nag AND its "Last message repeated" tails.
    derr=$(grep -viE 'non monotonically increasing dts to muxer|Last message repeated' \
        "$WORK/$slug.decode.log" | grep -c .)
    # File-level timestamp truth instead: dts must never move backward.
    local vback
    vback=$("$FFPROBE" -v error -select_streams v -show_entries packet=dts -of csv=p=0 "$f" 2>/dev/null |
        awk 'NR>1 && $1+0 < prev+0 {n++} {prev=$1} END {print n+0}')
    if [ -z "$vdur" ]; then
        bad "$name" "no video stream"
    elif [ "${derr:-1}" -gt 0 ]; then
        bad "$name" "decode errors, see $WORK/$slug.decode.log"
    elif [ "${vback:-0}" -gt 0 ]; then
        bad "$name" "video dts moves backward $vback times in the file"
    elif [ -n "$adur" ] && { [ $((vdur - adur)) -gt 1 ] || [ $((adur - vdur)) -gt 1 ]; }; then
        bad "$name" "duration mismatch v=${vdur}s a=${adur}s"
    else
        ok "$name (v=${vdur}s a=${adur:-none}s, decode clean)"
    fi
}

# ── 9. go2rtc restream (--go2rtc) ──
if [ -n "$GO2RTC" ]; then
    G2NAME="raptortest$$"
    ENC_URL=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$URL")
    if curl -s -m 8 -X PUT "$GO2RTC/api/streams?name=$G2NAME&src=$ENC_URL" >/dev/null 2>&1; then
        G2HOST=${GO2RTC#http://}
        G2HOST=${G2HOST%%:*}
        G2URL="rtsp://$G2HOST:8554/$G2NAME"
        sleep 2
        if timeout -k 5 $((DUR + 14)) "$FFMPEG" -nostdin -v warning -rtsp_transport tcp -i "$G2URL" -t "$DUR" -f null - >"$WORK/go2rtc.log" 2>&1             && [ "$(grep -ciE "$ERRPAT" "$WORK/go2rtc.log")" -eq 0 ]; then
            ok "go2rtc restream: clean media (${DUR}s)"
        else
            bad "go2rtc restream" "see below"
            show_errs "$WORK/go2rtc.log"
        fi
        if [ -n "$CONFIG" ]; then
            G2SDP=$(python3 - "$G2HOST" 8554 "/$G2NAME" <<'EOF'
import socket, sys
host, port, path = sys.argv[1], int(sys.argv[2]), sys.argv[3]
s = socket.create_connection((host, port), timeout=5)
s.sendall(f"DESCRIBE rtsp://{host}:{port}{path} RTSP/1.0\r\nCSeq: 1\r\nAccept: application/sdp\r\n\r\n".encode())
buf = b""
import time
t0 = time.time()
while time.time() - t0 < 6 and len(buf) < 16384:
    try:
        d = s.recv(4096)
    except socket.timeout:
        break
    if not d:
        break
    buf += d
print(buf.decode(errors="replace"))
EOF
)
            if echo "$G2SDP" | grep -qi "config=$CONFIG"; then
                ok "go2rtc passes AAC config= through verbatim"
            else
                bad "go2rtc AAC config= passthrough" "origin $CONFIG not found in restream SDP"
            fi
        fi
        curl -s -m 8 -X DELETE "$GO2RTC/api/streams?src=$G2NAME" >/dev/null 2>&1
    else
