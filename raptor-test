#!/bin/bash
# raptor-test -- standalone live-stream conformance suite for RTSP
# servers. Built for the Raptor Streaming System, works against any
# RTSP source (generic checks self-skip when a feature is absent).
#
# Exercises what unit tests cannot: real sessions over TCP AND UDP,
# multiple concurrent clients, join/leave churn, wire-level sequence
# continuity, A/V timestamp sanity, and signaling byte-accuracy.
# Every check exists because an ad-hoc test once missed the bug it
# now catches.
#
# Usage: raptor-test <rtsp-url> [options] -- run with --help for the
# full option list and exit codes.
#
# Requirements: ffmpeg+ffprobe (FFMPEG/FFPROBE env override), python3.
# mpv used if present. All log matching is case-insensitive; failing
# checks print the exact matched lines; logs persist on failure.
# Background clients are killed via their own process tree -- never
# kill only a timeout wrapper (orphaned ffmpeg streams forever).
set -u

# Run from a private copy: editing this file while a battery is live
# corrupts the running interpreter's parse (bash reads incrementally).
if [ -z "${RAPTOR_TEST_SELF:-}" ]; then
    RAPTOR_TEST_HOME="$(cd "$(dirname "$0")" && pwd)"
    export RAPTOR_TEST_HOME
    RAPTOR_TEST_SELF=$(mktemp "${TMPDIR:-/tmp}/raptor-test-run.XXXXXX")
    export RAPTOR_TEST_SELF
    cp "$0" "$RAPTOR_TEST_SELF"
    exec /bin/bash "$RAPTOR_TEST_SELF" "$@"
fi

usage() {
    cat <<'EOF'
usage: raptor-test <rtsp-url> [options]

Options:
  --sub <url>          second stream URL (concurrency mix; default: main url)
  --ssh <user@host>    enable device-side health checks (raptor bench)
  --user <u> --pass <p>  RTSP digest credentials (enables the auth battery)
  --duration <s>       base capture duration (default 12)
  --go2rtc <apiurl>    test through a go2rtc restream (e.g. http://host:1984)
                       "local" spawns a pinned go2rtc from tools/ for the run
  --mediamtx <arg>     test through a mediamtx restream: "local" spawns a
                       pinned mediamtx from tools/, or pass its API URL
  --frigate            record via a local dockerized Frigate, verify the clips
  --record-check <d>   verify the newest .mp4 in a directory (e.g. rmr output)
  --rhd <baseurl>      RHD HTTP checks: /snap, /mjpeg, /audio (https://host:8443)
  --srt <url>          SRT leg (srt://host:9000): MPEG-TS video+audio decode
  --tls <rtsps-url>    RTSPS/TLS leg (server needs [rtsp] tls=true)
  --rtmp <port>        listen for rsp's RTMP push on this port
  --webrtc <whip-url>  WebRTC leg via rwd WHIP (H264 stream; needs webrtc-venv)
  --gop <frames>       assert the measured GOP interval equals this value
  --fuzz               throw malformed RTSP at the server, assert it survives
  --cold               RHD cold-start snapshots (adds ~55s idle; needs --rhd)
  --producer-restart   restart the ring producer mid-stream, assert recovery
  --clock-step         step the camera clock mid-stream, assert the media
                       timeline survives it (needs --ssh)
                       (needs --ssh; disruptive, so it runs last)
  --daynight           ric day/night hardware cycle: manual verbs, then
                       real light transitions (needs --ssh and both
                       --lights-on/--lights-off; bench with controllable
                       room lighting only)
  --daynight-only      run ONLY the day/night cycle and exit; no rtsp
                       URL needed (daemons must already be running)
  --only <regex>       run only suite sections whose key matches. Keys:
                       signaling auth transports wire sessions avts drift
                       content rfc restream concurrency regression kill
                       health mpv join ortsp slow backchannel mjpeg
                       (+ flag-gated: soak fuzz daynight rhd srt tls rtmp
                       webrtc frigate reccheck). Some legs derive context
                       (e.g. codec) from earlier sections and fall back
                       to defaults when those are skipped.
  --lights-on <cmd>    shell command that turns the room lights on
  --lights-off <cmd>   shell command that turns the room lights off
  --bench-quiesce <c>  run before the daynight cycle: neutralize OTHER
                       bench cameras (their auto-night IR floods the
                       room and fakes a lit scene). --bench-restore
                       runs when the cycle ends.
  --bench-restore <c>  see --bench-quiesce
  --json <file>        also write one JSON record per check (JSONL)
  --fps-tol <frac>     video fps tolerance vs nominal (default 0.15)
  --drift-ppm <n>      audio cadence drift ceiling in ppm (default 3000)
  --bitrate-tol <f>    video bitrate tolerance vs SDP b=AS (default 0.35)
  --srt-secs <n>       SRT capture window in seconds (default 30)
  --dur <n>            transport capture window in seconds; the A/V
                       analysis capture is twice this (default 30)
  --srt-passphrase <p> SRT AES passphrase; also tests wrong-key rejection
  --drift-secs <n>     audio drift capture seconds (default 30; longer = tighter)
  --core               fast core subset: signaling, transports, wire,
                       content, RFC/robustness; skips sessions,
                       concurrency, players and all legs (self-check)
  --soak <minutes>     endurance mode: repeated bounded captures with
                       device RSS/FD trending (needs --ssh for trends);
                       replaces the normal battery
  --keep-logs          keep the log directory even on success
  -h, --help           this text

Exit codes: 0 all checks passed (skips allowed), 1 at least one check
failed (names listed, logs kept), 2 usage error.
EOF
}
case "${1:-}" in
-h|--help) usage; exit 0 ;;
esac
[ $# -ge 1 ] || { echo "usage: raptor-test <rtsp-url> [options]   (--help for the full list)" >&2; exit 2; }
# --daynight-only needs no stream: allow invocation without a URL.
URL=""
case "$1" in
rtsp://*) URL=$1; shift ;;
--daynight-only) ;;
*) echo "error: first argument must be an rtsp:// URL (got: $1)" >&2; exit 2 ;;
esac
SUB_URL=""
SSH_TARGET=""
DUR=30
KEEP=0
GO2RTC=""
MEDIAMTX=""
FRIGATE=0
RECDIR=""
RTSP_USER=""
RTSP_PASS=""
RHD_URL=""
SRT_URL=""
TLS_URL=""
RTMP_PORT=""
WEBRTC_URL=""
GOP_EXPECT=""
SOAK_MIN=""
CORE=0
JSON_FILE=""
FUZZ=0
COLD=0
RESTART=0
CLOCKSTEP=0
FPS_TOL=0.15
DRIFT_PPM=3000
BITRATE_TOL=0.35
SRT_SECS=30
SRT_PASSPHRASE=""
DRIFT_SECS=30
DAYNIGHT=0
DAYNIGHT_ONLY=0
ONLY=""

# --only <regex>: section gate. Runtime sections sit in `if want <key>`
# blocks; unset ONLY runs everything.
want() {
    [ -z "$ONLY" ] && return 0
    echo "$1" | grep -qE "$ONLY"
}
# Cross-section context normally set inside wrapped sections; safe
# defaults keep --only subsets runnable under set -u.
AUDIO_ONLY=0
BENCH_QUIESCE_CMD=""
BENCH_RESTORE_CMD=""
LIGHTS_ON_CMD=""
LIGHTS_OFF_CMD=""
while [ $# -gt 0 ]; do
    case "$1" in
    --sub) SUB_URL=$2; shift 2 ;;
    --ssh) SSH_TARGET=$2; shift 2 ;;
    --daynight) DAYNIGHT=1; shift ;;
    --only) ONLY=$2; shift 2 ;;
    --bench-quiesce) BENCH_QUIESCE_CMD=$2; shift 2 ;;
    --bench-restore) BENCH_RESTORE_CMD=$2; shift 2 ;;
    --daynight-only) DAYNIGHT=1; DAYNIGHT_ONLY=1; shift ;;
    --lights-on) LIGHTS_ON_CMD=$2; shift 2 ;;
    --lights-off) LIGHTS_OFF_CMD=$2; shift 2 ;;
    --duration) DUR=$2; shift 2 ;;
    --go2rtc) GO2RTC=$2; shift 2 ;;
    --mediamtx) MEDIAMTX=$2; shift 2 ;;
    --frigate) FRIGATE=1; shift ;;
    --record-check) RECDIR=$2; shift 2 ;;
    --gop) GOP_EXPECT=$2; shift 2 ;;
    --soak) SOAK_MIN=$2; shift 2 ;;
    --fuzz) FUZZ=1; shift ;;
    --cold) COLD=1; shift ;;
    --producer-restart) RESTART=1; shift ;;
    --clock-step) CLOCKSTEP=1; shift ;;
    --json) JSON_FILE=$2; shift 2 ;;
    --fps-tol) FPS_TOL=$2; shift 2 ;;
    --drift-ppm) DRIFT_PPM=$2; shift 2 ;;
    --bitrate-tol) BITRATE_TOL=$2; shift 2 ;;
    --srt-secs) SRT_SECS=$2; shift 2 ;;
    --dur) DUR=$2; shift 2 ;;
    --srt-passphrase) SRT_PASSPHRASE=$2; shift 2 ;;
    --drift-secs) DRIFT_SECS=$2; shift 2 ;;
    --core) CORE=1; shift ;;
    --keep-logs) KEEP=1; shift ;;
    --user) RTSP_USER=$2; shift 2 ;;
    --pass) RTSP_PASS=$2; shift 2 ;;
    --rhd) RHD_URL=$2; shift 2 ;;
    --srt) SRT_URL=$2; shift 2 ;;
    --tls) TLS_URL=$2; shift 2 ;;
    --rtmp) RTMP_PORT=$2; shift 2 ;;
    --webrtc) WEBRTC_URL=$2; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done
[ -n "$SUB_URL" ] || SUB_URL=$URL

HOSTPORT=${URL#rtsp://}
HOSTPORT=${HOSTPORT%%/*}
case "$HOSTPORT" in
*@*)
    USERINFO=${HOSTPORT%%@*}
    RTSP_USER=${RTSP_USER:-${USERINFO%%:*}}
    RTSP_PASS=${RTSP_PASS:-${USERINFO#*:}}
    HOSTPORT=${HOSTPORT##*@}
    ;;
esac
# An IPv6 literal arrives bracketed ([fdfc::155]:554). HOST is kept
# bare: the python probes hand it straight to the socket layer, and
# rtsplib re-brackets it for request-URIs itself.
case "$HOSTPORT" in
\[*)
    HOST=${HOSTPORT%%]*}; HOST=${HOST#\[}
    PORT=${HOSTPORT##*]}; PORT=${PORT#:}
    [ -n "$PORT" ] || PORT=554
    ;;
*)
    HOST=${HOSTPORT%%:*}
    PORT=${HOSTPORT##*:}
    [ "$PORT" = "$HOST" ] && PORT=554
    ;;
esac
RPATH=/${URL#rtsp://*/}

# With --user/--pass, client legs (ffmpeg/mpv/go2rtc/frigate) get the
# credentials in the URL; raw probes take them as arguments and speak
# digest themselves. HOST/PORT/RPATH always stay credential-free.
if [ -n "$RTSP_USER" ]; then
    case "$URL" in *@*) : ;; *) URL="rtsp://$RTSP_USER:$RTSP_PASS@${URL#rtsp://}" ;; esac
    case "$SUB_URL" in *@*) : ;; *) SUB_URL="rtsp://$RTSP_USER:$RTSP_PASS@${SUB_URL#rtsp://}" ;; esac
fi

DIR="${RAPTOR_TEST_HOME:-$(cd "$(dirname "$0")" && pwd)}"
PROBES="$DIR/probes"
# Client pinning: RTSP behavior shifts between ffmpeg majors (7.1
# streamcopy silently drops RTSP AAC audio; 8.x fixed it). Prefer the
# pinned build in tools/ (tools/fetch-tools.sh) over the system one;
# an explicit FFMPEG/FFPROBE env override still wins.
if [ -z "${FFMPEG:-}" ] && [ -x "$DIR/tools/ffmpeg" ]; then
    FFMPEG="$DIR/tools/ffmpeg"
    FFPROBE="$DIR/tools/ffprobe"
fi
FFMPEG=${FFMPEG:-ffmpeg}
FFPROBE=${FFPROBE:-ffprobe}
# Fail fast if a probe is missing or unimportable (a deleted helper
# module once surfaced as a mid-run traceback instead)
if ! python3 - "$PROBES" <<'EOF'
import pathlib, py_compile, sys
for p in sorted(pathlib.Path(sys.argv[1]).glob("*.py")):
    py_compile.compile(str(p), doraise=True)
sys.path.insert(0, sys.argv[1])
import rtsplib  # noqa: F401  (shared helper the probes import)
EOF
then
    echo "FATAL: probe scripts under $PROBES do not compile/import" >&2
    exit 2
fi

# Baseline established RTSP sessions before we generate any traffic
# (a deployed camera may have an NVR attached; that context changes
# how capacity rejections and the final connection count are judged).
EXTERNAL_SESSIONS=0
if [ -n "$SSH_TARGET" ]; then
    EXTERNAL_SESSIONS=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        "netstat -tn 2>/dev/null | grep ESTABLISHED | grep -c :$PORT" 2>/dev/null)
    EXTERNAL_SESSIONS=${EXTERNAL_SESSIONS:-0}
    [ "$EXTERNAL_SESSIONS" -gt 0 ] && \
        echo "    note: $EXTERNAL_SESSIONS pre-existing RTSP session(s) on the target"
    # Baselines for the post-suite health checks: device log position
    # (only lines emitted DURING the run are judged) and device-side
    # framesource drop counters ("losted buffers" in isp-fs).
    LOG_BASE=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" 'logread 2>/dev/null | wc -l' 2>/dev/null)
    DROP_BASE=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        'test -f /proc/jz/isp/isp-fs && grep -i "lost" /proc/jz/isp/isp-fs | awk "{s+=\$NF} END{print s+0}" || echo NA' 2>/dev/null)
fi
WORK="./raptor-test-logs/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$WORK"
PASS=0
FAIL=0
SKIP=0
declare -a FAILED_NAMES

# Error classes that mean broken media, matched case-insensitively.
# 'non monotonically increasing dts to muxer' is deliberately absent:
# -f null forces a 1/1000 timebase, so 30fps frames legally round to
# equal milliseconds and the muxer nags. True timestamp monotonicity
# is verified from a real capture in native timebases (section 4) and
# on the wire (RFC probe).
ERRPAT='missed|dropping|discontinuity|corrupt|concealing|invalid data|error while decoding'

json_emit() {  # status name detail
    [ -z "$JSON_FILE" ] && return
    local st=$1 nm=$2 dt=${3:-}
    nm=${nm//\\/\\\\}; nm=${nm//\"/\\\"}
    dt=${dt//\\/\\\\}; dt=${dt//\"/\\\"}
    printf '{"status":"%s","name":"%s","detail":"%s"}\n' "$st" "$nm" "$dt" >> "$JSON_FILE"
}
ok() { echo "  PASS  $1"; PASS=$((PASS + 1)); json_emit pass "$1"; }
skip() { echo "  SKIP  $1"; SKIP=$((SKIP + 1)); json_emit skip "$1"; }

print_result() {
    echo ""
    echo "=== RESULT: $PASS passed, $FAIL failed, $SKIP skipped ==="
    if [ "$FAIL" -gt 0 ]; then
        printf '  failed: %s\n' "${FAILED_NAMES[@]}"
        echo "  logs kept in: $WORK"
        exit 1
    fi
    [ "$KEEP" = 1 ] && echo "  logs kept in: $WORK"
    exit 0
}

daynight_cycle() {
    if [ -z "$SSH_TARGET" ] || [ -z "$LIGHTS_ON_CMD" ] || [ -z "$LIGHTS_OFF_CMD" ]; then
        skip "daynight cycle (needs --ssh, --lights-on and --lights-off)"
    else
        DN_SSH() { ssh -o ConnectTimeout=8 "$SSH_TARGET" "$@"; }
        # Remote: wait for a state, tracking the max gain seen on the way
        # (the pre-night dark ceiling feeds the photon check). One ssh per
        # leg, not one per poll.
        DN_WAIT='
state=$1; budget=$2
t0=$(date +%s); maxgain=0
while :; do
    s=$(raptorctl ric status 2>/dev/null)
    g=$(printf %s "$s" | sed -n "s/.*\"total_gain\":\([0-9]*\).*/\1/p")
    [ -n "$g" ] && [ "$g" -gt "$maxgain" ] && maxgain=$g
    case "$s" in *"\"state\":\"$state\""*)
        echo "OK $(( $(date +%s)-t0 )) $maxgain"; exit 0;; esac
    [ $(( $(date +%s)-t0 )) -ge "$budget" ] && { echo "TIMEOUT $budget $maxgain"; exit 1; }
    sleep 2
done'
        DN_HOLD='
secs=$1; shift
t0=$(date +%s); flaps=0; ledoff=0; n=0
while [ $(( $(date +%s)-t0 )) -lt "$secs" ]; do
    s=$(raptorctl ric status 2>/dev/null); n=$((n+1))
    case "$s" in *"\"state\":\"night\""*) ;; "") ;; *) flaps=$((flaps+1));; esac
    for p in "$@"; do
        v=$(cat /sys/class/gpio/gpio"$p"/value 2>/dev/null)
        [ "$v" = "0" ] && ledoff=$((ledoff+1))
    done
    sleep 3
done
echo "$n $flaps $ledoff"'
        DN_LEDVALS='for p in "$@"; do cat /sys/class/gpio/gpio"$p"/value 2>/dev/null || echo "?"; done'

        DN_STATUS=$(DN_SSH "raptorctl ric status" 2>/dev/null)
        if ! echo "$DN_STATUS" | grep -q '"state"'; then
            bad "daynight: ric status" "no parsable status: ${DN_STATUS:-empty}"
        elif ! echo "$DN_STATUS" | grep -q '"mode":[[:space:]]*"auto"'; then
            bad "daynight: ric in auto mode" "$DN_STATUS"
        else
            ok "daynight: ric answering in auto mode"
            # Other bench cameras in auto go night when the room darkens
            # and their IR floods the scene (a Wyze V2 lit the V3's
            # "dark" re-acquisition to gain 441). Quiesce them first.
            [ -n "$BENCH_QUIESCE_CMD" ] && eval "$BENCH_QUIESCE_CMD" > /dev/null 2>&1
            # IR LED pins from the board's hardware map (not raptor config)
            IR_PINS=$(DN_SSH 'jct /etc/thingino.json get gpio.ir850 2>/dev/null; jct /etc/thingino.json get gpio.ir940 2>/dev/null' </dev/null | grep -E '^[0-9]+$' | tr '\n' ' ')
            # ── manual verbs ──
            MV=$(DN_SSH "raptorctl ric mode night" </dev/null)
            sleep 2
            NIGHT_SET=""
            if [ -n "$IR_PINS" ]; then
                i=0
                for v in $(printf '%s\n' "$DN_LEDVALS" | DN_SSH sh -s -- $IR_PINS); do
                    i=$((i + 1))
                    pin=$(echo "$IR_PINS" | cut -d' ' -f$i)
                    [ "$v" = "1" ] && NIGHT_SET="$NIGHT_SET $pin"
                done
                NIGHT_SET=${NIGHT_SET# }
                if [ -n "$NIGHT_SET" ]; then
                    ok "daynight: forced night lights an IR bank (gpio $NIGHT_SET)"
                else
                    bad "daynight: forced night lights an IR bank" \
                        "pins $IR_PINS all low after mode night"
                fi
            else
                skip "daynight: IR LED rail checks (no IR pins in thingino.json)"
            fi
            echo "$MV" | grep -q '"state":[[:space:]]*"night"' &&
                ok "daynight: mode night forces night" ||
                bad "daynight: mode night forces night" "$MV"
            MV=$(DN_SSH "raptorctl ric mode day" </dev/null)
            sleep 2
            echo "$MV" | grep -q '"state":[[:space:]]*"day"' &&
                ok "daynight: mode day forces day" ||
                bad "daynight: mode day forces day" "$MV"
            if [ -n "$NIGHT_SET" ]; then
                LOW=1
                for v in $(printf '%s\n' "$DN_LEDVALS" | DN_SSH sh -s -- $NIGHT_SET); do
                    [ "$v" = "0" ] || LOW=0
                done
                [ "$LOW" = 1 ] &&
                    ok "daynight: forced day cuts the IR bank" ||
                    bad "daynight: forced day cuts the IR bank" "gpio $NIGHT_SET not all low"
            fi
            for bank in ir850 ir940; do
                RC=$(DN_SSH "raptorctl ric $bank on" </dev/null)
                case "$RC" in
                *'"status":"ok"'*)
                    DN_SSH "raptorctl ric $bank off" </dev/null > /dev/null 2>&1
                    ok "daynight: manual $bank on/off" ;;
                *"no $bank pin"*)
                    skip "daynight: manual $bank (no pin on this board)" ;;
                *)
                    bad "daynight: manual $bank" "$RC" ;;
                esac
            done
            DN_SSH "raptorctl ric ircut night" </dev/null | grep -q '"status":"ok"' &&
                DN_SSH "raptorctl ric ircut day" </dev/null | grep -q '"status":"ok"' &&
                ok "daynight: manual ircut night/day" ||
                bad "daynight: manual ircut night/day" "drive rejected"
            # Perturbed rails must yield to a forced mode: bench verbs move
            # hardware without touching the daemon's bookkeeping, and a
            # force that matches the bookkept state must still drive (the
            # Wyze V3 silent-no-op bug). Only the auto-managed bank is
            # asserted low: a manually lit disabled bank staying lit is
            # documented manual-beats-automatic behavior.
            if [ -n "$NIGHT_SET" ]; then
                DN_SSH "raptorctl ric ir850 on 2>/dev/null; raptorctl ric ir940 on 2>/dev/null; raptorctl ric ircut night" </dev/null > /dev/null 2>&1
                sleep 1
                DN_SSH "raptorctl ric mode day" </dev/null > /dev/null 2>&1
                sleep 2
                LOW=1
                for v in $(printf '%s\n' "$DN_LEDVALS" | DN_SSH sh -s -- $NIGHT_SET); do
                    [ "$v" = "0" ] || LOW=0
                done
                [ "$LOW" = 1 ] &&
                    ok "daynight: forced day re-asserts perturbed rails" ||
                    bad "daynight: forced day re-asserts perturbed rails" \
                        "gpio $NIGHT_SET still high after mode day"
                DN_SSH "raptorctl ric ir850 off 2>/dev/null; raptorctl ric ir940 off 2>/dev/null; true" </dev/null > /dev/null 2>&1
            fi
            DN_SSH "raptorctl ric mode auto" </dev/null | grep -q '"mode":[[:space:]]*"auto"' &&
                ok "daynight: back to auto" || bad "daynight: back to auto" "verb failed"

            # ── real light transitions ──
            eval "$LIGHTS_ON_CMD" > /dev/null 2>&1
            R=$(printf '%s\n' "$DN_WAIT" | DN_SSH sh -s -- day 90)
            case "$R" in
            OK*) ok "daynight: lit room settles to day ($(echo "$R" | cut -d' ' -f2)s)" ;;
            *) bad "daynight: lit room settles to day" "$R" ;;
            esac

            eval "$LIGHTS_OFF_CMD" > /dev/null 2>&1
            R=$(printf '%s\n' "$DN_WAIT" | DN_SSH sh -s -- night 45)
            case "$R" in
            OK*)
                DUSK_T=$(echo "$R" | cut -d' ' -f2)
                DARK_CEIL=$(echo "$R" | cut -d' ' -f3)
                ok "daynight: dusk reaches night (${DUSK_T}s)"
                sleep 6
                NL=$(DN_SSH "raptorctl ric status" </dev/null |
                    sed -n 's/.*"ae_luma":\([0-9]*\).*/\1/p')
                # Photon check: luma is AE-normalized, so with the LEDs
                # actually emitting, the IR-lit scene reads near the AE
                # target (~70 on both benches) within seconds; a dead
                # emitter leaves the dark-scene luma (<10). Gain cannot
                # carry this check: fast triggers sample it mid-walk.
                if [ -n "$NIGHT_SET" ] && [ -n "$NL" ]; then
                    if [ "$NL" -ge 30 ]; then
                        ok "daynight: IR emitters light the scene (night luma $NL)"
                    else
                        bad "daynight: IR emitters light the scene" \
                            "night luma $NL with LEDs driven: dark scene, dead emitter?"
                    fi
                fi
                ;;
            *) bad "daynight: dusk reaches night" "$R" ;;
            esac

            R=$(printf '%s\n' "$DN_HOLD" | DN_SSH sh -s -- 45 $NIGHT_SET)
            HN=$(echo "$R" | cut -d' ' -f1)
            HF=$(echo "$R" | cut -d' ' -f2)
            HL=$(echo "$R" | cut -d' ' -f3)
            if [ "${HF:-1}" = 0 ] && [ "${HL:-1}" = 0 ] && [ "${HN:-0}" -ge 10 ]; then
                ok "daynight: dark hold stable ($HN samples, 0 flaps, 0 LED blinks)"
            else
                bad "daynight: dark hold stable" \
                    "samples=$HN flaps=$HF led-off-samples=$HL"
            fi

            # Wash-dominated benches (IR a hand-span from the wall) can hide
            # the room lights from every AE metric; a short recheck interval
            # bounds the dawn legs. Set only AFTER the dark hold, which must
            # run at the default cadence to stay a pure false-blink detector.
            DN_SSH "raptorctl ric set-threshold probe_recheck_sec 20" </dev/null > /dev/null 2>&1
            PROBE_BEFORE=$(DN_SSH "logread 2>/dev/null | grep -c 'ambient probe'" </dev/null)
            eval "$LIGHTS_ON_CMD" > /dev/null 2>&1
            R=$(printf '%s\n' "$DN_WAIT" | DN_SSH sh -s -- day 90)
            case "$R" in
            OK*)
                DAWN_T=$(echo "$R" | cut -d' ' -f2)
                PROBE_AFTER=$(DN_SSH "logread 2>/dev/null | grep -c 'ambient probe'" </dev/null)
                VIA="ratio"
                [ "${PROBE_AFTER:-0}" -gt "${PROBE_BEFORE:-0}" ] && VIA="probe"
                ok "daynight: dawn returns to day (${DAWN_T}s via $VIA)"
                if [ -n "$NIGHT_SET" ]; then
                    LOW=1
                    for v in $(printf '%s\n' "$DN_LEDVALS" | DN_SSH sh -s -- $NIGHT_SET); do
                        [ "$v" = "0" ] || LOW=0
                    done
                    [ "$LOW" = 1 ] &&
                        ok "daynight: dawn leaves the IR bank off" ||
                        bad "daynight: dawn leaves the IR bank off" "gpio $NIGHT_SET still high"
                fi
                ;;
            *) bad "daynight: dawn returns to day" "$R" ;;
            esac

            eval "$LIGHTS_OFF_CMD" > /dev/null 2>&1
            R=$(printf '%s\n' "$DN_WAIT" | DN_SSH sh -s -- night 45)
            case "$R" in
            OK*) ok "daynight: second dusk repeats ($(echo "$R" | cut -d' ' -f2)s)" ;;
            *) bad "daynight: second dusk repeats" "$R" ;;
            esac

            # Dark re-acquisition: force day in darkness, release to auto,
            # and the trigger must find its way back -- the daemon-level
            # stand-in for a camera that boots at night.
            DN_SSH "raptorctl ric mode day" </dev/null > /dev/null 2>&1
            sleep 2
            DN_SSH "raptorctl ric mode auto" </dev/null > /dev/null 2>&1
            R=$(printf '%s\n' "$DN_WAIT" | DN_SSH sh -s -- night 45)
            case "$R" in
            OK*) ok "daynight: dark re-acquisition after forced day ($(echo "$R" | cut -d' ' -f2)s)" ;;
            *) bad "daynight: dark re-acquisition after forced day" "$R" ;;
            esac

            eval "$LIGHTS_ON_CMD" > /dev/null 2>&1
            R=$(printf '%s\n' "$DN_WAIT" | DN_SSH sh -s -- day 90)
            case "$R" in
            OK*) ok "daynight: lights restored, day again ($(echo "$R" | cut -d' ' -f2)s)" ;;
            *) bad "daynight: lights restored, day again" "$R" ;;
            esac
            DN_SSH "raptorctl ric set-threshold probe_recheck_sec 600" </dev/null > /dev/null 2>&1
            [ -n "$BENCH_RESTORE_CMD" ] && eval "$BENCH_RESTORE_CMD" > /dev/null 2>&1
        fi
    fi
}



# Legs that deliberately disturb the stream everything else
# depends on: always the last thing the suite does, in every
# mode, so nothing downstream measures the damage.
late_legs() {
# ── 11b. Wall-clock step (--clock-step, needs --ssh): NTP drags the
#        clock forward on every boot. RTP timestamps are a media clock
#        and must not follow it; RTCP SR NTP is wall clock and should.
#        Bounded and reverted, with ntpd stopped so it cannot fight
#        the step or undo it mid-measurement. ──
if [ "$CLOCKSTEP" = 1 ] && [ -n "$SSH_TARGET" ]; then
    STEP=120
    NTPD_WAS=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" 'pgrep -x ntpd >/dev/null && echo yes || echo no' 2>/dev/null)
    ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        '[ -x /etc/init.d/S49ntpd ] && /etc/init.d/S49ntpd stop >/dev/null 2>&1; killall ntpd 2>/dev/null; exit 0' >/dev/null 2>&1
    (
        sleep 6
        # Step forward, hold, step back: a bounded move keeps TLS
        # certs valid and leaves the device where it started.
        ssh -o ConnectTimeout=8 "$SSH_TARGET" "date -s \"@\$(( \$(date +%s) + $STEP ))\"" >/dev/null 2>&1
    ) &
    STEPPER=$!
    CS=$(timeout -k 5 60 python3 "$PROBES/clock_step.py" "$HOST" "$PORT" "$RPATH" \
        "${RTSP_USER:-}" "${RTSP_PASS:-}" 20 2>&1)
    wait $STEPPER 2>/dev/null
    # Re-anchor check, while the clock is still stepped: the mapping
    # stability asserted mid-session must not outlive the sessions it
    # protects. It needs the server genuinely idle -- earlier legs'
    # UDP sessions linger until the RTSP timeout reaps them, and any
    # live RTCP instance legitimately holds the anchor -- so wait for
    # the server's own client count to hit zero before dialing in.
    CS_REARM=""
    IDLE=no
    for _ in $(seq 30); do
        if ssh -o ConnectTimeout=8 "$SSH_TARGET" 'raptorctl rsd status 2>/dev/null' \
            | grep -q '"clients":0'; then IDLE=yes; break; fi
        sleep 3
    done
    # clients counts control connections; a timed-out UDP session can
    # hold its RTCP instance (and the anchor) a little past clients:0.
    # Sample up to three times so a lingering session gets reaped
    # before the verdict; a genuinely stale anchor fails all three.
    CS_TRIES=0
    while [ "$IDLE" = yes ] && [ $CS_TRIES -lt 3 ]; do
        CS_TRIES=$((CS_TRIES + 1))
        CS_REARM=$(python3 - "$HOST" "$PORT" "$RPATH" "${RTSP_USER:-}" "${RTSP_PASS:-}" <<'REARM_EOF'
import sys, time
sys.path.insert(0, "probes")
from rtsplib import RtspSession, parse_sr
host, port, path = sys.argv[1], int(sys.argv[2]), sys.argv[3]
user = sys.argv[4] or None
pw = sys.argv[5] or None
try:
    s = RtspSession(host, port, path, user=user, password=pw)
    s.describe(); s.setup("video", 0); s.play()
    for t, ch, pkt in s.packets(8.0):
        if ch == 1:
            sr = parse_sr(pkt)
            if sr:
                print(round(sr[0] - 2208988800 - time.time(), 1))
                break
    s.close()
except OSError:
    pass
REARM_EOF
)
        if [ -n "$CS_REARM" ] &&
            python3 -c "import sys; v=float('$CS_REARM'); sys.exit(0 if $STEP - 30 <= v <= $STEP + 30 else 1)"; then
            break
        fi
        [ $CS_TRIES -lt 3 ] && sleep 15
    done
    # Always put the clock back and restore ntpd, whatever happened.
    ssh -o ConnectTimeout=8 "$SSH_TARGET" "date -s \"@\$(( \$(date +%s) - $STEP ))\"" >/dev/null 2>&1
    # Restore through the init script: it knows the daemon's real
    # arguments (-S /etc/ntpd_callback and the configured servers).
    # Leaving a bench device without time sync is not an acceptable
    # side effect of a test, so this is verified, not assumed.
    if [ "$NTPD_WAS" = yes ]; then
        ssh -o ConnectTimeout=8 "$SSH_TARGET" \
            '[ -x /etc/init.d/S49ntpd ] && /etc/init.d/S49ntpd start >/dev/null 2>&1; exit 0' >/dev/null 2>&1
        if ssh -o ConnectTimeout=8 "$SSH_TARGET" 'pgrep -x ntpd >/dev/null' 2>/dev/null; then
            ok "wall-clock step: ntpd restored on the device"
        else
            bad "wall-clock step cleanup" "ntpd did not come back — device left without time sync"
        fi
    fi
    CSJ=$(echo "$CS" | sed -n 's/^SUMMARY //p')
    if [ -z "$CSJ" ]; then
        bad "wall-clock step" "probe produced no summary: $(echo "$CS" | tail -1)"
    else
        CS_FRAMES=$(echo "$CSJ" | python3 -c 'import sys,json; print(json.load(sys.stdin)["frames"])')
        CS_GAP=$(echo "$CSJ" | python3 -c 'import sys,json; print(json.load(sys.stdin)["max_rtp_gap_s"])')
        CS_SR=$(echo "$CSJ" | python3 -c 'import sys,json; print(json.load(sys.stdin)["sr_ntp_step_s"])')
        # A media clock must not inherit a wall-clock jump: the worst
        # RTP advance across the step should still look like frames,
        # not like two minutes.
        if python3 -c "import sys; sys.exit(0 if float('$CS_GAP') < 5 else 1)"; then
            ok "wall-clock step: RTP timeline unaffected (max gap ${CS_GAP}s over ${CS_FRAMES} frames)"
        else
            bad "wall-clock step: RTP timeline follows wall clock" \
                "max RTP gap ${CS_GAP}s after a ${STEP}s step — receivers see a discontinuity"
        fi
        # Two legitimate designs for the SR NTP field, and the check
        # names which one is in play rather than picking a winner.
        # RFC 3550 6.4.1 calls it wallclock time, which is what a
        # gettimeofday-based sender (live555) reports. compy derives it
        # from CLOCK_MONOTONIC plus a one-time offset on purpose (see
        # compy src/rtcp.c): that keeps the NTP<->RTP mapping stable
        # across a step, at the cost of an absolute time that no longer
        # tracks the clock. What would be broken either way is the RTP
        # timeline moving, and that is asserted above.
        if python3 -c "import sys; sys.exit(0 if float('$CS_SR') > $STEP / 2 else 1)"; then
            ok "wall-clock step: SR NTP tracked the clock, RFC3550 6.4.1 wallclock (${CS_SR}s)"
        elif python3 -c "import sys; sys.exit(0 if float('$CS_SR') < 5 else 1)"; then
            ok "wall-clock step: SR NTP<->RTP mapping held across the step (monotonic-derived, deviates from RFC3550 6.4.1 by design)"
        else
            bad "wall-clock step: SR NTP moved by ${CS_SR}s" \
                "neither wallclock-tracking (~${STEP}s) nor mapping-stable (~0s)"
        fi
        # A fresh session anchors on the current clock, so one reconnect
        # after a step carries correct wallclock (the boot-order case:
        # cameras that stream before NTP first syncs).
        if [ "$IDLE" != yes ]; then
            skip "wall-clock step: re-anchor check (server never went idle -- lingering sessions hold the anchor legitimately)"
        elif [ -z "$CS_REARM" ]; then
            bad "wall-clock step: re-anchor check" "fresh session produced no SR within 8s"
        elif python3 -c "import sys; v=float('$CS_REARM'); sys.exit(0 if $STEP - 30 <= v <= $STEP + 30 else 1)"; then
            ok "wall-clock step: fresh session re-anchored on the stepped clock (+${CS_REARM}s)"
        else
            bad "wall-clock step: fresh session did not re-anchor" \
                "SR offset ${CS_REARM}s vs the ${STEP}s step — anchor survived a session drop"
        fi
    fi
elif [ "$CLOCKSTEP" = 1 ]; then
    skip "wall-clock step (--ssh not given)"
fi

# ── 12. Producer restart (--producer-restart, needs --ssh): the ring
#       producer dies and comes back under a live consumer. Every
#       consumer has reconnect logic and nothing proves it end to end.
#       Runs last: it deliberately breaks the stream everything else
#       depends on. ──
if [ "$RESTART" = 1 ] && [ -n "$SSH_TARGET" ]; then
    PROD=rvd
    ssh -o ConnectTimeout=8 "$SSH_TARGET" "pidof rfs >/dev/null 2>&1" && PROD=rfs
    PRODBIN=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" "readlink /proc/\$(pidof $PROD | awk '{print \$1}')/exe" 2>/dev/null)
    if [ -z "$PRODBIN" ]; then
        skip "producer restart ($PROD not running)"
    else
        # Kill it under a live client, then bring it back the way it
        # was started, and require a fresh client to get real frames.
        timeout -k 5 30 "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" \
            -t 20 -c copy -f mp4 -y "$WORK/during_restart.mp4" >/dev/null 2>&1 &
        VICTIM=$!
        sleep 3
        ssh -o ConnectTimeout=8 "$SSH_TARGET" "killall $PROD 2>/dev/null; sleep 3; nohup $PRODBIN >/tmp/$PROD.log 2>&1 </dev/null & sleep 1" >/dev/null 2>&1
        # Wait for frames again, not merely for the process: a producer
        # that is up but not producing leaves every consumer idle.
        RESTART_OK=0
        for i in $(seq 40); do
            if ssh -o ConnectTimeout=8 "$SSH_TARGET" \
                "test -e /dev/shm/rss_ring_main" >/dev/null 2>&1; then
                RESTART_OK=1; break
            fi
            sleep 1
        done
        wait $VICTIM 2>/dev/null
        if [ "$RESTART_OK" = 1 ]; then
            ok "producer restart: $PROD came back and re-created its ring"
        else
            bad "producer restart" "$PROD ring never reappeared"
        fi
        # The real assertion: the consumer recovers. Not instantly --
        # the ring file exists the moment the producer maps it, but
        # frames come later and the consumer reconnects on its own
        # tick, so recovery is a bounded wait, and how long it took is
        # the interesting number.
        REC_T0=$(date +%s)
        REC_OK=0
        for i in $(seq 15); do
            if timeout -k 5 12 "$FFPROBE" -v error -rtsp_transport tcp \
                -show_entries stream=codec_name -of csv "$URL" 2>/dev/null | grep -q .; then
                REC_OK=1; break
            fi
            sleep 2
        done
        REC_EL=$(( $(date +%s) - REC_T0 ))
        if [ "$REC_OK" = 1 ]; then
            ok "consumer serves a new client after a producer restart (${REC_EL}s to recover)"
        else
            bad "consumer after producer restart" "no stream from $URL after ${REC_EL}s"
        fi
    fi
elif [ "$RESTART" = 1 ]; then
    skip "producer restart (--ssh not given)"
fi
}
bad() {
    echo "  FAIL  $1${2:+ — $2}"
    FAIL=$((FAIL + 1))
    FAILED_NAMES+=("$1")
    json_emit fail "$1" "${2:-}"
}

