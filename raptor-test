codec = sys.argv[1]
pkts, cur = [], None
for line in open(sys.argv[2]):
    line = line.strip()
    if line.startswith("codec_name="):
        # -show_streams rides along so --only subsets need no earlier
        # section to have detected the codec
        codec = line.split("=", 1)[1] or codec
