fi

# ── 8b. RHD HTTP endpoints: JPEG snapshot + MJPEG stream (--rhd) ──
if [ -n "$RHD_URL" ]; then
    RHD_OUT="$WORK" python3 "$PROBES/rhd_check.py" "$RHD_URL" \
        ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} >"$WORK/rhd.txt" 2>&1
    while IFS= read -r line; do
        case $line in
            OK\ *)   ok "${line#OK }" ;;
            FAIL\ *) bad "${line#FAIL }" ;;
        esac
    done <"$WORK/rhd.txt"
    # Decode what the probe captured: a snapshot must be a fully
    # decodable frame of sane size, and the MJPEG sample must decode
    # frame-by-frame with no errors.
    if [ -s "$WORK/snap.jpg" ]; then
        SNAPDIM=$("$FFPROBE" -v error -select_streams v -show_entries stream=width,height \
            -of csv=p=0 "$WORK/snap.jpg" 2>/dev/null)
        SW=${SNAPDIM%%,*}
        if [ -n "$SW" ] && [ "$SW" -ge 160 ] 2>/dev/null; then
            ok "RHD snapshot decodes ($SNAPDIM)"
        else
