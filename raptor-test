#!/bin/bash
# raptor-test -- standalone live-stream conformance suite for RTSP
# servers. Built for the Raptor Streaming System, works against any
# RTSP source (generic checks self-skip when a feature is absent).
#
# Exercises what unit tests cannot: real sessions over TCP AND UDP,
# multiple concurrent clients, join/leave churn, wire-level sequence
# continuity, A/V timestamp sanity, and signaling byte-accuracy.
# Every check exists because an ad-hoc test once missed the bug it
# now catches.
#
# Usage: raptor-test <rtsp-url> [options] -- run with --help for the
# full option list and exit codes.
#
# Requirements: ffmpeg+ffprobe (FFMPEG/FFPROBE env override), python3.
# mpv used if present. All log matching is case-insensitive; failing
# checks print the exact matched lines; logs persist on failure.
# Background clients are killed via their own process tree -- never
# kill only a timeout wrapper (orphaned ffmpeg streams forever).
set -u

# Run from a private copy: editing this file while a battery is live
# corrupts the running interpreter's parse (bash reads incrementally).
if [ -z "${RAPTOR_TEST_SELF:-}" ]; then
    RAPTOR_TEST_HOME="$(cd "$(dirname "$0")" && pwd)"
    export RAPTOR_TEST_HOME
    RAPTOR_TEST_SELF=$(mktemp "${TMPDIR:-/tmp}/raptor-test-run.XXXXXX")
    export RAPTOR_TEST_SELF
    cp "$0" "$RAPTOR_TEST_SELF"
    exec /bin/bash "$RAPTOR_TEST_SELF" "$@"
fi

usage() {
    cat <<'EOF'
usage: raptor-test <rtsp-url> [options]

Options:
  --sub <url>          second stream URL (concurrency mix; default: main url)
  --ssh <user@host>    enable device-side health checks (raptor bench)
  --user <u> --pass <p>  RTSP digest credentials (enables the auth battery)
  --duration <s>       base capture duration (default 12)
  --go2rtc <apiurl>    test through a go2rtc restream (e.g. http://host:1984)
  --frigate            record via a local dockerized Frigate, verify the clips
  --record-check <d>   verify the newest .mp4 in a directory (e.g. rmr output)
  --rhd <baseurl>      RHD HTTP checks: /snap, /mjpeg, /audio (https://host:8443)
  --srt <url>          SRT leg (srt://host:9000): MPEG-TS video+audio decode
  --tls <rtsps-url>    RTSPS/TLS leg (server needs [rtsp] tls=true)
  --rtmp <port>        listen for rsp's RTMP push on this port
  --webrtc <whip-url>  WebRTC leg via rwd WHIP (H264 stream; needs webrtc-venv)
  --gop <frames>       assert the measured GOP interval equals this value
  --fuzz               throw malformed RTSP at the server, assert it survives
  --cold               RHD cold-start snapshots (adds ~55s idle; needs --rhd)
  --producer-restart   restart the ring producer mid-stream, assert recovery
  --clock-step         step the camera clock mid-stream, assert the media
                       timeline survives it (needs --ssh)
                       (needs --ssh; disruptive, so it runs last)
  --json <file>        also write one JSON record per check (JSONL)
  --fps-tol <frac>     video fps tolerance vs nominal (default 0.15)
  --drift-ppm <n>      audio cadence drift ceiling in ppm (default 3000)
  --bitrate-tol <f>    video bitrate tolerance vs SDP b=AS (default 0.35)
  --srt-secs <n>       SRT capture window in seconds (default 30)
  --dur <n>            transport capture window in seconds; the A/V
                       analysis capture is twice this (default 30)
  --srt-passphrase <p> SRT AES passphrase; also tests wrong-key rejection
  --drift-secs <n>     audio drift capture seconds (default 30; longer = tighter)
  --core               fast core subset: signaling, transports, wire,
                       content, RFC/robustness; skips sessions,
                       concurrency, players and all legs (self-check)
  --soak <minutes>     endurance mode: repeated bounded captures with
                       device RSS/FD trending (needs --ssh for trends);
                       replaces the normal battery
  --keep-logs          keep the log directory even on success
  -h, --help           this text

Exit codes: 0 all checks passed (skips allowed), 1 at least one check
failed (names listed, logs kept), 2 usage error.
EOF
}
case "${1:-}" in
-h|--help) usage; exit 0 ;;
esac
[ $# -ge 1 ] || { echo "usage: raptor-test <rtsp-url> [options]   (--help for the full list)" >&2; exit 2; }
URL=$1
shift
case "$URL" in
rtsp://*) ;;
*) echo "error: first argument must be an rtsp:// URL (got: $URL)" >&2; exit 2 ;;
esac
SUB_URL=""
SSH_TARGET=""
DUR=30
KEEP=0
GO2RTC=""
FRIGATE=0
RECDIR=""
RTSP_USER=""
RTSP_PASS=""
RHD_URL=""
SRT_URL=""
TLS_URL=""
RTMP_PORT=""
WEBRTC_URL=""
GOP_EXPECT=""
SOAK_MIN=""
CORE=0
JSON_FILE=""
FUZZ=0
COLD=0
RESTART=0
CLOCKSTEP=0
FPS_TOL=0.15
DRIFT_PPM=3000
BITRATE_TOL=0.35
SRT_SECS=30
SRT_PASSPHRASE=""
DRIFT_SECS=30
while [ $# -gt 0 ]; do
    case "$1" in
    --sub) SUB_URL=$2; shift 2 ;;
    --ssh) SSH_TARGET=$2; shift 2 ;;
    --duration) DUR=$2; shift 2 ;;
    --go2rtc) GO2RTC=$2; shift 2 ;;
    --frigate) FRIGATE=1; shift ;;
    --record-check) RECDIR=$2; shift 2 ;;
    --gop) GOP_EXPECT=$2; shift 2 ;;
    --soak) SOAK_MIN=$2; shift 2 ;;
    --fuzz) FUZZ=1; shift ;;
    --cold) COLD=1; shift ;;
    --producer-restart) RESTART=1; shift ;;
    --clock-step) CLOCKSTEP=1; shift ;;
    --json) JSON_FILE=$2; shift 2 ;;
    --fps-tol) FPS_TOL=$2; shift 2 ;;
    --drift-ppm) DRIFT_PPM=$2; shift 2 ;;
    --bitrate-tol) BITRATE_TOL=$2; shift 2 ;;
    --srt-secs) SRT_SECS=$2; shift 2 ;;
    --dur) DUR=$2; shift 2 ;;
    --srt-passphrase) SRT_PASSPHRASE=$2; shift 2 ;;
    --drift-secs) DRIFT_SECS=$2; shift 2 ;;
    --core) CORE=1; shift ;;
    --keep-logs) KEEP=1; shift ;;
    --user) RTSP_USER=$2; shift 2 ;;
    --pass) RTSP_PASS=$2; shift 2 ;;
    --rhd) RHD_URL=$2; shift 2 ;;
    --srt) SRT_URL=$2; shift 2 ;;
    --tls) TLS_URL=$2; shift 2 ;;
    --rtmp) RTMP_PORT=$2; shift 2 ;;
    --webrtc) WEBRTC_URL=$2; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done
[ -n "$SUB_URL" ] || SUB_URL=$URL

HOSTPORT=${URL#rtsp://}
HOSTPORT=${HOSTPORT%%/*}
case "$HOSTPORT" in
*@*)
    USERINFO=${HOSTPORT%%@*}
    RTSP_USER=${RTSP_USER:-${USERINFO%%:*}}
    RTSP_PASS=${RTSP_PASS:-${USERINFO#*:}}
    HOSTPORT=${HOSTPORT##*@}
    ;;
esac
HOST=${HOSTPORT%%:*}
PORT=${HOSTPORT##*:}
[ "$PORT" = "$HOST" ] && PORT=554
RPATH=/${URL#rtsp://*/}

# With --user/--pass, client legs (ffmpeg/mpv/go2rtc/frigate) get the
# credentials in the URL; raw probes take them as arguments and speak
# digest themselves. HOST/PORT/RPATH always stay credential-free.
if [ -n "$RTSP_USER" ]; then
    case "$URL" in *@*) : ;; *) URL="rtsp://$RTSP_USER:$RTSP_PASS@${URL#rtsp://}" ;; esac
    case "$SUB_URL" in *@*) : ;; *) SUB_URL="rtsp://$RTSP_USER:$RTSP_PASS@${SUB_URL#rtsp://}" ;; esac
fi

DIR="${RAPTOR_TEST_HOME:-$(cd "$(dirname "$0")" && pwd)}"
PROBES="$DIR/probes"
# Client pinning: RTSP behavior shifts between ffmpeg majors (7.1
# streamcopy silently drops RTSP AAC audio; 8.x fixed it). Prefer the
# pinned build in tools/ (tools/fetch-tools.sh) over the system one;
# an explicit FFMPEG/FFPROBE env override still wins.
if [ -z "${FFMPEG:-}" ] && [ -x "$DIR/tools/ffmpeg" ]; then
    FFMPEG="$DIR/tools/ffmpeg"
    FFPROBE="$DIR/tools/ffprobe"
fi
FFMPEG=${FFMPEG:-ffmpeg}
FFPROBE=${FFPROBE:-ffprobe}
# Fail fast if a probe is missing or unimportable (a deleted helper
# module once surfaced as a mid-run traceback instead)
if ! python3 - "$PROBES" <<'EOF'
import pathlib, py_compile, sys
for p in sorted(pathlib.Path(sys.argv[1]).glob("*.py")):
    py_compile.compile(str(p), doraise=True)
sys.path.insert(0, sys.argv[1])
import rtsplib  # noqa: F401  (shared helper the probes import)
EOF
then
    echo "FATAL: probe scripts under $PROBES do not compile/import" >&2
    exit 2
fi

# Baseline established RTSP sessions before we generate any traffic
# (a deployed camera may have an NVR attached; that context changes
# how capacity rejections and the final connection count are judged).
EXTERNAL_SESSIONS=0
if [ -n "$SSH_TARGET" ]; then
    EXTERNAL_SESSIONS=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        "netstat -tn 2>/dev/null | grep ESTABLISHED | grep -c :$PORT" 2>/dev/null)
    EXTERNAL_SESSIONS=${EXTERNAL_SESSIONS:-0}
    [ "$EXTERNAL_SESSIONS" -gt 0 ] && \
        echo "    note: $EXTERNAL_SESSIONS pre-existing RTSP session(s) on the target"
    # Baselines for the post-suite health checks: device log position
    # (only lines emitted DURING the run are judged) and device-side
    # framesource drop counters ("losted buffers" in isp-fs).
    LOG_BASE=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" 'logread 2>/dev/null | wc -l' 2>/dev/null)
    DROP_BASE=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        'test -f /proc/jz/isp/isp-fs && grep -i "lost" /proc/jz/isp/isp-fs | awk "{s+=\$NF} END{print s+0}" || echo NA' 2>/dev/null)
fi
WORK="./raptor-test-logs/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$WORK"
PASS=0
FAIL=0
SKIP=0
declare -a FAILED_NAMES

# Error classes that mean broken media, matched case-insensitively.
# 'non monotonically increasing dts to muxer' is deliberately absent:
# -f null forces a 1/1000 timebase, so 30fps frames legally round to
# equal milliseconds and the muxer nags. True timestamp monotonicity
# is verified from a real capture in native timebases (section 4) and
# on the wire (RFC probe).
ERRPAT='missed|dropping|discontinuity|corrupt|concealing|invalid data|error while decoding'

json_emit() {  # status name detail
    [ -z "$JSON_FILE" ] && return
    local st=$1 nm=$2 dt=${3:-}
    nm=${nm//\\/\\\\}; nm=${nm//\"/\\\"}
    dt=${dt//\\/\\\\}; dt=${dt//\"/\\\"}
    printf '{"status":"%s","name":"%s","detail":"%s"}\n' "$st" "$nm" "$dt" >> "$JSON_FILE"
}
ok() { echo "  PASS  $1"; PASS=$((PASS + 1)); json_emit pass "$1"; }
skip() { echo "  SKIP  $1"; SKIP=$((SKIP + 1)); json_emit skip "$1"; }

print_result() {
    echo ""
    echo "=== RESULT: $PASS passed, $FAIL failed, $SKIP skipped ==="
    if [ "$FAIL" -gt 0 ]; then
        printf '  failed: %s\n' "${FAILED_NAMES[@]}"
        echo "  logs kept in: $WORK"
        exit 1
    fi
    [ "$KEEP" = 1 ] && echo "  logs kept in: $WORK"
    exit 0
}

# Legs that deliberately disturb the stream everything else
# depends on: always the last thing the suite does, in every
# mode, so nothing downstream measures the damage.
late_legs() {
# ── 11b. Wall-clock step (--clock-step, needs --ssh): NTP drags the
#        clock forward on every boot. RTP timestamps are a media clock
#        and must not follow it; RTCP SR NTP is wall clock and should.
#        Bounded and reverted, with ntpd stopped so it cannot fight
#        the step or undo it mid-measurement. ──
if [ "$CLOCKSTEP" = 1 ] && [ -n "$SSH_TARGET" ]; then
    STEP=120
    NTPD_WAS=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" 'pgrep -x ntpd >/dev/null && echo yes || echo no' 2>/dev/null)
    ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        '[ -x /etc/init.d/S49ntpd ] && /etc/init.d/S49ntpd stop >/dev/null 2>&1; killall ntpd 2>/dev/null; exit 0' >/dev/null 2>&1
    (
        sleep 6
        # Step forward, hold, step back: a bounded move keeps TLS
        # certs valid and leaves the device where it started.
        ssh -o ConnectTimeout=8 "$SSH_TARGET" "date -s \"@\$(( \$(date +%s) + $STEP ))\"" >/dev/null 2>&1
    ) &
    STEPPER=$!
    CS=$(timeout -k 5 60 python3 "$PROBES/clock_step.py" "$HOST" "$PORT" "$RPATH" \
        "${RTSP_USER:-}" "${RTSP_PASS:-}" 20 2>&1)
    wait $STEPPER 2>/dev/null
    # Always put the clock back and restore ntpd, whatever happened.
    ssh -o ConnectTimeout=8 "$SSH_TARGET" "date -s \"@\$(( \$(date +%s) - $STEP ))\"" >/dev/null 2>&1
    # Restore through the init script: it knows the daemon's real
    # arguments (-S /etc/ntpd_callback and the configured servers).
    # Leaving a bench device without time sync is not an acceptable
    # side effect of a test, so this is verified, not assumed.
    if [ "$NTPD_WAS" = yes ]; then
        ssh -o ConnectTimeout=8 "$SSH_TARGET" \
            '[ -x /etc/init.d/S49ntpd ] && /etc/init.d/S49ntpd start >/dev/null 2>&1; exit 0' >/dev/null 2>&1
        if ssh -o ConnectTimeout=8 "$SSH_TARGET" 'pgrep -x ntpd >/dev/null' 2>/dev/null; then
            ok "wall-clock step: ntpd restored on the device"
        else
            bad "wall-clock step cleanup" "ntpd did not come back — device left without time sync"
        fi
    fi
    CSJ=$(echo "$CS" | sed -n 's/^SUMMARY //p')
    if [ -z "$CSJ" ]; then
        bad "wall-clock step" "probe produced no summary: $(echo "$CS" | tail -1)"
    else
        CS_FRAMES=$(echo "$CSJ" | python3 -c 'import sys,json; print(json.load(sys.stdin)["frames"])')
        CS_GAP=$(echo "$CSJ" | python3 -c 'import sys,json; print(json.load(sys.stdin)["max_rtp_gap_s"])')
        CS_SR=$(echo "$CSJ" | python3 -c 'import sys,json; print(json.load(sys.stdin)["sr_ntp_step_s"])')
        # A media clock must not inherit a wall-clock jump: the worst
        # RTP advance across the step should still look like frames,
        # not like two minutes.
        if python3 -c "import sys; sys.exit(0 if float('$CS_GAP') < 5 else 1)"; then
            ok "wall-clock step: RTP timeline unaffected (max gap ${CS_GAP}s over ${CS_FRAMES} frames)"
        else
            bad "wall-clock step: RTP timeline follows wall clock" \
                "max RTP gap ${CS_GAP}s after a ${STEP}s step — receivers see a discontinuity"
        fi
        # Two legitimate designs for the SR NTP field, and the check
        # names which one is in play rather than picking a winner.
        # RFC 3550 6.4.1 calls it wallclock time, which is what a
        # gettimeofday-based sender (live555) reports. compy derives it
        # from CLOCK_MONOTONIC plus a one-time offset on purpose (see
        # compy src/rtcp.c): that keeps the NTP<->RTP mapping stable
        # across a step, at the cost of an absolute time that no longer
        # tracks the clock. What would be broken either way is the RTP
        # timeline moving, and that is asserted above.
        if python3 -c "import sys; sys.exit(0 if float('$CS_SR') > $STEP / 2 else 1)"; then
            ok "wall-clock step: SR NTP tracked the clock, RFC3550 6.4.1 wallclock (${CS_SR}s)"
        elif python3 -c "import sys; sys.exit(0 if float('$CS_SR') < 5 else 1)"; then
            ok "wall-clock step: SR NTP<->RTP mapping held across the step (monotonic-derived, deviates from RFC3550 6.4.1 by design)"
        else
            bad "wall-clock step: SR NTP moved by ${CS_SR}s" \
                "neither wallclock-tracking (~${STEP}s) nor mapping-stable (~0s)"
        fi
    fi
elif [ "$CLOCKSTEP" = 1 ]; then
    skip "wall-clock step (--ssh not given)"
fi

# ── 12. Producer restart (--producer-restart, needs --ssh): the ring
#       producer dies and comes back under a live consumer. Every
#       consumer has reconnect logic and nothing proves it end to end.
#       Runs last: it deliberately breaks the stream everything else
#       depends on. ──
if [ "$RESTART" = 1 ] && [ -n "$SSH_TARGET" ]; then
    PROD=rvd
    ssh -o ConnectTimeout=8 "$SSH_TARGET" "pidof rfs >/dev/null 2>&1" && PROD=rfs
    PRODBIN=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" "readlink /proc/\$(pidof $PROD | awk '{print \$1}')/exe" 2>/dev/null)
    if [ -z "$PRODBIN" ]; then
        skip "producer restart ($PROD not running)"
    else
        # Kill it under a live client, then bring it back the way it
        # was started, and require a fresh client to get real frames.
        timeout -k 5 30 "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" \
            -t 20 -c copy -f mp4 -y "$WORK/during_restart.mp4" >/dev/null 2>&1 &
        VICTIM=$!
        sleep 3
        ssh -o ConnectTimeout=8 "$SSH_TARGET" "killall $PROD 2>/dev/null; sleep 3; nohup $PRODBIN >/tmp/$PROD.log 2>&1 </dev/null & sleep 1" >/dev/null 2>&1
        # Wait for frames again, not merely for the process: a producer
        # that is up but not producing leaves every consumer idle.
        RESTART_OK=0
        for i in $(seq 40); do
            if ssh -o ConnectTimeout=8 "$SSH_TARGET" \
                "test -e /dev/shm/rss_ring_main" >/dev/null 2>&1; then
                RESTART_OK=1; break
            fi
            sleep 1
        done
        wait $VICTIM 2>/dev/null
        if [ "$RESTART_OK" = 1 ]; then
            ok "producer restart: $PROD came back and re-created its ring"
        else
            bad "producer restart" "$PROD ring never reappeared"
        fi
        # The real assertion: the consumer recovers. Not instantly --
        # the ring file exists the moment the producer maps it, but
        # frames come later and the consumer reconnects on its own
        # tick, so recovery is a bounded wait, and how long it took is
        # the interesting number.
        REC_T0=$(date +%s)
        REC_OK=0
        for i in $(seq 15); do
            if timeout -k 5 12 "$FFPROBE" -v error -rtsp_transport tcp \
                -show_entries stream=codec_name -of csv "$URL" 2>/dev/null | grep -q .; then
                REC_OK=1; break
            fi
            sleep 2
        done
        REC_EL=$(( $(date +%s) - REC_T0 ))
        if [ "$REC_OK" = 1 ]; then
            ok "consumer serves a new client after a producer restart (${REC_EL}s to recover)"
        else
            bad "consumer after producer restart" "no stream from $URL after ${REC_EL}s"
        fi
    fi
elif [ "$RESTART" = 1 ]; then
    skip "producer restart (--ssh not given)"
fi
}
bad() {
    echo "  FAIL  $1${2:+ — $2}"
    FAIL=$((FAIL + 1))
    FAILED_NAMES+=("$1")
    json_emit fail "$1" "${2:-}"
}

CLIENT_PIDS=""
FRIGATE_NAME=""
FRIGATE_DIR=""
cleanup() {
    for p in $CLIENT_PIDS; do
        # Kill the wrapper AND its children (pkill -P), then the wrapper.
        pkill -9 -P "$p" 2>/dev/null
        kill -9 "$p" 2>/dev/null
    done
    if [ -n "$FRIGATE_NAME" ]; then
        docker exec "$FRIGATE_NAME" sh -c 'rm -rf /media/frigate/recordings /media/frigate/clips' >/dev/null 2>&1
        docker rm -f "$FRIGATE_NAME" >/dev/null 2>&1
    fi
    [ -n "$FRIGATE_DIR" ] && rm -rf "$FRIGATE_DIR"
    [ "$KEEP" = 0 ] && [ "$FAIL" = 0 ] && rm -rf "$WORK"
    rm -f "${RAPTOR_TEST_SELF:-}"
}
trap cleanup EXIT

# show_errs <log> — print the matched error lines, indented.
show_errs() { grep -iE "$ERRPAT" "$1" | sort | uniq -c | sort -rn | head -3 | sed 's/^/          /'; }

# capture <name> <seconds> <url> [transport] — run a decoding client,
# fail if any error-class line appears.
capture() {
    local name=$1 secs=$2 url=$3 transport=${4:-}
    local targ=()
    [ -n "$transport" ] && targ=(-rtsp_transport "$transport")
    timeout -k 5 $((secs + 14)) "$FFMPEG" -nostdin -v warning "${targ[@]}" -i "$url" \
        -t "$secs" -progress "$WORK/$name.progress" -f null - >"$WORK/$name.log" 2>&1
    # zero error lines AND real decoded media: a client that exits 0
    # without ever producing output (bad URL, own help text) must FAIL
    if [ "${AUDIO_ONLY:-0}" = 1 ]; then
        local ot
        ot=$(sed -n 's/^out_time_us=//p' "$WORK/$name.progress" 2>/dev/null | tail -1)
        [ "$(grep -ciE "$ERRPAT" "$WORK/$name.log")" -eq 0 ] && [ "${ot:-0}" -gt 500000 ]
    else
        local frames
        frames=$(sed -n 's/^frame=//p' "$WORK/$name.progress" 2>/dev/null | tail -1)
        [ "$(grep -ciE "$ERRPAT" "$WORK/$name.log")" -eq 0 ] && [ "${frames:-0}" -gt 0 ]
    fi
}

echo "=== raptor-test: $URL ==="
echo "    client: $("$FFMPEG" -version 2>/dev/null | head -1 | grep -oE 'version [^ ]+' || echo unknown) ($FFMPEG)"
echo "    logs: $WORK"

# ── 1. Signaling (DESCRIBE) ──
SDP=$(python3 - "$PROBES" "$HOST" "$PORT" "$RPATH" "${RTSP_USER:-}" "${RTSP_PASS:-}" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
user = sys.argv[5] or None
s = RtspSession(sys.argv[2], sys.argv[3], sys.argv[4], user=user, password=sys.argv[6])
status, sdp = s.describe()
s.close()
print(status)
print(sdp)
EOF
)
echo "$SDP" >"$WORK/sdp.txt"
AUDIO_ONLY=0
if echo "$SDP" | grep -q 'm=video'; then
    ok "SDP: video track present"
elif echo "$SDP" | grep -q 'm=audio'; then
    AUDIO_ONLY=1
    ok "SDP: audio-only source (video checks self-skip)"
else
    bad "SDP: no media tracks advertised"
fi

# ── 1b. Auth battery (--user/--pass): the machinery must challenge,
# reject, accept, and enforce ──
if [ -n "$RTSP_USER" ]; then
    AUTHRPT=$(python3 - "$PROBES" "$HOST" "$PORT" "$RPATH" "$RTSP_USER" "$RTSP_PASS" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
host, port, path, user, pw = sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6]

def emit(ok, name, detail=""):
    print(("OK " if ok else "FAIL ") + name + (" -- " + detail if detail else ""))

s = RtspSession(host, port, path)  # no creds
st, _ = s.describe()
ch = s.last_challenge or {}
emit("401" in st and "realm" in ch and "nonce" in ch,
     "auth: unauthenticated DESCRIBE gets Digest challenge", st)
st2, _, _ = s.request("SETUP", s.url + "/video",
                      extra="Transport: RTP/AVP/TCP;unicast;interleaved=0-1\r\n")
emit("401" in st2, "auth: unauthenticated SETUP refused", st2)
s.close()

s = RtspSession(host, port, path, user=user, password="definitely-wrong")
st, _ = s.describe()
emit("401" in st, "auth: wrong password rejected", st)
s.close()

s = RtspSession(host, port, path, user=user, password=pw)
st, _ = s.describe()
emit("200" in st, "auth: correct digest accepted", st)
s.close()
EOF
)
    echo "$AUTHRPT" >"$WORK/auth.txt"
    while IFS= read -r line; do
        case $line in
            OK\ *)   ok "${line#OK }" ;;
            FAIL\ *) bad "${line#FAIL }" ;;
        esac
    done <<< "$AUTHRPT"
fi

CONFIG=$(echo "$SDP" | grep -o 'config=[0-9A-Fa-f]*' | head -1 | cut -d= -f2)
ACLK=$(echo "$SDP" | grep -oiE 'mpeg4-generic/[0-9]+' | head -1 | cut -d/ -f2)
if [ -n "$CONFIG" ] && [ -n "$ACLK" ]; then
    if python3 - "$CONFIG" "$ACLK" <<'EOF'
import sys
cfg, aclk = sys.argv[1], int(sys.argv[2])
rates = [96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350]
b = bytes.fromhex(cfg)
aot = b[0] >> 3
if len(b) == 2 and aot == 2:  # plain LC
    idx = ((b[0] & 0x7) << 1) | (b[1] >> 7)
    sys.exit(0 if rates[idx] == aclk else 1)
if len(b) == 5 and aot == 2:  # HE-AAC v1, backward-compatible explicit SBR
    core = ((b[0] & 0x7) << 1) | (b[1] >> 7)
    ext = (b[4] >> 3) & 0xF  # syncExtension extensionSamplingFrequencyIndex
    sys.exit(0 if (rates[core] == aclk // 2 and rates[ext] == aclk) else 1)
sys.exit(1)
EOF
    then ok "SDP: AAC config= consistent with clock ($CONFIG @ ${ACLK}Hz)"; else bad "SDP: AAC config= vs clock" "$CONFIG @ $ACLK"; fi
else
