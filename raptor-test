#!/bin/bash
# raptor-test -- standalone live-stream conformance suite for RTSP
# servers. Built for the Raptor Streaming System, works against any
# RTSP source (generic checks self-skip when a feature is absent).
#
# Exercises what unit tests cannot: real sessions over TCP AND UDP,
# multiple concurrent clients, join/leave churn, wire-level sequence
# continuity, A/V timestamp sanity, and signaling byte-accuracy.
# Every check exists because an ad-hoc test once missed the bug it
# now catches.
#
# Usage: raptor-test <rtsp-url> [options] -- run with --help for the
# full option list and exit codes.
#
# Requirements: ffmpeg+ffprobe (FFMPEG/FFPROBE env override), python3.
# mpv used if present. All log matching is case-insensitive; failing
# checks print the exact matched lines; logs persist on failure.
# Background clients are killed via their own process tree -- never
# kill only a timeout wrapper (orphaned ffmpeg streams forever).
set -u

# Run from a private copy: editing this file while a battery is live
# corrupts the running interpreter's parse (bash reads incrementally).
if [ -z "${RAPTOR_TEST_SELF:-}" ]; then
    RAPTOR_TEST_HOME="$(cd "$(dirname "$0")" && pwd)"
    export RAPTOR_TEST_HOME
    RAPTOR_TEST_SELF=$(mktemp "${TMPDIR:-/tmp}/raptor-test-run.XXXXXX")
    export RAPTOR_TEST_SELF
    cp "$0" "$RAPTOR_TEST_SELF"
    exec /bin/bash "$RAPTOR_TEST_SELF" "$@"
fi

usage() {
    cat <<'EOF'
usage: raptor-test <rtsp-url> [options]

Options:
  --sub <url>          second stream URL (concurrency mix; default: main url)
  --ssh <user@host>    enable device-side health checks (raptor bench)
  --user <u> --pass <p>  RTSP digest credentials (enables the auth battery)
  --duration <s>       base capture duration (default 12)
  --go2rtc <apiurl>    test through a go2rtc restream (e.g. http://host:1984)
  --frigate            record via a local dockerized Frigate, verify the clips
  --record-check <d>   verify the newest .mp4 in a directory (e.g. rmr output)
  --rhd <baseurl>      RHD HTTP checks: /snap, /mjpeg, /audio (https://host:8443)
  --srt <url>          SRT leg (srt://host:9000): MPEG-TS video+audio decode
  --tls <rtsps-url>    RTSPS/TLS leg (server needs [rtsp] tls=true)
  --rtmp <port>        listen for rsp's RTMP push on this port
  --webrtc <whip-url>  WebRTC leg via rwd WHIP (H264 stream; needs webrtc-venv)
  --gop <frames>       assert the measured GOP interval equals this value
  --fuzz               throw malformed RTSP at the server, assert it survives
  --json <file>        also write one JSON record per check (JSONL)
  --fps-tol <frac>     video fps tolerance vs nominal (default 0.15)
  --drift-ppm <n>      audio cadence drift ceiling in ppm (default 3000)
  --drift-secs <n>     audio drift capture seconds (default 30; longer = tighter)
  --core               fast core subset: signaling, transports, wire,
                       content, RFC/robustness; skips sessions,
                       concurrency, players and all legs (self-check)
  --soak <minutes>     endurance mode: repeated bounded captures with
                       device RSS/FD trending (needs --ssh for trends);
                       replaces the normal battery
  --keep-logs          keep the log directory even on success
  -h, --help           this text

Exit codes: 0 all checks passed (skips allowed), 1 at least one check
failed (names listed, logs kept), 2 usage error.
EOF
}
case "${1:-}" in
-h|--help) usage; exit 0 ;;
esac
[ $# -ge 1 ] || { echo "usage: raptor-test <rtsp-url> [options]   (--help for the full list)" >&2; exit 2; }
URL=$1
shift
case "$URL" in
rtsp://*) ;;
*) echo "error: first argument must be an rtsp:// URL (got: $URL)" >&2; exit 2 ;;
esac
SUB_URL=""
SSH_TARGET=""
DUR=12
KEEP=0
GO2RTC=""
FRIGATE=0
RECDIR=""
RTSP_USER=""
RTSP_PASS=""
RHD_URL=""
SRT_URL=""
TLS_URL=""
RTMP_PORT=""
WEBRTC_URL=""
GOP_EXPECT=""
SOAK_MIN=""
CORE=0
JSON_FILE=""
FUZZ=0
FPS_TOL=0.15
DRIFT_PPM=3000
DRIFT_SECS=30
while [ $# -gt 0 ]; do
    case "$1" in
    --sub) SUB_URL=$2; shift 2 ;;
    --ssh) SSH_TARGET=$2; shift 2 ;;
    --duration) DUR=$2; shift 2 ;;
    --go2rtc) GO2RTC=$2; shift 2 ;;
    --frigate) FRIGATE=1; shift ;;
    --record-check) RECDIR=$2; shift 2 ;;
    --gop) GOP_EXPECT=$2; shift 2 ;;
    --soak) SOAK_MIN=$2; shift 2 ;;
    --fuzz) FUZZ=1; shift ;;
    --json) JSON_FILE=$2; shift 2 ;;
    --fps-tol) FPS_TOL=$2; shift 2 ;;
    --drift-ppm) DRIFT_PPM=$2; shift 2 ;;
    --drift-secs) DRIFT_SECS=$2; shift 2 ;;
    --core) CORE=1; shift ;;
    --keep-logs) KEEP=1; shift ;;
    --user) RTSP_USER=$2; shift 2 ;;
    --pass) RTSP_PASS=$2; shift 2 ;;
    --rhd) RHD_URL=$2; shift 2 ;;
    --srt) SRT_URL=$2; shift 2 ;;
    --tls) TLS_URL=$2; shift 2 ;;
    --rtmp) RTMP_PORT=$2; shift 2 ;;
    --webrtc) WEBRTC_URL=$2; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
    esac
done
[ -n "$SUB_URL" ] || SUB_URL=$URL

HOSTPORT=${URL#rtsp://}
HOSTPORT=${HOSTPORT%%/*}
case "$HOSTPORT" in
*@*)
    USERINFO=${HOSTPORT%%@*}
    RTSP_USER=${RTSP_USER:-${USERINFO%%:*}}
    RTSP_PASS=${RTSP_PASS:-${USERINFO#*:}}
    HOSTPORT=${HOSTPORT##*@}
    ;;
esac
HOST=${HOSTPORT%%:*}
PORT=${HOSTPORT##*:}
[ "$PORT" = "$HOST" ] && PORT=554
RPATH=/${URL#rtsp://*/}

# With --user/--pass, client legs (ffmpeg/mpv/go2rtc/frigate) get the
# credentials in the URL; raw probes take them as arguments and speak
# digest themselves. HOST/PORT/RPATH always stay credential-free.
if [ -n "$RTSP_USER" ]; then
    case "$URL" in *@*) : ;; *) URL="rtsp://$RTSP_USER:$RTSP_PASS@${URL#rtsp://}" ;; esac
    case "$SUB_URL" in *@*) : ;; *) SUB_URL="rtsp://$RTSP_USER:$RTSP_PASS@${SUB_URL#rtsp://}" ;; esac
fi

DIR="${RAPTOR_TEST_HOME:-$(cd "$(dirname "$0")" && pwd)}"
PROBES="$DIR/probes"
# Client pinning: RTSP behavior shifts between ffmpeg majors (7.1
# streamcopy silently drops RTSP AAC audio; 8.x fixed it). Prefer the
# pinned build in tools/ (tools/fetch-tools.sh) over the system one;
# an explicit FFMPEG/FFPROBE env override still wins.
if [ -z "${FFMPEG:-}" ] && [ -x "$DIR/tools/ffmpeg" ]; then
    FFMPEG="$DIR/tools/ffmpeg"
    FFPROBE="$DIR/tools/ffprobe"
fi
FFMPEG=${FFMPEG:-ffmpeg}
FFPROBE=${FFPROBE:-ffprobe}
# Fail fast if a probe is missing or unimportable (a deleted helper
# module once surfaced as a mid-run traceback instead)
if ! python3 - "$PROBES" <<'EOF'
import pathlib, py_compile, sys
for p in sorted(pathlib.Path(sys.argv[1]).glob("*.py")):
    py_compile.compile(str(p), doraise=True)
sys.path.insert(0, sys.argv[1])
import rtsplib  # noqa: F401  (shared helper the probes import)
EOF
then
    echo "FATAL: probe scripts under $PROBES do not compile/import" >&2
    exit 2
fi

# Baseline established RTSP sessions before we generate any traffic
# (a deployed camera may have an NVR attached; that context changes
# how capacity rejections and the final connection count are judged).
EXTERNAL_SESSIONS=0
if [ -n "$SSH_TARGET" ]; then
    EXTERNAL_SESSIONS=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        "netstat -tn 2>/dev/null | grep ESTABLISHED | grep -c :$PORT" 2>/dev/null)
    EXTERNAL_SESSIONS=${EXTERNAL_SESSIONS:-0}
    [ "$EXTERNAL_SESSIONS" -gt 0 ] && \
        echo "    note: $EXTERNAL_SESSIONS pre-existing RTSP session(s) on the target"
    # Baselines for the post-suite health checks: device log position
    # (only lines emitted DURING the run are judged) and device-side
    # framesource drop counters ("losted buffers" in isp-fs).
    LOG_BASE=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" 'logread 2>/dev/null | wc -l' 2>/dev/null)
    DROP_BASE=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        'test -f /proc/jz/isp/isp-fs && grep -i "lost" /proc/jz/isp/isp-fs | awk "{s+=\$NF} END{print s+0}" || echo NA' 2>/dev/null)
fi
WORK="./raptor-test-logs/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$WORK"
PASS=0
FAIL=0
SKIP=0
declare -a FAILED_NAMES

# Error classes that mean broken media, matched case-insensitively.
# 'non monotonically increasing dts to muxer' is deliberately absent:
# -f null forces a 1/1000 timebase, so 30fps frames legally round to
# equal milliseconds and the muxer nags. True timestamp monotonicity
# is verified from a real capture in native timebases (section 4) and
# on the wire (RFC probe).
ERRPAT='missed|dropping|discontinuity|corrupt|concealing|invalid data|error while decoding'

json_emit() {  # status name detail
    [ -z "$JSON_FILE" ] && return
    local st=$1 nm=$2 dt=${3:-}
    nm=${nm//\\/\\\\}; nm=${nm//\"/\\\"}
    dt=${dt//\\/\\\\}; dt=${dt//\"/\\\"}
    printf '{"status":"%s","name":"%s","detail":"%s"}\n' "$st" "$nm" "$dt" >> "$JSON_FILE"
}
ok() { echo "  PASS  $1"; PASS=$((PASS + 1)); json_emit pass "$1"; }
skip() { echo "  SKIP  $1"; SKIP=$((SKIP + 1)); json_emit skip "$1"; }

print_result() {
    echo ""
    echo "=== RESULT: $PASS passed, $FAIL failed, $SKIP skipped ==="
    if [ "$FAIL" -gt 0 ]; then
        printf '  failed: %s\n' "${FAILED_NAMES[@]}"
        echo "  logs kept in: $WORK"
        exit 1
    fi
    [ "$KEEP" = 1 ] && echo "  logs kept in: $WORK"
    exit 0
}
bad() {
    echo "  FAIL  $1${2:+ — $2}"
    FAIL=$((FAIL + 1))
    FAILED_NAMES+=("$1")
    json_emit fail "$1" "${2:-}"
}

CLIENT_PIDS=""
FRIGATE_NAME=""
FRIGATE_DIR=""
cleanup() {
    for p in $CLIENT_PIDS; do
        # Kill the wrapper AND its children (pkill -P), then the wrapper.
        pkill -9 -P "$p" 2>/dev/null
        kill -9 "$p" 2>/dev/null
    done
    if [ -n "$FRIGATE_NAME" ]; then
        docker exec "$FRIGATE_NAME" sh -c 'rm -rf /media/frigate/recordings /media/frigate/clips' >/dev/null 2>&1
        docker rm -f "$FRIGATE_NAME" >/dev/null 2>&1
    fi
    [ -n "$FRIGATE_DIR" ] && rm -rf "$FRIGATE_DIR"
    [ "$KEEP" = 0 ] && [ "$FAIL" = 0 ] && rm -rf "$WORK"
    rm -f "${RAPTOR_TEST_SELF:-}"
}
trap cleanup EXIT

# show_errs <log> — print the matched error lines, indented.
show_errs() { grep -iE "$ERRPAT" "$1" | sort | uniq -c | sort -rn | head -3 | sed 's/^/          /'; }

# capture <name> <seconds> <url> [transport] — run a decoding client,
# fail if any error-class line appears.
capture() {
    local name=$1 secs=$2 url=$3 transport=${4:-}
    local targ=()
    [ -n "$transport" ] && targ=(-rtsp_transport "$transport")
    timeout -k 5 $((secs + 14)) "$FFMPEG" -nostdin -v warning "${targ[@]}" -i "$url" \
        -t "$secs" -progress "$WORK/$name.progress" -f null - >"$WORK/$name.log" 2>&1
    # zero error lines AND real decoded media: a client that exits 0
    # without ever producing output (bad URL, own help text) must FAIL
    if [ "${AUDIO_ONLY:-0}" = 1 ]; then
        local ot
        ot=$(sed -n 's/^out_time_us=//p' "$WORK/$name.progress" 2>/dev/null | tail -1)
        [ "$(grep -ciE "$ERRPAT" "$WORK/$name.log")" -eq 0 ] && [ "${ot:-0}" -gt 500000 ]
    else
        local frames
        frames=$(sed -n 's/^frame=//p' "$WORK/$name.progress" 2>/dev/null | tail -1)
        [ "$(grep -ciE "$ERRPAT" "$WORK/$name.log")" -eq 0 ] && [ "${frames:-0}" -gt 0 ]
    fi
}

echo "=== raptor-test: $URL ==="
echo "    client: $("$FFMPEG" -version 2>/dev/null | head -1 | grep -oE 'version [^ ]+' || echo unknown) ($FFMPEG)"
echo "    logs: $WORK"

# ── 1. Signaling (DESCRIBE) ──
SDP=$(python3 - "$PROBES" "$HOST" "$PORT" "$RPATH" "${RTSP_USER:-}" "${RTSP_PASS:-}" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
user = sys.argv[5] or None
s = RtspSession(sys.argv[2], sys.argv[3], sys.argv[4], user=user, password=sys.argv[6])
status, sdp = s.describe()
s.close()
print(status)
print(sdp)
EOF
)
echo "$SDP" >"$WORK/sdp.txt"
AUDIO_ONLY=0
if echo "$SDP" | grep -q 'm=video'; then
    ok "SDP: video track present"
elif echo "$SDP" | grep -q 'm=audio'; then
    AUDIO_ONLY=1
    ok "SDP: audio-only source (video checks self-skip)"
else
    bad "SDP: no media tracks advertised"
fi

# ── 1b. Auth battery (--user/--pass): the machinery must challenge,
# reject, accept, and enforce ──
if [ -n "$RTSP_USER" ]; then
    AUTHRPT=$(python3 - "$PROBES" "$HOST" "$PORT" "$RPATH" "$RTSP_USER" "$RTSP_PASS" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
host, port, path, user, pw = sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6]

def emit(ok, name, detail=""):
    print(("OK " if ok else "FAIL ") + name + (" -- " + detail if detail else ""))

s = RtspSession(host, port, path)  # no creds
st, _ = s.describe()
ch = s.last_challenge or {}
emit("401" in st and "realm" in ch and "nonce" in ch,
     "auth: unauthenticated DESCRIBE gets Digest challenge", st)
st2, _, _ = s.request("SETUP", s.url + "/video",
                      extra="Transport: RTP/AVP/TCP;unicast;interleaved=0-1\r\n")
emit("401" in st2, "auth: unauthenticated SETUP refused", st2)
s.close()

s = RtspSession(host, port, path, user=user, password="definitely-wrong")
st, _ = s.describe()
emit("401" in st, "auth: wrong password rejected", st)
s.close()

s = RtspSession(host, port, path, user=user, password=pw)
st, _ = s.describe()
emit("200" in st, "auth: correct digest accepted", st)
s.close()
EOF
)
    echo "$AUTHRPT" >"$WORK/auth.txt"
    while IFS= read -r line; do
        case $line in
            OK\ *)   ok "${line#OK }" ;;
            FAIL\ *) bad "${line#FAIL }" ;;
        esac
    done <<< "$AUTHRPT"
fi

CONFIG=$(echo "$SDP" | grep -o 'config=[0-9A-Fa-f]*' | head -1 | cut -d= -f2)
ACLK=$(echo "$SDP" | grep -oiE 'mpeg4-generic/[0-9]+' | head -1 | cut -d/ -f2)
if [ -n "$CONFIG" ] && [ -n "$ACLK" ]; then
    if python3 - "$CONFIG" "$ACLK" <<'EOF'
import sys
cfg, aclk = sys.argv[1], int(sys.argv[2])
rates = [96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350]
b = bytes.fromhex(cfg)
aot = b[0] >> 3
if len(b) == 2 and aot == 2:  # plain LC
    idx = ((b[0] & 0x7) << 1) | (b[1] >> 7)
    sys.exit(0 if rates[idx] == aclk else 1)
if len(b) == 5 and aot == 2:  # HE-AAC v1, backward-compatible explicit SBR
    core = ((b[0] & 0x7) << 1) | (b[1] >> 7)
    ext = (b[4] >> 3) & 0xF  # syncExtension extensionSamplingFrequencyIndex
    sys.exit(0 if (rates[core] == aclk // 2 and rates[ext] == aclk) else 1)
sys.exit(1)
EOF
    then ok "SDP: AAC config= consistent with clock ($CONFIG @ ${ACLK}Hz)"; else bad "SDP: AAC config= vs clock" "$CONFIG @ $ACLK"; fi
else
    skip "SDP AAC checks (no mpeg4-generic audio advertised)"
fi

# ── 1b. Soak mode (--soak): endurance instead of the battery ──
if [ -n "$SOAK_MIN" ]; then
    DEADLINE=$(( $(date +%s) + SOAK_MIN * 60 ))
    CYCLE=0
    SOAK_FAILS=0
    rss_of() { ssh -o ConnectTimeout=6 "$SSH_TARGET" "awk '/VmRSS/{print \$2}' /proc/\$(pidof $1)/status 2>/dev/null" 2>/dev/null; }
    fds_of() { ssh -o ConnectTimeout=6 "$SSH_TARGET" "ls /proc/\$(pidof $1)/fd 2>/dev/null | wc -l" 2>/dev/null; }
    if [ -n "$SSH_TARGET" ]; then
        RVD_RSS0=$(rss_of rvd); RSD_RSS0=$(rss_of rsd)
        RVD_FD0=$(fds_of rvd);  RSD_FD0=$(fds_of rsd)
        echo "    soak baseline: rvd rss=${RVD_RSS0:-?}kB fd=${RVD_FD0:-?} | rsd rss=${RSD_RSS0:-?}kB fd=${RSD_FD0:-?}"
    fi
    while [ "$(date +%s)" -lt "$DEADLINE" ]; do
        CYCLE=$((CYCLE + 1))
        T=$([ $((CYCLE % 2)) -eq 0 ] && echo "" || echo tcp)
        if capture "soak_$CYCLE" 30 "$URL" $T; then
            :
        else
            SOAK_FAILS=$((SOAK_FAILS + 1))
            echo "    cycle $CYCLE (${T:-udp}): capture FAILED"
        fi
        rm -f "$WORK/soak_$CYCLE".*
    done
    if [ "$SOAK_FAILS" -eq 0 ]; then
        ok "soak: $CYCLE bounded captures clean over ${SOAK_MIN}m"
    else
        bad "soak captures" "$SOAK_FAILS of $CYCLE cycles failed"
    fi
    if [ -n "$SSH_TARGET" ]; then
        RVD_RSS1=$(rss_of rvd); RSD_RSS1=$(rss_of rsd)
        RVD_FD1=$(fds_of rvd);  RSD_FD1=$(fds_of rsd)
        echo "    soak end: rvd rss=${RVD_RSS1:-?}kB fd=${RVD_FD1:-?} | rsd rss=${RSD_RSS1:-?}kB fd=${RSD_FD1:-?}"
        for d in RVD RSD; do
            R0=$(eval echo \$${d}_RSS0); R1=$(eval echo \$${d}_RSS1)
            F0=$(eval echo \$${d}_FD0);  F1=$(eval echo \$${d}_FD1)
            if [ -n "$R0" ] && [ -n "$R1" ] && [ "$R0" -gt 0 ] 2>/dev/null; then
                if [ $((R1 * 100)) -le $((R0 * 125)) ]; then
                    ok "soak: $d RSS stable (${R0}kB -> ${R1}kB)"
                else
                    bad "soak $d RSS growth" "${R0}kB -> ${R1}kB (>25%)"
                fi
            else
                skip "soak $d RSS trend (daemon not found)"
            fi
            if [ -n "$F0" ] && [ -n "$F1" ] && [ "$F1" -le $((F0 + 3)) ] 2>/dev/null; then
                ok "soak: $d FDs stable ($F0 -> $F1)"
            elif [ -n "$F0" ] && [ -n "$F1" ]; then
                bad "soak $d FD growth" "$F0 -> $F1"
            else
                skip "soak $d FD trend (daemon not found)"
            fi
        done
    else
        skip "soak device trends (--ssh not given)"
    fi
    print_result
fi

# ── 2. Transport matrix ──
if capture tcp_main "$DUR" "$URL" tcp; then ok "TCP: clean media (${DUR}s)"; else bad "TCP: clean media" "see below"; show_errs "$WORK/tcp_main.log"; fi
if capture udp_main "$DUR" "$URL"; then ok "UDP: clean media (${DUR}s)"; else bad "UDP: clean media" "see below"; show_errs "$WORK/udp_main.log"; fi
if [ "$SUB_URL" != "$URL" ]; then
    if capture udp_sub "$DUR" "$SUB_URL"; then ok "UDP sub-stream: clean media"; else bad "UDP sub-stream" "see below"; show_errs "$WORK/udp_sub.log"; fi
fi

# ── 3. Wire-level RTP continuity (raw TCP-interleaved probe) ──
python3 "$PROBES/seq_gap.py" "$HOST" "$PORT" "$RPATH" 15 ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} >"$WORK/seqgap.txt" 2>&1
GAPRPT=$(head -1 "$WORK/seqgap.txt")
TSRPT=$(sed -n 2p "$WORK/seqgap.txt")
if echo "$GAPRPT" | grep -qE 'seq-lost=0.*seq-lost=0'; then
    ok "RTP sequence continuity, both tracks (15s)"
elif echo "$GAPRPT" | grep -qE 'seq-lost=0'; then
    ok "RTP sequence continuity, video (no audio track)"
else
    bad "RTP sequence continuity" "$GAPRPT"
fi
# Wire timestamps: never backward, no single-packet spikes; audio must
# hold one exact cadence (a bang-banging steering loop splits the modal
# share across cadence±nudge and file muxers drop packets around it)
if [ -n "$TSRPT" ]; then
    # A video-only stream prints no audio backward=/spikes= fields
    # ("too few"), so require the token once per MEASURED track --
    # a loose single-token match would vacuously pass broken audio.
    TSNEED=2
    echo "$TSRPT" | grep -q '(too few)' && TSNEED=1
    if [ "$(echo "$TSRPT" | grep -oE 'backward=0' | wc -l)" -ge "$TSNEED" ]; then
        ok "RTP timestamps never step backward (wire)"
    else
        bad "RTP timestamps step backward on the wire" "$TSRPT"
    fi
    if [ "$(echo "$TSRPT" | grep -oE 'spikes=0' | wc -l)" -ge "$TSNEED" ]; then
        ok "no RTP timestamp spikes (wire)"
    else
        bad "RTP timestamp spike on the wire" "$TSRPT"
    fi
    # One-sided nudging tracks a genuinely off-rate source clock and is
    # fine; balanced two-sided nudging is a steering loop oscillating.
    A_STATS=$(echo "$TSRPT" | grep -oE 'audio ts-steps.*$')
    A_UP=$(echo "$A_STATS" | grep -oE 'up=[0-9]+' | grep -oE '[0-9]+')
    A_DOWN=$(echo "$A_STATS" | grep -oE 'down=[0-9]+' | grep -oE '[0-9]+')
    if [ -z "$A_UP" ]; then
        skip "audio wire cadence (no audio track)"
    else
        A_MINOR=$((A_UP < A_DOWN ? A_UP : A_DOWN))
        A_TOTAL=$((A_UP + A_DOWN))
        if [ "$A_TOTAL" -gt 20 ] && [ $((A_MINOR * 100 / A_TOTAL)) -ge 25 ]; then
            bad "audio RTP cadence oscillates (bang-bang steering)" "$A_STATS"
        else
            ok "audio RTP cadence steady ($A_STATS)"
        fi
    fi
fi
# UDP consumers need MTU-sized packets: bigger ones IP-fragment, so
# one lost fragment loses the whole packet (interleaved sizes mirror
# the same packetizer)
MAXRTP=$(echo "$GAPRPT" | grep -oE 'max-rtp=[0-9]+' | grep -oE '[0-9]+')
if [ -n "$MAXRTP" ]; then
    if [ "$MAXRTP" -le 1472 ]; then
        ok "RTP packets MTU-safe (max $MAXRTP bytes)"
    else
        bad "RTP packets exceed Ethernet MTU (IP-fragment on UDP)" "max $MAXRTP bytes"
    fi
fi

# ── 3b. Session lifecycle: silent-client reaping, transport re-SETUP ──
if [ "$CORE" = 1 ]; then
    skip "session lifecycle (core mode)"
else
SESSRPT=$(timeout 40 python3 "$PROBES/session_probe.py" switch "$HOST" "$PORT" "$RPATH" ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} 2>&1)
echo "$SESSRPT" >"$WORK/switch.txt"
while IFS= read -r line; do
    case $line in
        OK\ *)   ok "${line#OK }" ;;
        FAIL\ *) bad "${line#FAIL }" ;;
        SKIP\ *) skip "${line#SKIP }" ;;
    esac
done <<< "$SESSRPT"
REAPRPT=$(timeout 110 python3 "$PROBES/session_probe.py" reap "$HOST" "$PORT" "$RPATH" ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} 2>&1)
echo "$REAPRPT" >"$WORK/reap.txt"
while IFS= read -r line; do
    case $line in
        OK\ *)   ok "${line#OK }" ;;
        FAIL\ *) bad "${line#FAIL }" ;;
        SKIP\ *) skip "${line#SKIP }" ;;
    esac
done <<< "$REAPRPT"
fi

# ── 4. A/V timestamps in a real capture ──
# -copyinkf: ffmpeg's streamcopy waits for a key-flagged packet per
# stream, but its RTP AAC depacketizer never sets one (AAC is not
# intra-only to ffmpeg), so without it EVERY rtsp aac copy capture is
# silently audio-less — from any server, go2rtc included.
timeout -k 5 $((DUR * 2 + 20)) "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" \
    -c copy -copyinkf -t $((DUR * 2)) -y "$WORK/ts.mkv" 2>/dev/null
# Document the plain-copy behavior for NVR operators: no verdict on the
# server, but recorders using this ffmpeg without -copyinkf lose audio.
if grep -q "m=audio" "$WORK/sdp.txt" 2>/dev/null; then
    timeout -k 3 16 "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" \
        -c copy -t 6 -y "$WORK/plaincopy.mkv" 2>/dev/null
    PCA=$("$FFPROBE" -v error -select_streams a -show_entries packet=pts -of csv=p=0 "$WORK/plaincopy.mkv" 2>/dev/null | grep -c .)
    if [ "$PCA" -gt 0 ]; then
        ok "plain ffmpeg -c copy records audio ($PCA pkts/6s)"
    else
        skip "plain -c copy drops AAC audio (this ffmpeg never key-flags RTP AAC; recorders need -copyinkf or transcode)"
    fi
    rm -f "$WORK/plaincopy.mkv"
fi
VP=$("$FFPROBE" -v error -select_streams v -show_entries packet=pts_time -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | grep -vE 'N/A|^$' >"$WORK/v.pts"; wc -l <"$WORK/v.pts")
AP=$("$FFPROBE" -v error -select_streams a -show_entries packet=pts_time -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | grep -vE 'N/A|^$' >"$WORK/a.pts"; wc -l <"$WORK/a.pts")
if [ "$VP" -gt 30 ]; then
    TSRES=$(python3 - "$WORK/v.pts" "$WORK/a.pts" <<'EOF'
import sys
v = [float(x) for x in open(sys.argv[1])]
a = [float(x) for x in open(sys.argv[2])] if len(open(sys.argv[2]).read()) else []
mono_v = all(y >= x for x, y in zip(v, v[1:]))
if not a:
    print(f"video-only mono={mono_v} v={len(v)}")
    sys.exit(0 if mono_v else 1)
mono_a = all(y >= x for x, y in zip(a, a[1:]))
end_off = (a[-1] - v[-1]) * 1000
print(f"end_offset={end_off:+.0f}ms mono_v={mono_v} mono_a={mono_a} v={len(v)} a={len(a)}")
sys.exit(0 if (mono_v and mono_a and abs(end_off) < 500) else 1)
EOF
)
    if [ $? -eq 0 ]; then ok "A/V capture timestamps ($TSRES)"; else bad "A/V capture timestamps" "$TSRES"; fi
elif [ "$AUDIO_ONLY" = 1 ]; then
    skip "A/V capture timestamps (audio-only source)"
else
    bad "A/V capture timestamps" "capture produced only $VP video packets"
fi

# ── 4b. Audio cadence/drift (dedicated longer capture) ──
# Drift needs a long lever arm: a device's audio sample clock can
# wander hundreds of ppm over ~10s (measured on a T31 16k path), so a
# 12s window swings by thousands regardless of estimator and only a
# ~30s+ capture resolves the true rate. Take a dedicated audio-only
# capture rather than reusing the 12s A/V one.
if [ -n "$CONFIG" ] && [ "$AP" -gt 50 ]; then
    FS=1024
    [ ${#CONFIG} -ge 10 ] && FS=2048  # 5-byte BC-form ASC = HE-AAC, 2048/frame
    timeout -k 5 "$((DRIFT_SECS + 14))" "$FFMPEG" -nostdin -v quiet \
        -rtsp_transport tcp -i "$URL" -map 0:a -c copy -copyinkf \
        -t "$DRIFT_SECS" -f mp4 "$WORK/adrift.mp4" 2>/dev/null
    "$FFPROBE" -v error -select_streams a -show_entries packet=pts_time \
        -of csv=p=0 "$WORK/adrift.mp4" 2>/dev/null | grep -vE 'N/A|^$' >"$WORK/adrift.pts"
    DRIFT=$(python3 - "$WORK/adrift.pts" "$FS" "$ACLK" "$DRIFT_PPM" <<'EOF'
import sys
a = [float(x) for x in open(sys.argv[1])]
fr = int(sys.argv[2]) / int(sys.argv[3])
ceil = float(sys.argv[4])
n = len(a)
# Least-squares slope of pts vs packet index gives the true packet
# interval. The endpoint method ((last-first)/count) is dominated by
# per-packet network/capture jitter over a short window — a couple ms
# on the two endpoints swings it thousands of ppm — so regress instead.
mx = (n - 1) / 2.0
my = sum(a) / n
num = sum((i - mx) * (t - my) for i, t in enumerate(a))
den = sum((i - mx) ** 2 for i in range(n))
slope = num / den if den else fr
ppm = (slope / fr - 1) * 1e6
print(f"{ppm:+.0f}ppm over {a[-1]-a[0]:.0f}s ({n} pkts, lsq), ceil {ceil:.0f}")
sys.exit(0 if abs(ppm) < ceil else 1)
EOF
)
    if [ $? -eq 0 ]; then ok "audio cadence vs nominal ($DRIFT)"; else bad "audio cadence drift" "$DRIFT"; fi
else
    skip "audio drift (no AAC or too few audio packets)"
fi

# ── 4c. Decoded-content validation ──
if [ "$VP" -gt 30 ]; then
    VMETA=$("$FFPROBE" -v error -select_streams v -show_entries stream=width,height,r_frame_rate -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | head -1)
    W=$(echo "$VMETA" | cut -d, -f1)
    H=$(echo "$VMETA" | cut -d, -f2)
    NOMFPS=$(echo "$VMETA" | cut -d, -f3)
    FPSRES=$(python3 - "$WORK/v.pts" "$NOMFPS" "$FPS_TOL" <<'EOF'
import sys
v = [float(x) for x in open(sys.argv[1])]
num, den = (sys.argv[2].split("/") + ["1"])[:2]
nom = float(num) / float(den or 1)
tol = float(sys.argv[3])
meas = (len(v) - 1) / (v[-1] - v[0])
print(f"measured {meas:.2f}fps vs nominal {nom:.2f} (tol {tol:.0%})")
sys.exit(0 if nom > 0 and abs(meas - nom) / nom < tol else 1)
EOF
)
    if [ $? -eq 0 ]; then ok "video frame rate ($FPSRES)"; else bad "video frame rate" "$FPSRES"; fi
    if [ "${W:-0}" -ge 160 ] && [ "${H:-0}" -ge 120 ]; then
        ok "video resolution sane (${W}x${H})"
    else
        bad "video resolution" "${W}x${H}"
    fi
fi
if [ "$AP" -gt 30 ]; then
    ARATE=$("$FFPROBE" -v error -select_streams a -show_entries stream=sample_rate,channels -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | head -1)
    AR=$(echo "$ARATE" | cut -d, -f1)
    ACH=$(echo "$ARATE" | cut -d, -f2)
    ABYTES=$(timeout 60 "$FFMPEG" -nostdin -v quiet -i "$WORK/ts.mkv" -map a -f s16le - 2>/dev/null | wc -c)
    SAMPRES=$(python3 - "$WORK/a.pts" "$ABYTES" "${AR:-0}" "${ACH:-1}" <<'EOF'
import sys
a = [float(x) for x in open(sys.argv[1])]
span = a[-1] - a[0]
got = int(sys.argv[2]) // (2 * int(sys.argv[4]))
want = int(sys.argv[3]) * span
print(f"decoded {got} samples vs {want:.0f} expected over {span:.0f}s")
sys.exit(0 if want > 0 and abs(got - want) / want < 0.1 else 1)
EOF
)
    if [ $? -eq 0 ]; then ok "audio decodes at declared rate ($SAMPRES)"; else bad "audio decoded sample count" "$SAMPRES"; fi
fi

# Raw elementary stream: GOP cadence + per-frame SEI presence
VCODEC=$("$FFPROBE" -v error -select_streams v -show_entries stream=codec_name -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | head -1)
case "$VCODEC" in
h264) RAWFMT=h264 CEN=h264 ;;
hevc) RAWFMT=hevc CEN=h265 ;;
*) RAWFMT="" ;;
esac
if [ -n "$RAWFMT" ]; then
    timeout -k 5 24 "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" -map 0:v -c copy -t 15 -f "$RAWFMT" -y "$WORK/raw.es" 2>/dev/null
    CENSUS=$(python3 "$PROBES/nal_census.py" "$WORK/raw.es" "$CEN")
    echo "$CENSUS" >"$WORK/census.txt"
    IDRN=$(echo "$CENSUS" | grep -o 'idr=[0-9]*' | cut -d= -f2)
    VCLN=$(echo "$CENSUS" | grep -o 'vcl=[0-9]*' | cut -d= -f2)
    SEIN=$(echo "$CENSUS" | grep -o 'sei=[0-9]*' | cut -d= -f2)
    if [ "${IDRN:-0}" -ge 2 ]; then
        ok "GOP cadence: $IDRN keyframes in 15s ($CENSUS)"
    else
        bad "GOP cadence" "$CENSUS — a joiner may wait forever for a keyframe"
    fi
    if [ "${SEIN:-0}" -ge $((VCLN * 9 / 10)) ] && [ "${VCLN:-0}" -gt 0 ]; then
        ok "per-frame SEI present (${SEIN}/${VCLN} frames)"
    elif [ "${SEIN:-0}" -eq 0 ]; then
        skip "per-frame SEI (none in stream — raptor sei_timecode off or non-raptor server)"
    else
        bad "per-frame SEI coverage" "$SEIN of $VCLN frames"
    fi
    # GOP adherence: keyframes must be strictly periodic (a drifting
    # or elastic GOP breaks recorder segmenting and joiner latency);
    # with --gop the modal interval must equal the configured value.
    GOPI=$(echo "$CENSUS" | grep -o 'gopint=[0-9]*' | cut -d= -f2)
    GOPD=$(echo "$CENSUS" | grep -o 'gopdev=[0-9]*' | cut -d= -f2)
    GOPN=$(echo "$CENSUS" | grep -o 'gopn=[0-9]*' | cut -d= -f2)
    if [ "${GOPN:-0}" -ge 2 ]; then
        if [ "${GOPD:-99}" -le 1 ]; then
            ok "GOP interval regular (${GOPI} frames, maxdev ${GOPD}, ${GOPN} intervals)"
        else
            bad "GOP interval regularity" "modal=${GOPI} maxdev=${GOPD} over ${GOPN} intervals"
        fi
        if [ -n "$GOP_EXPECT" ]; then
            if [ "${GOPI:-0}" -eq "$GOP_EXPECT" ]; then
                ok "GOP interval matches configured ($GOP_EXPECT frames)"
            else
                bad "GOP interval vs configured" "measured ${GOPI}, configured $GOP_EXPECT"
            fi
        fi
    else
        skip "GOP interval regularity (fewer than 3 keyframes in the window)"
    fi
fi

# ── 4d. RFC conformance (RFC 2326 / 4566 / 3550 / 3640) ──
python3 "$PROBES/rfc_check.py" "$HOST" "$PORT" "$RPATH" 8 ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} >"$WORK/rfc.txt" 2>&1
while IFS= read -r line; do
    case "$line" in
    OK\ *) ok "${line#OK }" ;;
    FAIL\ *) bad "${line#FAIL }" ;;
    esac
done <"$WORK/rfc.txt"

# ── 4e. RTSP parser fuzzing (--fuzz): malformed input, liveness-checked ──
if [ "$FUZZ" = 1 ]; then
    FZ=$(timeout -k 5 100 python3 "$PROBES/fuzz_rtsp.py" "$HOST" "$PORT" 300 \
        "${RTSP_USER:-}" "${RTSP_PASS:-}" 80 2>&1)
    echo "$FZ" | grep -q '^OK ' && ok "$(echo "$FZ" | sed -n 's/^OK //p')" \
        || bad "RTSP fuzzing" "$(echo "$FZ" | sed -n 's/^FAIL //p' | head -1)"
else
    skip "RTSP parser fuzzing (--fuzz not given)"
fi

if [ "$CORE" = 1 ]; then
    skip "concurrency/players/legs (core mode)"
    print_result
fi

# ── 5a. Concurrency ladder: 2 -> 3 -> 4 simultaneous clients ──
# concurrent_check <label> <url> <n> <secs>: n clients (alternating
# TCP/UDP) run together; every one of them must come back clean.
concurrent_check() {
    local label=$1 curl=$2 n=$3 secs=$4
    local pids=() i
    for i in $(seq 1 "$n"); do
        local targ=()
        [ $((i % 2)) -eq 1 ] && targ=(-rtsp_transport tcp)
        timeout -k 5 $((secs + 14)) "$FFMPEG" -nostdin -v warning "${targ[@]}" -i "$curl"             -t "$secs" -f null - >"$WORK/conc_${label}_$i.log" 2>&1 &
        pids+=($!)
        CLIENT_PIDS="$CLIENT_PIDS $!"
    done
    for i in "${pids[@]}"; do wait "$i" 2>/dev/null; done
    local total=0 c rejected=0 streamed=0 missed=0 m
    for i in $(seq 1 "$n"); do
        if grep -qiE "Error opening input" "$WORK/conc_${label}_$i.log"; then
            rejected=$((rejected + 1))
            continue
        fi
        streamed=$((streamed + 1))
        # single-digit UDP loss is radio weather (see storm check)
        m=$(grep -ioE 'missed [0-9]+ packets' "$WORK/conc_${label}_$i.log" |
            grep -oE '[0-9]+' | awk '{s+=$1} END {print s+0}')
        missed=$((missed + m))
        c=$(grep -civE 'missed [0-9]+ packets' \
            <(grep -iE "$ERRPAT" "$WORK/conc_${label}_$i.log"))
        total=$((total + c))
    done
    if [ "$missed" -gt 0 ] && [ "$missed" -le 5 ] && [ "$total" -eq 0 ]; then
        echo "          note: $missed UDP packet(s) lost across $streamed clients (wireless-grade)"
    elif [ "$missed" -gt 5 ]; then
        total=$((total + missed))
    fi
    if [ "$total" -eq 0 ] && [ "$rejected" -eq 0 ]; then
        ok "$n concurrent clients on $label: all clean (${secs}s)"
    elif [ "$total" -eq 0 ] && [ "$streamed" -gt 0 ] && [ "${EXTERNAL_SESSIONS:-0}" -gt 0 ]; then
        # Server at its max_clients cap with pre-existing external
        # viewers: clean refusal + clean media for admitted clients is
        # correct behavior, not a stream defect.
        skip "$n clients on $label: $rejected refused at capacity ($EXTERNAL_SESSIONS external viewers), $streamed admitted all clean"
    else
        bad "$n concurrent clients on $label" "$rejected refused, $total error lines"
        cat "$WORK"/conc_"${label}"_*.log | grep -iE "$ERRPAT" | sort | uniq -c | sort -rn | head -3 | sed 's/^/          /'
    fi
}
for N in 2 3 4; do
    concurrent_check main "$URL" "$N" 10
done
if [ "$SUB_URL" != "$URL" ]; then
    concurrent_check sub "$SUB_URL" 2 10
    concurrent_check sub "$SUB_URL" 4 10
fi

# ── 5b. Concurrency: sustained UDP client vs join/leave churn ──
timeout -k 5 44 "$FFMPEG" -nostdin -v warning -i "$URL" -t 36 -f null - >"$WORK/sustained.log" 2>&1 &
APID=$!
CLIENT_PIDS="$CLIENT_PIDS $APID"
sleep 6
for joiner in "tcp $URL" "udp $URL" "udp $SUB_URL"; do
    set -- $joiner
    T=$1
    JURL=$2
    TARG=()
    [ "$T" = tcp ] && TARG=(-rtsp_transport tcp)
    timeout -k 3 10 "$FFMPEG" -nostdin -v quiet "${TARG[@]}" -i "$JURL" -t 7 -f null - >/dev/null 2>&1 &
    CLIENT_PIDS="$CLIENT_PIDS $!"
    sleep 9
done
wait $APID 2>/dev/null
if [ "$(grep -ciE "$ERRPAT" "$WORK/sustained.log")" -eq 0 ]; then
    ok "sustained UDP client clean across 3 join/leave cycles (36s)"
else
    bad "sustained client during joins" "see below"
    show_errs "$WORK/sustained.log"
fi

# ── 6. Regression: repeated default-transport probe sessions, then media ──
for i in 1 2 3; do
    timeout -k 3 12 "$FFPROBE" -v quiet -show_streams "$URL" >/dev/null 2>&1
done
if capture udp_after_probes "$DUR" "$URL"; then
    ok "UDP clean after 3x ffprobe (UDP dual-SETUP) sessions"
else
    # The fd-crosswiring regression this guards against loses THOUSANDS
    # of packets and decodes garbage; single-digit UDP loss on a
    # wireless link is radio weather, not that bug.
    STORM_MISSED=$(grep -ioE 'missed [0-9]+ packets' "$WORK/udp_after_probes.log" |
        grep -oE '[0-9]+' | awk '{s+=$1} END {print s+0}')
    STORM_OTHER=$(grep -icvE 'missed [0-9]+ packets|Last message repeated' \
        <(grep -iE "$ERRPAT" "$WORK/udp_after_probes.log"))
    if [ "${STORM_MISSED:-0}" -le 5 ] && [ "${STORM_OTHER:-0}" -le 2 ]; then
        ok "UDP after probe storm: minor wireless loss only ($STORM_MISSED pkts)"
    else
        bad "UDP after probe storm" "missed=$STORM_MISSED other=$STORM_OTHER"
        show_errs "$WORK/udp_after_probes.log"
    fi
fi

# ── 6b. Abrupt-kill client: RST mid-stream must not wound the server ──
timeout -k 3 20 "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" -f null - >/dev/null 2>&1 &
KPID=$!
CLIENT_PIDS="$CLIENT_PIDS $KPID"
sleep 4
pkill -9 -P "$KPID" 2>/dev/null
kill -9 "$KPID" 2>/dev/null
sleep 2
if capture after_kill 8 "$URL" tcp; then
    ok "clean media after an abruptly killed client"
else
    bad "media after abrupt client kill" "see below"
    show_errs "$WORK/after_kill.log"
fi

# ── 7. Device health (raptor bench, --ssh) ──
if [ -n "$SSH_TARGET" ]; then
    sleep 3
    RSDLINE=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" 'top -bn1' 2>/dev/null | grep -E '[r]sd -c' | head -1)
    # busybox top: PID PPID USER STAT VSZ %VSZ CPU %CPU COMMAND
    CPU=$(echo "$RSDLINE" | awk '{print $8}' | cut -d. -f1)
    if [ -n "$CPU" ] && [ "$CPU" -ge 0 ] 2>/dev/null && [ "$CPU" -lt 20 ]; then
        ok "rsd CPU sane post-suite (${CPU}%)"
    else
        bad "rsd CPU post-suite" "${RSDLINE:-no rsd process found}"
    fi
    # Compare against the baseline taken before any suite traffic:
    # external viewers (an NVR watching a deployed camera) are not
    # leaks, growth over the run is.
    NCONN=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" "netstat -tn 2>/dev/null | grep ESTABLISHED | grep -c :$PORT" 2>/dev/null)
    if [ "${NCONN:-1}" -le "${EXTERNAL_SESSIONS:-0}" ]; then
        ok "no leaked TCP connections (baseline $EXTERNAL_SESSIONS external, now ${NCONN:-0})"
    else
        bad "leaked TCP connections" "baseline ${EXTERNAL_SESSIONS:-0}, now ${NCONN:-?}"
    fi
    # Daemon log lines emitted during the run must be error-clean.
    # WARN-level noise from our own abuse checks (bogus paths, garbage
    # transports) is expected; ERROR-level lines and crashes are not.
    if [ -n "${LOG_BASE:-}" ]; then
        LOG_NOW=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" 'logread 2>/dev/null | wc -l' 2>/dev/null)
        if [ -n "$LOG_NOW" ] && [ "$LOG_NOW" -ge "$LOG_BASE" ]; then
            NEWLOG=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
                "logread 2>/dev/null | tail -n +$((LOG_BASE + 1))" 2>/dev/null \
                | grep -E '(rvd|rsd|rad|rod|ric|rhd|rwd|rsp|rsr|rmr)(\[|:| )')
            DLINES=$(echo "$NEWLOG" | grep -c .)
            DERRS=$(echo "$NEWLOG" | grep -ciE 'daemon\.err|\[ERROR\]|segfault|assert|oops|fatal')
            if [ "${DERRS:-0}" -eq 0 ]; then
                ok "device daemon logs error-free during run ($DLINES lines)"
            else
                bad "device daemon log errors during run" "$DERRS error line(s)"
                echo "$NEWLOG" | grep -iE 'daemon\.err|\[ERROR\]|segfault|assert|oops|fatal' \
                    | head -3 | sed 's/^/          /'
            fi
        else
            skip "device log sweep (log ring wrapped during run)"
        fi
    fi
    # Device-side framesource drops: the "losted buffers" counters
    # must not grow while the suite streams.
    if [ -n "${DROP_BASE:-}" ] && [ "$DROP_BASE" != "NA" ]; then
        DROP_NOW=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
            'test -f /proc/jz/isp/isp-fs && grep -i "lost" /proc/jz/isp/isp-fs | awk "{s+=\$NF} END{print s+0}" || echo NA' 2>/dev/null)
        if [ -z "$DROP_NOW" ] || [ "$DROP_NOW" = "NA" ]; then
            skip "device frame-drop counters (isp-fs unreadable post-run)"
        elif [ "$((DROP_NOW - DROP_BASE))" -eq 0 ]; then
            ok "no device-side dropped frames (losted counters flat at $DROP_NOW)"
        else
            bad "device-side dropped frames" "losted counters $DROP_BASE -> $DROP_NOW"
        fi
    elif [ -n "${DROP_BASE:-}" ]; then
        skip "device frame-drop counters (no isp-fs node on this SoC)"
    fi
    # IPv6 leg: dual-stack listeners have had v4/v6 path differences;
    # production NVRs commonly attach over v6.
    V6=$(ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        "ip -6 addr show scope global 2>/dev/null | grep -oE 'inet6 [0-9a-f:]+' | head -1 | cut -d' ' -f2" 2>/dev/null)
    if [ -n "$V6" ]; then
        V6CRED=""
        [ -n "$RTSP_USER" ] && V6CRED="$RTSP_USER:$RTSP_PASS@"
        if capture ipv6_tcp "$DUR" "rtsp://${V6CRED}[$V6]:$PORT$RPATH" tcp; then
            ok "IPv6: clean media over TCP ([$V6])"
        else
            bad "IPv6 media" "see $WORK/ipv6_tcp.log"
            show_errs "$WORK/ipv6_tcp.log"
        fi
    else
        skip "IPv6 leg (no global v6 address on target)"
    fi
else
    skip "device health (--ssh not given)"
fi

# ── 8. mpv: real player over both transports ──
mpv_check() {
    local name=$1 turl=$2
    shift 2
    # Hard timeout: --length=10 relies on playback progressing, but a
    # stalled decoder (e.g. a backend mislabeling its audio) leaves mpv
    # spinning forever. A wrapper timeout keeps one bad player from
    # wedging the whole suite.
    timeout -k 5 25 mpv --no-config --vo=null --ao=null "$@" --length=10 \
        "$turl" >"$WORK/$name.log" 2>&1
    local errs
    errs=$(tr '\r' '\n' <"$WORK/$name.log" | grep -ciE "$ERRPAT")
    local av opened
    av=$(tr '\r' '\n' <"$WORK/$name.log" | grep -oE 'A-V: *-?[0-9.]+' | tail -1 | grep -oE '[-0-9.]+$')
    local openpat='^ *\(\+\) Video|^VO: '
    [ "${AUDIO_ONLY:-0}" = 1 ] && openpat='^ *\(\+\) Audio|^AO: '
    opened=$(tr '\r' '\n' <"$WORK/$name.log" | grep -cE "$openpat")
    if [ "$errs" -eq 0 ] && [ "$opened" -eq 0 ]; then
        bad "$name" "no video track opened (vacuous run)"
    elif [ "$errs" -gt 0 ]; then
        bad "$name" "see below"
        tr '\r' '\n' <"$WORK/$name.log" | grep -iE "$ERRPAT" | sort | uniq -c | sort -rn | head -3 | sed 's/^/          /'
    elif [ -n "$av" ] && ! python3 -c "import sys; sys.exit(0 if abs(float('$av')) < 0.1 else 1)"; then
        bad "$name" "A-V=${av}"
    else
        ok "$name (A-V=${av:-n/a})"
    fi
}
if command -v mpv >/dev/null 2>&1; then
    mpv_check "mpv TCP playback" "$URL" --rtsp-transport=tcp
    mpv_check "mpv UDP playback" "$URL" --rtsp-transport=udp
else
    skip "mpv (not installed)"
fi

# ── 8c. openRTSP: the live555 client stack (VLC's RTSP lineage) ──
# ffmpeg and mpv share libav's RTSP; live555 negotiates and consumes
# sessions differently, so it exercises server paths they cannot.
ORTSP="$DIR/tools/openRTSP"
if [ "$AUDIO_ONLY" = 1 ]; then
    skip "openRTSP dump (audio-only source)"
elif [ -x "$ORTSP" ]; then
    ODIR="$WORK/ortsp"
    mkdir -p "$ODIR"
    (cd "$ODIR" && timeout -k 5 25 "$ORTSP" -t -d 8 -V -F s "$URL") \
        >"$WORK/ortsp.log" 2>&1
    OVID=$(find "$ODIR" -name 'svideo-*' -size +50k | head -1)
    OERR=$(grep -ciE "fail|error|unable" "$WORK/ortsp.log")
    if [ -n "$OVID" ] && [ "$OERR" -eq 0 ]; then
        # The dumped elementary stream must decode
        OCODEC=h264
        case "$OVID" in *H265*) OCODEC=hevc ;; esac
        "$FFMPEG" -nostdin -v error -f "$OCODEC" -i "$OVID" -frames:v 30 -f null - \
            >"$WORK/ortsp_decode.log" 2>&1
        if [ "$(grep -ciE "$ERRPAT" "$WORK/ortsp_decode.log")" -eq 0 ]; then
            ok "openRTSP (live555 client): session + dumped video decodes ($(basename "$OVID"))"
        else
            bad "openRTSP dumped video decode" "see $WORK/ortsp_decode.log"
            show_errs "$WORK/ortsp_decode.log"
        fi
    else
        bad "openRTSP (live555 client)" "video dump missing/small or $OERR error lines"
        tail -3 "$WORK/ortsp.log" | sed 's/^/          /'
    fi
else
    skip "openRTSP (tools/openRTSP not built)"
fi

# clip_verify <name> <file> — a recorded clip must have sane streams,
# matching durations, and decode with zero errors.
clip_verify() {
    local name=$1 f=$2
    local slug
    slug=$(echo "$name" | tr -c 'A-Za-z0-9._-' '_')
    if [ ! -s "$f" ]; then
        bad "$name" "no file"
        return
    fi
    local info vdur adur
    info=$("$FFPROBE" -v error -show_entries stream=codec_type,duration -of csv=p=0 "$f" 2>/dev/null)
    vdur=$(echo "$info" | grep '^video' | cut -d, -f2 | cut -d. -f1)
    adur=$(echo "$info" | grep '^audio' | cut -d, -f2 | cut -d. -f1)
    "$FFMPEG" -nostdin -v error -i "$f" -f null - >"$WORK/$slug.decode.log" 2>&1
    local derr
    # The null muxer re-times to 1/1000 and nags about colliding dts
    # (wallclock-stamped recorders collide for real under bursty WiFi
    # arrival); drop the nag AND its "Last message repeated" tails.
    derr=$(grep -viE 'non monotonically increasing dts to muxer|Last message repeated' \
        "$WORK/$slug.decode.log" | grep -c .)
    # File-level timestamp truth instead: dts must never move backward.
    local vback
    vback=$("$FFPROBE" -v error -select_streams v -show_entries packet=dts -of csv=p=0 "$f" 2>/dev/null |
        awk 'NR>1 && $1+0 < prev+0 {n++} {prev=$1} END {print n+0}')
    if [ -z "$vdur" ]; then
        bad "$name" "no video stream"
    elif [ "${derr:-1}" -gt 0 ]; then
        bad "$name" "decode errors, see $WORK/$slug.decode.log"
    elif [ "${vback:-0}" -gt 0 ]; then
        bad "$name" "video dts moves backward $vback times in the file"
    elif [ -n "$adur" ] && { [ $((vdur - adur)) -gt 1 ] || [ $((adur - vdur)) -gt 1 ]; }; then
        bad "$name" "duration mismatch v=${vdur}s a=${adur}s"
    else
        ok "$name (v=${vdur}s a=${adur:-none}s, decode clean)"
    fi
}

# ── 8b. RHD HTTP endpoints: JPEG snapshot + MJPEG stream (--rhd) ──
if [ -n "$RHD_URL" ]; then
    RHD_OUT="$WORK" python3 "$PROBES/rhd_check.py" "$RHD_URL" \
        ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} >"$WORK/rhd.txt" 2>&1
    while IFS= read -r line; do
        case $line in
            OK\ *)   ok "${line#OK }" ;;
            FAIL\ *) bad "${line#FAIL }" ;;
        esac
    done <"$WORK/rhd.txt"
    # Decode what the probe captured: a snapshot must be a fully
    # decodable frame of sane size, and the MJPEG sample must decode
    # frame-by-frame with no errors.
    if [ -s "$WORK/snap.jpg" ]; then
        SNAPDIM=$("$FFPROBE" -v error -select_streams v -show_entries stream=width,height \
            -of csv=p=0 "$WORK/snap.jpg" 2>/dev/null)
        SW=${SNAPDIM%%,*}
        if [ -n "$SW" ] && [ "$SW" -ge 160 ] 2>/dev/null; then
            ok "RHD snapshot decodes ($SNAPDIM)"
        else
            bad "RHD snapshot decode" "ffprobe found no valid image (${SNAPDIM:-none})"
        fi
    fi
    if [ -s "$WORK/mjpeg.bin" ]; then
        "$FFMPEG" -nostdin -v error -f mjpeg -i "$WORK/mjpeg.bin" -frames:v 8 -f null - \
            >"$WORK/mjpeg_decode.log" 2>&1
        if [ "$(grep -ciE "$ERRPAT" "$WORK/mjpeg_decode.log")" -eq 0 ]; then
            ok "RHD MJPEG frames decode clean"
        else
            bad "RHD MJPEG decode" "see $WORK/mjpeg_decode.log"
            show_errs "$WORK/mjpeg_decode.log"
        fi
    fi
    # The HTTP audio stream (ADTS/Ogg) must decode to real PCM
    if [ -s "$WORK/rhd_audio.bin" ]; then
        RHDA=$("$FFMPEG" -nostdin -v error -i "$WORK/rhd_audio.bin" -f s16le - \
            2>"$WORK/rhd_audio_decode.log" | wc -c)
        if [ "${RHDA:-0}" -gt 10000 ] && \
           [ "$(grep -ciE "$ERRPAT|exceeds" "$WORK/rhd_audio_decode.log")" -eq 0 ]; then
            ok "RHD /audio decodes to PCM ($RHDA bytes)"
        else
            bad "RHD /audio decode" "${RHDA:-0} PCM bytes, see $WORK/rhd_audio_decode.log"
            show_errs "$WORK/rhd_audio_decode.log"
        fi
    fi
fi

# ── 8d. ONVIF backchannel: client -> server audio (auto-detected) ──
# rsd advertises an a=sendonly audio section when [rtsp] backchannel
# is enabled; the probe DESCRIBEs with the ONVIF Require header and,
# if the track is there, pushes real RTP audio at the server.
timeout -k 3 40 python3 "$PROBES/backchannel.py" "$HOST" "$PORT" "$RPATH" \
    "${RTSP_USER:-}" "${RTSP_PASS:-}" >"$WORK/backchannel.txt" 2>"$WORK/backchannel.err" &
BCPID=$!
# The probe holds the session ~2.5s after BC_SENT; the speaker ring
# exists only DURING the session (destroyed at teardown), so check
# device evidence in that window.
BCRING="unchecked"
if [ -n "$SSH_TARGET" ]; then
    for i in $(seq 1 60); do
        grep -q 'BC_SENT=' "$WORK/backchannel.txt" 2>/dev/null && break
        kill -0 $BCPID 2>/dev/null || break
        sleep 0.5
    done
    if grep -q 'BC_SENT=' "$WORK/backchannel.txt" 2>/dev/null; then
        ssh -o ConnectTimeout=5 "$SSH_TARGET" 'test -e /dev/shm/rss_ring_speaker' 2>/dev/null \
            && BCRING="yes" || BCRING="no"
    fi
fi
wait $BCPID 2>/dev/null
BCOUT=$(cat "$WORK/backchannel.txt")
if ! echo "$BCOUT" | grep -q 'BC_DESCRIBE=200'; then
    skip "backchannel (DESCRIBE with ONVIF Require not accepted)"
elif ! echo "$BCOUT" | grep -q 'BC_SENDONLY=yes'; then
    skip "backchannel (no sendonly track — [rtsp] backchannel off or non-raptor server)"
else
    BCCODEC=$(echo "$BCOUT" | grep -o 'BC_CODEC=.*' | cut -d= -f2)
    ok "backchannel advertised (sendonly track, $BCCODEC)"
    BCSENT=$(echo "$BCOUT" | grep -o 'BC_SENT=[0-9]*' | cut -d= -f2)
    BCALIVE=$(echo "$BCOUT" | grep -o 'BC_ALIVE=.*' | cut -d= -f2)
    if [ "${BCSENT:-0}" -ge 30 ] && [ "$BCALIVE" = "yes" ]; then
        ok "backchannel accepts client audio ($BCSENT RTP frames, session healthy after)"
    else
        bad "backchannel audio send" "sent=${BCSENT:-0} alive=${BCALIVE:-none} (see backchannel.txt)"
    fi
    if [ "$BCRING" = "yes" ]; then
        ok "speaker ring live on device during backchannel session"
    elif [ "$BCRING" = "no" ]; then
        bad "speaker ring on device" "missing mid-session (audio not landing)"
    fi
fi

# ── 8e. MJPEG over RTSP: the /jpeg endpoint (auto-detected) ──
# Ring names (jpeg0/jpeg1) are not URL paths: rsd default endpoints
# for the jpeg streams are /jpeg and /jpeg_sub.
JURL="${URL%"$RPATH"}/jpeg"
JSTAT=$(python3 - "$PROBES" "$HOST" "$PORT" "/jpeg" "${RTSP_USER:-}" "${RTSP_PASS:-}" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
user = sys.argv[5] or None
try:
    s = RtspSession(sys.argv[2], sys.argv[3], sys.argv[4], user=user, password=sys.argv[6])
    status, _ = s.describe()
    print(status.split(" ")[1] if len(status.split(" ")) > 1 else "none")
    s.close()
except Exception:
    print("none")
EOF
)
if [ "$JSTAT" != "200" ]; then
    skip "MJPEG over RTSP (/jpeg not served — [rtsp] jpeg off or non-raptor server)"
else
    if capture jpeg0 8 "$JURL" tcp; then
        JCODEC=$("$FFPROBE" -v error -rtsp_transport tcp -select_streams v \
            -show_entries stream=codec_name -of csv=p=0 "$JURL" 2>/dev/null | head -1)
        if [ "$JCODEC" = "mjpeg" ]; then
            ok "MJPEG over RTSP: /jpeg decodes clean (codec=mjpeg)"
        else
            bad "MJPEG over RTSP codec" "expected mjpeg, ffprobe says '${JCODEC:-none}'"
        fi
    else
        bad "MJPEG over RTSP" "see below"
        show_errs "$WORK/jpeg0.log"
    fi
fi

# ── 9. go2rtc restream (--go2rtc) ──
if [ -n "$GO2RTC" ]; then
    G2NAME="raptortest$$"
    ENC_URL=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$URL")
    if curl -s -m 8 -X PUT "$GO2RTC/api/streams?name=$G2NAME&src=$ENC_URL" >/dev/null 2>&1; then
        G2HOST=${GO2RTC#http://}
        G2HOST=${G2HOST%%:*}
        # go2rtc's RTSP output port is configurable; ask the API
        # instead of assuming the default 8554.
        G2RPORT=$(curl -s -m 6 "$GO2RTC/api" 2>/dev/null \
            | python3 -c "import json,sys; print(json.load(sys.stdin).get('rtsp',{}).get('listen',':8554').rsplit(':',1)[-1])" 2>/dev/null)
        G2RPORT=${G2RPORT:-8554}
        G2URL="rtsp://$G2HOST:$G2RPORT/$G2NAME"
        sleep 2
        if timeout -k 5 $((DUR + 14)) "$FFMPEG" -nostdin -v warning -rtsp_transport tcp -i "$G2URL" -t "$DUR" -f null - >"$WORK/go2rtc.log" 2>&1             && [ "$(grep -ciE "$ERRPAT" "$WORK/go2rtc.log")" -eq 0 ]; then
            ok "go2rtc restream: clean media (${DUR}s)"
        else
            bad "go2rtc restream" "see below"
            show_errs "$WORK/go2rtc.log"
        fi
        # Authenticated SUBSTREAM through go2rtc (regression: raptor
        # issue #6 — go2rtc reuses digest nonces across producer
        # connections; stateful-nonce servers reject the second
        # stream while the first works).
        if [ -n "$RTSP_USER" ] && [ "$SUB_URL" != "$URL" ]; then
            G2SUB="rtauthsub$$"
            SUBSRC=$(python3 - "$SUB_URL" "$RTSP_USER" "$RTSP_PASS" <<'EOF'
import sys, urllib.parse
u, user, pw = sys.argv[1], sys.argv[2], sys.argv[3]
if "@" not in u.split("://", 1)[1].split("/", 1)[0]:
    scheme, rest = u.split("://", 1)
    u = f"{scheme}://{urllib.parse.quote(user, safe='')}:{urllib.parse.quote(pw, safe='')}@{rest}"
print(urllib.parse.quote(u, safe=""))
EOF
)
            if curl -s -m 8 -X PUT "$GO2RTC/api/streams?name=$G2SUB&src=$SUBSRC" >/dev/null 2>&1; then
                timeout -k 3 14 curl -s -m 12 "$GO2RTC/api/stream.mp4?src=$G2SUB" -o "$WORK/g2sub.mp4" 2>/dev/null
                G2SZ=$(stat -c%s "$WORK/g2sub.mp4" 2>/dev/null || echo 0)
                if [ "${G2SZ:-0}" -gt 10000 ]; then
                    ok "go2rtc: authenticated substream flows (${G2SZ}B mp4)"
                else
                    bad "go2rtc authenticated substream" "only ${G2SZ:-0}B (digest nonce-reuse regression? see issue #6)"
                fi
                curl -s -m 6 -X DELETE "$GO2RTC/api/streams?name=$G2SUB" >/dev/null 2>&1
            else
                skip "go2rtc authenticated substream (stream registration failed)"
            fi
        else
            skip "go2rtc authenticated substream (needs --user and a distinct --sub)"
        fi
        if [ -n "$CONFIG" ]; then
            G2SDP=$(python3 - "$G2HOST" "$G2RPORT" "/$G2NAME" <<'EOF'
import socket, sys
host, port, path = sys.argv[1], int(sys.argv[2]), sys.argv[3]
s = socket.create_connection((host, port), timeout=5)
s.sendall(f"DESCRIBE rtsp://{host}:{port}{path} RTSP/1.0\r\nCSeq: 1\r\nAccept: application/sdp\r\n\r\n".encode())
buf = b""
import time
t0 = time.time()
while time.time() - t0 < 6 and len(buf) < 16384:
    try:
        d = s.recv(4096)
    except socket.timeout:
        break
    if not d:
        break
    buf += d
print(buf.decode(errors="replace"))
EOF
)
            if echo "$G2SDP" | grep -qi "config=$CONFIG"; then
                ok "go2rtc passes AAC config= through verbatim"
            else
                bad "go2rtc AAC config= passthrough" "origin $CONFIG not found in restream SDP"
            fi
        fi
        curl -s -m 8 -X DELETE "$GO2RTC/api/streams?src=$G2NAME" >/dev/null 2>&1
    else
        bad "go2rtc API reachable" "$GO2RTC"
    fi
else
    skip "go2rtc leg (--go2rtc not given)"
fi

# ── 9c. SRT: MPEG-TS over SRT (rsr) (--srt) ──
if [ -n "$SRT_URL" ]; then
    # Accept host:port or a full srt:// URL; connect as a caller.
    case "$SRT_URL" in srt://*) SU=$SRT_URL ;; *) SU="srt://$SRT_URL" ;; esac
    case "$SU" in *\?*) : ;; *) SU="$SU?mode=caller&latency=120000" ;; esac
    # Bound every SRT call: a caller connect blocks until the listener
    # answers, and -t limits capture *after* connect, not the handshake.
    # An absent or wedged rsr would otherwise hang the whole battery.
    SRT_STREAMS=$(timeout -k 5 20 "$FFPROBE" -v error -show_entries stream=codec_type -of csv=p=0 \
        "$SU" 2>/dev/null | grep -vE '^$' | sort -u | tr '\n' ' ')
    SRT_STREAMS=$(echo "$SRT_STREAMS")  # collapse stray whitespace
    if echo "$SRT_STREAMS" | grep -q video; then
        ok "SRT: MPEG-TS carries video ($SRT_STREAMS)"
    else
        bad "SRT stream" "no video stream (${SRT_STREAMS:-none})"
    fi
    # Gate captures on the probe finding streams (no point capturing a
    # dead server), and require ffmpeg to exit 0: it does so only after
    # completing the full -t window, so a mid-capture stall killed by
    # the timeout reads as a failure, not an empty-log vacuous pass.
    if echo "$SRT_STREAMS" | grep -q video; then
        if timeout -k 5 "$((DUR + 20))" "$FFMPEG" -nostdin -v error -i "$SU" -t "$DUR" \
            -map 0:v -f null - >"$WORK/srt_v.log" 2>&1 &&
            [ "$(grep -ciE "$ERRPAT" "$WORK/srt_v.log")" -eq 0 ]; then
            ok "SRT: video decodes clean (${DUR}s)"
        else
            bad "SRT video decode" "stalled or errored; see $WORK/srt_v.log"
            show_errs "$WORK/srt_v.log"
        fi
    fi
    # Decode audio all the way to PCM: a wrong ADTS sample rate (the TS
    # muxer mislabeling HE-AAC) yields "scalefactor bands exceeds limit"
    # and zero samples, which a container-level check would miss.
    if echo "$SRT_STREAMS" | grep -q audio; then
        SRT_ARC=0
        timeout -k 5 "$((DUR + 20))" "$FFMPEG" -nostdin -v error -i "$SU" -t "$DUR" -map 0:a -f s16le \
            "$WORK/srt_a.raw" >"$WORK/srt_a.log" 2>&1 || SRT_ARC=$?
        SB=$(wc -c <"$WORK/srt_a.raw" 2>/dev/null)
        AE=$(grep -ciE "$ERRPAT|scalefactor|exceeds limit" "$WORK/srt_a.log")
        if [ "$SRT_ARC" -eq 0 ] && [ "${SB:-0}" -gt 10000 ] && [ "$AE" -eq 0 ]; then
            ok "SRT: audio decodes to PCM ($SB bytes, no errors)"
        else
            bad "SRT audio decode" "rc=$SRT_ARC, ${SB:-0} PCM bytes, $AE errors (ADTS rate mislabel?)"
            show_errs "$WORK/srt_a.log"
        fi
        rm -f "$WORK/srt_a.raw"
    fi
fi

# ── 9d. RTSPS/TLS (--tls rtsps://host:port/path) ──
if [ -n "$TLS_URL" ]; then
    THP=${TLS_URL#rtsps://}
    THP=${THP%%/*}
    THOST=${THP%%:*}
    TPORT=${THP##*:}
    [ "$TPORT" = "$THOST" ] && TPORT=322
    TPATH=/${TLS_URL#rtsps://*/}
    TLSRPT=$(python3 - "$PROBES" "$THOST" "$TPORT" "$TPATH" "${RTSP_USER:-}" "${RTSP_PASS:-}" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
user = sys.argv[5] or None
try:
    s = RtspSession(sys.argv[2], sys.argv[3], sys.argv[4], user=user,
                    password=sys.argv[6], tls=True)
except Exception as e:
    print(f"FAIL TLS handshake -- {e}")
    sys.exit(0)
proto = s.sock.version() or "unknown"
st, sdp = s.describe()
ok = "200" in st and "m=video" in sdp
print(("OK " if ok else "FAIL ") + f"TLS: DESCRIBE over rtsps ({proto}) -- {st}")
s.close()
EOF
)
    while IFS= read -r line; do
        case $line in
            OK\ *)   ok "${line#OK }" ;;
            FAIL\ *) bad "${line#FAIL }" ;;
        esac
    done <<< "$TLSRPT"
    # ffmpeg over rtsps: real media through the TLS transport
    TCRED=""
    [ -n "$RTSP_USER" ] && TCRED="$RTSP_USER:$RTSP_PASS@"
    if capture tls_media "$DUR" "rtsps://${TCRED}${THOST}:${TPORT}${TPATH}" tcp; then
        ok "TLS: clean media over rtsps (${DUR}s)"
    else
        bad "TLS media" "see $WORK/tls_media.log"
        show_errs "$WORK/tls_media.log"
    fi
fi

# ── 9e. RTMP push (--rtmp <listen-port>): rsp pushes to this host ──
# The device's rsp must be configured with [push] url pointing at this
# host: rtmp://<this-host>:<port>/live/raptortest (rsp reconnects every
# ~5s, so a fresh listener gets a connection within one cycle).
if [ -n "$RTMP_PORT" ]; then
    RTMP_REC="$WORK/rtmp_push.flv"
    # rsp reconnects every ~5s and sends fresh sequence headers on each
    # connect. Listen long enough to span a full reconnect so the
    # capture starts at a clean stream head, not mid-GOP.
    timeout -k 5 55 "$FFMPEG" -nostdin -v warning -listen 1 -timeout 40 \
        -i "rtmp://0.0.0.0:$RTMP_PORT/live/raptortest" \
        -t 10 -c copy -y "$RTMP_REC" >"$WORK/rtmp_listen.log" 2>&1
    if [ -s "$RTMP_REC" ]; then
        RTMP_INFO=$("$FFPROBE" -v error -show_entries stream=codec_type,codec_name \
            -of csv=p=0 "$RTMP_REC" 2>/dev/null | sort -u | tr '\n' ' ')
        if echo "$RTMP_INFO" | grep -q video; then
            ok "RTMP push received from rsp ($RTMP_INFO)"
        else
            bad "RTMP push stream content" "no video: ${RTMP_INFO:-empty}"
        fi
        "$FFMPEG" -nostdin -v error -i "$RTMP_REC" -f null - \
            >"$WORK/rtmp_decode.log" 2>&1
        RDN=$(grep -cviE 'non monotonically increasing dts to muxer|Last message repeated' \
            "$WORK/rtmp_decode.log")
        if [ "${RDN:-1}" -eq 0 ]; then
            ok "RTMP pushed stream decodes clean"
        else
            bad "RTMP pushed stream decode" "see $WORK/rtmp_decode.log"
            show_errs "$WORK/rtmp_decode.log"
        fi
    else
        bad "RTMP push" "nothing received on :$RTMP_PORT in 25s (is [push] url set to this host?)"
        tail -2 "$WORK/rtmp_listen.log" | sed 's/^/          /'
    fi
fi

# ── 9f. WebRTC (--webrtc <whip-url>): real WHIP/ICE/DTLS-SRTP client ──
# Measures decoded video framerate, stall stability, PTS discipline,
# and that audio decodes to real samples. Video requires an H264
# stream (rwd's WebRTC path is H264-only; point at the H264 sub).
if [ -n "$WEBRTC_URL" ]; then
    WVENV="$DIR/tools/webrtc-venv/bin/python"
    if [ -x "$WVENV" ]; then
        WRTC=$(timeout -k 5 45 "$WVENV" "$PROBES/webrtc_check.py" "$WEBRTC_URL" \
            "${RTSP_USER:-}" "${RTSP_PASS:-}" 12 0 1 2>&1)
        echo "$WRTC" >"$WORK/webrtc.txt"
        while IFS= read -r line; do
            case $line in
                OK\ *)   ok "${line#OK }" ;;
                FAIL\ *) bad "${line#FAIL }" ;;
                SKIP\ *) skip "${line#SKIP }" ;;
            esac
        done <<< "$WRTC"
        # Talk-back evidence on the device: rwd writes received client
        # audio into the speaker ring.
        if [ -n "$SSH_TARGET" ] && echo "$WRTC" | grep -q "OK WebRTC talk-back"; then
            if ssh -o ConnectTimeout=8 "$SSH_TARGET" 'test -e /dev/shm/rss_ring_speaker' 2>/dev/null; then
                ok "WebRTC talk-back audio landed (speaker ring on device)"
            else
                bad "WebRTC talk-back device evidence" "/dev/shm/rss_ring_speaker missing"
            fi
        fi
    else
        skip "WebRTC leg (tools/webrtc-venv missing — run tools/fetch-tools.sh)"
    fi
fi

# ── 10. Frigate record + clip verification (--frigate, docker) ──
if [ "$FRIGATE" = 1 ]; then
    if command -v docker >/dev/null 2>&1 && docker ps >/dev/null 2>&1; then
        FDIR=$(mktemp -d)
        FRIGATE_DIR=$FDIR
        mkdir -p "$FDIR/config" "$FDIR/media"
        cat >"$FDIR/config/config.yml" <<EOF
mqtt:
  enabled: false
cameras:
