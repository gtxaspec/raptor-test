num, den = (sys.argv[2].split("/") + ["1"])[:2]
nom = float(num) / float(den or 1)
tol = float(sys.argv[3])
meas = (len(v) - 1) / (v[-1] - v[0])
print(f"measured {meas:.2f}fps vs nominal {nom:.2f} (tol {tol:.0%})")
sys.exit(0 if nom > 0 and abs(meas - nom) / nom < tol else 1)
EOF
)
            if [ $? -eq 0 ]; then ok "SRT: video frame rate ($SFPS)"; else bad "SRT video frame rate" "$SFPS"; fi
        else
            skip "SRT fps (only $SVP video packets)"
        fi

        # A/V mux alignment and per-track monotonicity in the TS domain
        "$FFPROBE" -v error -select_streams a -show_entries packet=pts_time -of csv=p=0 \
            "$WORK/srt_av.mkv" 2>/dev/null | grep -vE 'N/A|^$' >"$WORK/srt_a.pts"
        SAP=$(wc -l <"$WORK/srt_a.pts")
        if [ "$SVP" -gt 30 ] && [ "$SAP" -gt 30 ]; then
            SSYNC=$(python3 - "$WORK/srt_v.pts" "$WORK/srt_a.pts" <<'EOF'
import sys
v = [float(x) for x in open(sys.argv[1])]
a = [float(x) for x in open(sys.argv[2])]
mono_v = all(y >= x for x, y in zip(v, v[1:]))
mono_a = all(y >= x for x, y in zip(a, a[1:]))
end_off = (a[-1] - v[-1]) * 1000
print(f"end_offset={end_off:+.0f}ms mono_v={mono_v} mono_a={mono_a} v={len(v)} a={len(a)}")
sys.exit(0 if (mono_v and mono_a and abs(end_off) < 500) else 1)
EOF
)
            if [ $? -eq 0 ]; then ok "SRT: A/V mux timestamps ($SSYNC)"; else bad "SRT A/V mux timestamps" "$SSYNC"; fi
        else
            skip "SRT A/V sync (v=$SVP a=$SAP packets)"
        fi

        # Cross-transport bitrate: the TS and RTSP legs read the same
        # ring, so their measured video rates must agree.
        if [ "$SVP" -gt 50 ] && [ -n "${RTSP_MBPS:-}" ]; then
            "$FFPROBE" -v error -select_streams v -show_entries packet=pts_time,size -of csv=p=0 \
                "$WORK/srt_av.mkv" 2>/dev/null | grep -vE 'N/A|^$' >"$WORK/srt_v.psz"
            SBR=$(python3 - "$WORK/srt_v.psz" "$RTSP_MBPS" <<'EOF'
import sys
rows = [l.split(",") for l in open(sys.argv[1]) if "," in l]
pts = [float(r[0]) for r in rows]
sz = [int(r[1]) for r in rows]
span = pts[-1] - pts[0]
if span < 5:
    print(f"span too short ({span:.1f}s)")
    sys.exit(2)
mbps = sum(sz) * 8 / span / 1e6
ref = float(sys.argv[2])
print(f"SRT {mbps:.2f}Mbps vs RTSP {ref:.2f}Mbps")
sys.exit(0 if ref > 0 and abs(mbps - ref) / ref <= 0.5 else 1)
EOF
)
            SBR_RC=$?
            if [ $SBR_RC -eq 0 ]; then ok "SRT: video bitrate agrees with RTSP leg ($SBR)"
            elif [ $SBR_RC -eq 2 ]; then skip "SRT bitrate ($SBR)"
            else bad "SRT vs RTSP bitrate" "$SBR"; fi
        else
            skip "SRT cross-transport bitrate (no RTSP reference)"
        fi

        # Decode audio all the way to PCM: a wrong ADTS sample rate (the TS
        # muxer mislabeling HE-AAC) yields "scalefactor bands exceeds limit"
        # and zero samples, which a container-level check would miss.
        if echo "$SRT_STREAMS" | grep -q audio; then
            timeout -k 5 40 "$FFMPEG" -nostdin -v warning -t 8 -i "$SU" -map 0:a \
                -f s16le - >"$WORK/srt_a.pcm" 2>"$WORK/srt_a.log"
            SRT_ARC=$?
            SB=$(stat -c%s "$WORK/srt_a.pcm" 2>/dev/null || echo 0)
            AE=$(grep -ciE "$ERRPAT|scalefactor|error" "$WORK/srt_a.log")
            if [ "$SRT_ARC" -eq 0 ] && [ "$SB" -gt 64000 ] && [ "$AE" -eq 0 ]; then
                ok "SRT: audio decodes to PCM ($SB bytes, no errors)"
            else
                bad "SRT audio decode" "rc=$SRT_ARC, ${SB:-0} PCM bytes, $AE errors (ADTS rate mislabel?)"
            fi
        fi

        # STREAMID routing: 'sub' must select the substream (different
        # dimensions than the default), and an unknown id must be
        # rejected before accept, not served the default.
        MAIN_DIMS=$("$FFPROBE" -v error -select_streams v -show_entries stream=width,height \
            -of csv=p=0 "$WORK/srt_av.mkv" 2>/dev/null | head -1)
        SUB_DIMS=$(timeout -k 5 20 "$FFPROBE" -v error -select_streams v \
            -show_entries stream=width,height -of csv=p=0 "$(srt_url "streamid=sub")" 2>/dev/null | head -1)
        if [ -z "$SUB_DIMS" ]; then
            skip "SRT STREAMID substream (no 'sub' stream served)"
        elif [ "$SUB_DIMS" != "$MAIN_DIMS" ]; then
            ok "SRT: STREAMID routes substream ($SUB_DIMS vs main $MAIN_DIMS)"
        else
            bad "SRT STREAMID routing" "streamid=sub returned main dimensions ($MAIN_DIMS)"
        fi
        if timeout -k 5 15 "$FFPROBE" -v error -show_entries stream=codec_type -of csv=p=0 \
            "$(srt_url "streamid=no_such_ring")" >/dev/null 2>&1; then
            bad "SRT unknown STREAMID" "connection with bogus streamid was served"
        else
            ok "SRT: unknown STREAMID rejected"
        fi

        # AES: with --srt-passphrase every call above already proved the
        # right key works; a wrong key must be refused at handshake.
        if [ -n "$SRT_PASSPHRASE" ]; then
            WRONG_URL="$SU_BASE"
            case "$WRONG_URL" in *\?*) WRONG_URL="$WRONG_URL&" ;; *) WRONG_URL="$WRONG_URL?" ;; esac
            if timeout -k 5 15 "$FFPROBE" -v error -show_entries stream=codec_type -of csv=p=0 \
                "${WRONG_URL}passphrase=WrongPassphrase123" >/dev/null 2>&1; then
                bad "SRT AES" "wrong passphrase was accepted"
            else
                ok "SRT: wrong passphrase refused (AES enforced)"
            fi
        else
            skip "SRT AES rejection (--srt-passphrase not given)"
        fi
    fi
fi

fi
if want "tls"; then
# ── 9d. RTSPS/TLS (--tls rtsps://host:port/path) ──
if [ -n "$TLS_URL" ]; then
    THP=${TLS_URL#rtsps://}
    THP=${THP%%/*}
    THOST=${THP%%:*}
    TPORT=${THP##*:}
    [ "$TPORT" = "$THOST" ] && TPORT=322
    TPATH=/${TLS_URL#rtsps://*/}
    TLSRPT=$(python3 - "$PROBES" "$THOST" "$TPORT" "$TPATH" "${RTSP_USER:-}" "${RTSP_PASS:-}" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
user = sys.argv[5] or None
try:
    s = RtspSession(sys.argv[2], sys.argv[3], sys.argv[4], user=user,
                    password=sys.argv[6], tls=True)
except Exception as e:
    print(f"FAIL TLS handshake -- {e}")
    sys.exit(0)
proto = s.sock.version() or "unknown"
st, sdp = s.describe()
ok = "200" in st and "m=video" in sdp
print(("OK " if ok else "FAIL ") + f"TLS: DESCRIBE over rtsps ({proto}) -- {st}")
s.close()
EOF
)
    while IFS= read -r line; do
        case $line in
            OK\ *)   ok "${line#OK }" ;;
            FAIL\ *) bad "${line#FAIL }" ;;
        esac
    done <<< "$TLSRPT"
    # ffmpeg over rtsps: real media through the TLS transport
    TCRED=""
    [ -n "$RTSP_USER" ] && TCRED="$RTSP_USER:$RTSP_PASS@"
    if capture tls_media "$DUR" "rtsps://${TCRED}${THOST}:${TPORT}${TPATH}" tcp; then
        ok "TLS: clean media over rtsps (${DUR}s)"
    else
        bad "TLS media" "see $WORK/tls_media.log"
        show_errs "$WORK/tls_media.log"
    fi
fi

fi
if want "rtmp"; then
# ── 9e. RTMP push (--rtmp <listen-port>): rsp pushes to this host ──
# The device's rsp must be configured with [push] url pointing at this
# host: rtmp://<this-host>:<port>/live/raptortest (rsp reconnects every
# ~5s, so a fresh listener gets a connection within one cycle).
if [ -n "$RTMP_PORT" ]; then
    RTMP_REC="$WORK/rtmp_push.flv"
    # Ask the device to start pushing now. With [push] autostart off
    # the daemon sits idle until this point instead of retrying into a
    # port nobody is listening on yet and filling the device log with
    # connect failures the log scan then reports as a fault. Harmless
    # when autostart is left on: the push is already running.
    # The JSON passthrough, not the bare verb: `raptorctl rsp start` is
    # the process-lifecycle command and no-ops on an already-running
    # daemon, so it never reaches rsp's own start handler.
    [ -n "$SSH_TARGET" ] && ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        'raptorctl -j "{\"daemon\":\"rsp\",\"cmd\":\"start\"}"' >/dev/null 2>&1
    # rsp reconnects every ~5s and sends fresh sequence headers on each
    # connect. Listen long enough to span a full reconnect so the
    # capture starts at a clean stream head, not mid-GOP.
    timeout -k 5 55 "$FFMPEG" -nostdin -v warning -listen 1 -timeout 40 \
        -i "rtmp://0.0.0.0:$RTMP_PORT/live/raptortest" \
        -t 10 -c copy -y "$RTMP_REC" >"$WORK/rtmp_listen.log" 2>&1
    if [ -s "$RTMP_REC" ]; then
        RTMP_INFO=$("$FFPROBE" -v error -show_entries stream=codec_type,codec_name \
            -of csv=p=0 "$RTMP_REC" 2>/dev/null | sort -u | tr '\n' ' ')
        if echo "$RTMP_INFO" | grep -q video; then
            ok "RTMP push received from rsp ($RTMP_INFO)"
        else
            bad "RTMP push stream content" "no video: ${RTMP_INFO:-empty}"
        fi
        "$FFMPEG" -nostdin -v error -i "$RTMP_REC" -f null - \
            >"$WORK/rtmp_decode.log" 2>&1
        RDN=$(grep -cviE 'non monotonically increasing dts to muxer|Last message repeated' \
            "$WORK/rtmp_decode.log")
        if [ "${RDN:-1}" -eq 0 ]; then
            ok "RTMP pushed stream decodes clean"
        else
            bad "RTMP pushed stream decode" "see $WORK/rtmp_decode.log"
            show_errs "$WORK/rtmp_decode.log"
        fi
    else
        bad "RTMP push" "nothing received on :$RTMP_PORT in 25s (is [push] url set to this host?)"
        tail -2 "$WORK/rtmp_listen.log" | sed 's/^/          /'
    fi
    # Stop pushing again: the listener is gone, and leaving it running
    # only resumes the connect-failure spam for the rest of the pass.
    [ -n "$SSH_TARGET" ] && ssh -o ConnectTimeout=8 "$SSH_TARGET" \
        'raptorctl -j "{\"daemon\":\"rsp\",\"cmd\":\"stop\"}"' >/dev/null 2>&1
fi

fi
if want "webrtc"; then
# ── 9f. WebRTC (--webrtc <whip-url>): real WHIP/ICE/DTLS-SRTP client ──
# Measures decoded video framerate, stall stability, PTS discipline,
# and that audio decodes to real samples. Video requires an H264
# stream (rwd's WebRTC path is H264-only; point at the H264 sub).
if [ -n "$WEBRTC_URL" ]; then
    WVENV="$DIR/tools/webrtc-venv/bin/python"
    if [ -x "$WVENV" ]; then
        # Watch for the speaker ring while the session is up. Sampling
        # after the probe exits only worked while the probe leaked the
        # session: releasing it properly closes the ring, so the
        # evidence is gone by then. "Did it ever appear" is the real
        # question and does not depend on cleanup timing.
        SPKF="$WORK/speaker.txt"
        if [ -n "$SSH_TARGET" ]; then
            ( ssh -o ConnectTimeout=8 "$SSH_TARGET" \
                'for i in $(seq 90); do [ -e /dev/shm/rss_ring_speaker ] && { echo seen; exit 0; }; sleep 0.5; done; echo missing' \
                >"$SPKF" 2>/dev/null ) &
            SPKPID=$!
        fi
        WRTC=$(timeout -k 5 45 "$WVENV" "$PROBES/webrtc_check.py" "$WEBRTC_URL" \
            "${RTSP_USER:-}" "${RTSP_PASS:-}" 12 0 1 2>&1)
        echo "$WRTC" >"$WORK/webrtc.txt"
        while IFS= read -r line; do
            case $line in
                OK\ *)   ok "${line#OK }" ;;
                FAIL\ *) bad "${line#FAIL }" ;;
                SKIP\ *) skip "${line#SKIP }" ;;
            esac
        done <<< "$WRTC"
        # Talk-back evidence on the device: rwd writes received client
        # audio into the speaker ring.
        if [ -n "$SSH_TARGET" ] && echo "$WRTC" | grep -q "OK WebRTC talk-back"; then
            [ -n "${SPKPID:-}" ] && wait "$SPKPID" 2>/dev/null
            if grep -q seen "$SPKF" 2>/dev/null; then
                ok "WebRTC talk-back audio landed (speaker ring on device)"
            else
                bad "WebRTC talk-back device evidence" "/dev/shm/rss_ring_speaker never appeared"
            fi
        elif [ -n "${SPKPID:-}" ]; then
            wait "$SPKPID" 2>/dev/null
        fi
    else
        skip "WebRTC leg (tools/webrtc-venv missing — run tools/fetch-tools.sh)"
    fi
fi

fi
if want "frigate"; then
# ── 10. Frigate record + clip verification (--frigate, docker) ──
if [ "$FRIGATE" = 1 ]; then
    if command -v docker >/dev/null 2>&1 && docker ps >/dev/null 2>&1; then
        FDIR=$(mktemp -d)
        FRIGATE_DIR=$FDIR
        mkdir -p "$FDIR/config" "$FDIR/media"
        cat >"$FDIR/config/config.yml" <<EOF
mqtt:
  enabled: false
cameras:
  cam_tcp:
    enabled: true
    ffmpeg:
      inputs:
        - path: $URL
          roles: [record]
      output_args:
        record: preset-record-generic-audio-copy
    record:
      enabled: true
      retain:
        days: 1
        mode: all
    detect:
      enabled: false
  cam_udp:
    enabled: true
    ffmpeg:
      inputs:
        - path: $URL
          input_args: -avoid_negative_ts make_zero -fflags +genpts+discardcorrupt -timeout 5000000 -use_wallclock_as_timestamps 1
          roles: [record]
      output_args:
        record: preset-record-generic-audio-copy
    record:
      enabled: true
      retain:
        days: 1
        mode: all
    detect:
      enabled: false
EOF
        FNAME="raptor-test-frigate-$$"
        FRIGATE_NAME=$FNAME
        docker run -d --name "$FNAME" --shm-size=128m             -v "$FDIR/config:/config" -v "$FDIR/media:/media/frigate"             ghcr.io/blakeblackshear/frigate:stable >/dev/null 2>&1
        echo "  ....  frigate recording 75s (tcp + udp cameras)"
        sleep 75
        FERR=$(docker logs "$FNAME" 2>&1 | grep -ciE 'ffmpeg.*error|Unable to read|exceeded' )
        for cam in cam_tcp cam_udp; do
            SEG=$(ls -t "$FDIR"/media/recordings/*/*/"$cam"/*.mp4 2>/dev/null | sed -n 2p)
            [ -z "$SEG" ] && SEG=$(ls -t "$FDIR"/media/recordings/*/*/"$cam"/*.mp4 2>/dev/null | head -1)
            clip_verify "frigate $cam recorded clip" "$SEG"
        done
        if [ "${FERR:-0}" -eq 0 ]; then ok "frigate logs clean"; else bad "frigate logs" "$FERR error lines (docker logs $FNAME)"; fi
        docker exec "$FNAME" sh -c 'rm -rf /media/frigate/recordings /media/frigate/clips' >/dev/null 2>&1
        docker rm -f "$FNAME" >/dev/null 2>&1
        rm -rf "$FDIR"
        FRIGATE_NAME=""
        FRIGATE_DIR=""
    else
        skip "frigate leg (docker unavailable)"
    fi
else
    skip "frigate leg (--frigate not given)"
fi

fi
if want "reccheck"; then
# ── 11. Recorded-clip check for an external recorder (--record-check) ──
if [ -n "$RECDIR" ]; then
    # newest file is usually still being written; verify the previous one
    NEWEST=$(find "$RECDIR" -name '*.mp4' -type f -print0 2>/dev/null | xargs -0 -r ls -t 2>/dev/null | sed -n 2p)
    [ -z "$NEWEST" ] && NEWEST=$(find "$RECDIR" -name '*.mp4' -type f -print0 2>/dev/null | xargs -0 -r ls -t 2>/dev/null | head -1)
    clip_verify "recorded clip ($RECDIR)" "$NEWEST"
else
    skip "external recording check (--record-check not given)"
fi


late_legs
fi
print_result
