# clip_verify <name> <file> — a recorded clip must have sane streams,
# matching durations, and decode with zero errors.
clip_verify() {
    local name=$1 f=$2
    local slug
    slug=$(echo "$name" | tr -c 'A-Za-z0-9._-' '_')
    if [ ! -s "$f" ]; then
        bad "$name" "no file"
        return
    fi
    local info vdur adur
    info=$("$FFPROBE" -v error -show_entries stream=codec_type,duration -of csv=p=0 "$f" 2>/dev/null)
    vdur=$(echo "$info" | grep '^video' | cut -d, -f2 | cut -d. -f1)
    adur=$(echo "$info" | grep '^audio' | cut -d, -f2 | cut -d. -f1)
    "$FFMPEG" -nostdin -v error -i "$f" -f null - >"$WORK/$slug.decode.log" 2>&1
    local derr
    # The null muxer re-times to 1/1000 and nags about colliding dts
    # (wallclock-stamped recorders collide for real under bursty WiFi
    # arrival); drop the nag AND its "Last message repeated" tails.
    derr=$(grep -viE 'non monotonically increasing dts to muxer|Last message repeated' \
        "$WORK/$slug.decode.log" | grep -c .)
    # File-level timestamp truth instead: dts must never move backward.
    local vback
    vback=$("$FFPROBE" -v error -select_streams v -show_entries packet=dts -of csv=p=0 "$f" 2>/dev/null |
        awk 'NR>1 && $1+0 < prev+0 {n++} {prev=$1} END {print n+0}')
    if [ -z "$vdur" ]; then
        bad "$name" "no video stream"
    elif [ "${derr:-1}" -gt 0 ]; then
        bad "$name" "decode errors, see $WORK/$slug.decode.log"
    elif [ "${vback:-0}" -gt 0 ]; then
        bad "$name" "video dts moves backward $vback times in the file"
    elif [ -n "$adur" ] && { [ $((vdur - adur)) -gt 1 ] || [ $((adur - vdur)) -gt 1 ]; }; then
        bad "$name" "duration mismatch v=${vdur}s a=${adur}s"
    else
        ok "$name (v=${vdur}s a=${adur:-none}s, decode clean)"
    fi
}

# ── 7b. Slow-client smoke: readers that never keep up must not stall
#       or wound the server ──
SLOWRPT=$(timeout -k 5 90 python3 "$PROBES/slow_client.py" "$HOST" "$PORT" "$RPATH" \
    "${RTSP_USER:-}" "${RTSP_PASS:-}" "${RHD_URL:--}" 12 2>&1)
while IFS= read -r line; do
    case $line in
        OK\ *)   ok "${line#OK }" ;;
        FAIL\ *) bad "${line#FAIL }" ;;
