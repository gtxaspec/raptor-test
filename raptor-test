# show_errs <log> — print the matched error lines, indented.
show_errs() { grep -iE "$ERRPAT" "$1" | sort | uniq -c | sort -rn | head -3 | sed 's/^/          /'; }

# clip_verify <name> <file> — a recorded clip must have sane streams,
# matching durations, and decode with zero errors.
clip_verify() {
    local name=$1 f=$2
    local slug
    slug=$(echo "$name" | tr -c 'A-Za-z0-9._-' '_')
    if [ ! -s "$f" ]; then
        bad "$name" "no file"
        return
    fi
    local info vdur adur
    info=$("$FFPROBE" -v error -show_entries stream=codec_type,duration -of csv=p=0 "$f" 2>/dev/null)
    vdur=$(echo "$info" | grep '^video' | cut -d, -f2 | cut -d. -f1)
    adur=$(echo "$info" | grep '^audio' | cut -d, -f2 | cut -d. -f1)
    "$FFMPEG" -nostdin -v error -i "$f" -f null - >"$WORK/$slug.decode.log" 2>&1
    local derr
    # The null muxer re-times to 1/1000 and nags about colliding dts
    # (wallclock-stamped recorders collide for real under bursty WiFi
    # arrival); drop the nag AND its "Last message repeated" tails.
    derr=$(grep -viE 'non monotonically increasing dts to muxer|Last message repeated' \
        "$WORK/$slug.decode.log" | grep -c .)
    # File-level timestamp truth instead: dts must never move backward.
    local vback
    vback=$("$FFPROBE" -v error -select_streams v -show_entries packet=dts -of csv=p=0 "$f" 2>/dev/null |
        awk 'NR>1 && $1+0 < prev+0 {n++} {prev=$1} END {print n+0}')
    if [ -z "$vdur" ]; then
        bad "$name" "no video stream"
    elif [ "${derr:-1}" -gt 0 ]; then
        bad "$name" "decode errors, see $WORK/$slug.decode.log"
    elif [ "${vback:-0}" -gt 0 ]; then
        bad "$name" "video dts moves backward $vback times in the file"
    elif [ -n "$adur" ] && { [ $((vdur - adur)) -gt 1 ] || [ $((adur - vdur)) -gt 1 ]; }; then
        bad "$name" "duration mismatch v=${vdur}s a=${adur}s"
    else
        ok "$name (v=${vdur}s a=${adur:-none}s, decode clean)"
    fi
}

# capture <name> <seconds> <url> [transport] — run a decoding client,
# fail if any error-class line appears.
capture() {
    local name=$1 secs=$2 url=$3 transport=${4:-}
    local targ=()
    [ -n "$transport" ] && targ=(-rtsp_transport "$transport")
    timeout -k 5 $((secs + 14)) "$FFMPEG" -nostdin -v warning "${targ[@]}" -i "$url" \
        -t "$secs" -progress "$WORK/$name.progress" -f null - >"$WORK/$name.log" 2>&1
    # zero error lines AND real decoded media: a client that exits 0
    # without ever producing output (bad URL, own help text) must FAIL
    if [ "${AUDIO_ONLY:-0}" = 1 ]; then
        local ot
        ot=$(sed -n 's/^out_time_us=//p' "$WORK/$name.progress" 2>/dev/null | tail -1)
        [ "$(grep -ciE "$ERRPAT" "$WORK/$name.log")" -eq 0 ] && [ "${ot:-0}" -gt 500000 ]
    else
        local frames
        frames=$(sed -n 's/^frame=//p' "$WORK/$name.progress" 2>/dev/null | tail -1)
        [ "$(grep -ciE "$ERRPAT" "$WORK/$name.log")" -eq 0 ] && [ "${frames:-0}" -gt 0 ]
    fi
}

echo "=== raptor-test: $URL ==="
echo "    client: $("$FFMPEG" -version 2>/dev/null | head -1 | grep -oE 'version [^ ]+' || echo unknown) ($FFMPEG)"
echo "    logs: $WORK"

if want "signaling"; then
# ── 1. Signaling (DESCRIBE) ──
SDP=$(python3 - "$PROBES" "$HOST" "$PORT" "$RPATH" "${RTSP_USER:-}" "${RTSP_PASS:-}" <<'EOF'
import sys
sys.path.insert(0, sys.argv[1])
from rtsplib import RtspSession
user = sys.argv[5] or None
s = RtspSession(sys.argv[2], sys.argv[3], sys.argv[4], user=user, password=sys.argv[6])
