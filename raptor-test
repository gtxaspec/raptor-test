if [ -n "$SOAK_MIN" ]; then
    DEADLINE=$(( $(date +%s) + SOAK_MIN * 60 ))
    CYCLE=0
    SOAK_FAILS=0
    rss_of() { ssh -o ConnectTimeout=6 "$SSH_TARGET" "awk '/VmRSS/{print \$2}' /proc/\$(pidof $1)/status 2>/dev/null" 2>/dev/null; }
    fds_of() { ssh -o ConnectTimeout=6 "$SSH_TARGET" "ls /proc/\$(pidof $1)/fd 2>/dev/null | wc -l" 2>/dev/null; }
    if [ -n "$SSH_TARGET" ]; then
        RVD_RSS0=$(rss_of rvd); RSD_RSS0=$(rss_of rsd)
        RVD_FD0=$(fds_of rvd);  RSD_FD0=$(fds_of rsd)
        echo "    soak baseline: rvd rss=${RVD_RSS0:-?}kB fd=${RVD_FD0:-?} | rsd rss=${RSD_RSS0:-?}kB fd=${RSD_FD0:-?}"
    fi
    while [ "$(date +%s)" -lt "$DEADLINE" ]; do
