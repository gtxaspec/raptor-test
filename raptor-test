done <<<"$SLOWRPT"

# ── 8a. RHD cold-start snapshots (--rhd --cold): must run before any
#       other JPEG traffic, since a viewer holds the encoder up and
#       leaves no cold path to test ──
if [ -n "$RHD_URL" ] && [ "$COLD" = 1 ]; then
    timeout -k 5 180 python3 "$PROBES/rhd_cold.py" "$RHD_URL" \
        ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} 25 >"$WORK/rhd_cold.txt" 2>&1
    while IFS= read -r line; do
