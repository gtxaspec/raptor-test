        cur = {"pts": None, "hex": []}
    elif line == "[/PACKET]":
        if cur is not None:
            pkts.append(cur)
            cur = None
    elif cur is not None:
        if line.startswith("pts_time="):
            v = line.split("=", 1)[1]
            cur["pts"] = None if v == "N/A" else float(v)
        elif ": " in line:
            off, _, rest = line.partition(": ")
            if off.replace(" ", "").isalnum():
                cur["hex"].append(rest[:40].replace(" ", ""))

