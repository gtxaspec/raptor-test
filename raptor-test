    # bandwidth-sensitive clients (the live555 family sizes receive
    # buffers from it), and a delivered rate far off the declared one is
    # how silent throttling shows up (an fps-crippled encoder emits
    # proportionally fewer bits). CBR converges over the 12s window but
    # content sways it, so the tolerance is generous and flag-tunable.
    VBAS=$(printf '%s\n' "$SDP" | awk '/^m=video/{v=1;next} /^m=/{v=0} v&&sub(/^b=AS:/,""){print;exit}' | tr -d '\r')
    if [ -n "$VBAS" ] && [ "$VBAS" -gt 0 ] 2>/dev/null; then
        "$FFPROBE" -v error -select_streams v -show_entries packet=pts_time,size \
            -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | grep -vE 'N/A|^$' >"$WORK/v.psz"
        BRRES=$(python3 - "$WORK/v.psz" "$VBAS" "$BITRATE_TOL" <<'EOF'
import sys
rows = [l.split(",") for l in open(sys.argv[1]) if "," in l]
pts = [float(r[0]) for r in rows]
sz = [int(r[1]) for r in rows]
declared = int(sys.argv[2]) * 1000
tol = float(sys.argv[3])
span = pts[-1] - pts[0]
if span < 5:
    print(f"span too short ({span:.1f}s)")
    sys.exit(2)
bps = sum(sz) * 8 / span
# Per-2s windows show whether the rate is steady or oscillating.
win = {}
for p, s in zip(pts, sz):
    win.setdefault(int((p - pts[0]) // 2), []).append(s)
rates = [sum(v) * 8 / 2 for k, v in sorted(win.items()) if k < int(span // 2)]
lo, hi = (min(rates), max(rates)) if rates else (bps, bps)
# Only OVERSHOOT fails: clients size buffers from b=AS, so exceeding
# it is the harmful direction. Undershoot is legitimate (static or
# dark scenes compress to almost nothing on these encoders) and is
# reported for visibility; throttle-class bugs show up in the fps
# checks instead.
print(f"measured {bps/1e6:.2f}Mbps vs declared {declared/1e6:.2f} "
      f"(windows {lo/1e6:.2f}..{hi/1e6:.2f}, overshoot tol {tol:.0%})")
sys.exit(0 if bps <= declared * (1 + tol) else 1)
EOF
)
        BR_RC=$?
        RTSP_MBPS=$(printf '%s' "$BRRES" | sed -n 's/^measured \([0-9.]*\)Mbps.*/\1/p')
        if [ $BR_RC -eq 0 ]; then ok "video bitrate within b=AS ($BRRES)"
        elif [ $BR_RC -eq 2 ]; then skip "video bitrate ($BRRES)"
        else bad "video bitrate vs b=AS" "$BRRES"; fi
    else
        skip "video bitrate (no b=AS advertised)"
    fi
fi
if [ "$AP" -gt 30 ]; then
    ARATE=$("$FFPROBE" -v error -select_streams a -show_entries stream=sample_rate,channels -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | head -1)
    AR=$(echo "$ARATE" | cut -d, -f1)
    ACH=$(echo "$ARATE" | cut -d, -f2)
    ABYTES=$(timeout 60 "$FFMPEG" -nostdin -v quiet -i "$WORK/ts.mkv" -map a -f s16le - 2>/dev/null | wc -c)
    SAMPRES=$(python3 - "$WORK/a.pts" "$ABYTES" "${AR:-0}" "${ACH:-1}" <<'EOF'
import sys
a = [float(x) for x in open(sys.argv[1])]
span = a[-1] - a[0]
got = int(sys.argv[2]) // (2 * int(sys.argv[4]))
want = int(sys.argv[3]) * span
print(f"decoded {got} samples vs {want:.0f} expected over {span:.0f}s")
sys.exit(0 if want > 0 and abs(got - want) / want < 0.1 else 1)
EOF
)
    if [ $? -eq 0 ]; then ok "audio decodes at declared rate ($SAMPRES)"; else bad "audio decoded sample count" "$SAMPRES"; fi

    # Channel configuration: what the SDP declares vs what a decoder
    # emits, per codec. Two asymmetries are legitimate, both of the
    # same shape (declared mono, decoder shows 2ch of identical
    # content):
    #   AAC  - ffmpeg presumes Parametric Stereo on ANY mono+SBR
    #          stream (aacdec: "Treating HE-AAC mono as stereo") and
    #          mirrors the one channel into two.
    #   Opus - RFC 7587 mandates the rtpmap always read opus/48000/2
    #          regardless of content (channelness is sprop-stereo,
    #          absent = mono), and decoders fill a stereo layout from
    #          a mono packet by duplication.
    # Those pass ONLY if L and R decode identical; distinct content
    # means real stereo leaked into a mono-configured stream. G.711,
    # L16 and AAC-LC have no such excuse and must match exactly.
    ASCCH=$(python3 - "$SDP" <<'EOF' 2>/dev/null
import re
import sys

class Bits:
    def __init__(self, data):
        self.d = data
        self.p = 0
    def take(self, n):
        v = 0
        for _ in range(n):
            v = (v << 1) | ((self.d[self.p >> 3] >> (7 - (self.p & 7))) & 1)
            self.p += 1
        return v
    def left(self):
        return len(self.d) * 8 - self.p

def asc_channels(hexcfg):
    b = Bits(bytes.fromhex(hexcfg))
    aot = b.take(5)
    if aot == 31:
        aot = 32 + b.take(6)
    if b.take(4) == 15:          # samplingFrequencyIndex escape
        b.take(24)
    chans = b.take(4)
    sbr = ps = False
    if aot in (5, 29):           # explicit hierarchical SBR / SBR+PS
        sbr, ps = True, aot == 29
        if b.take(4) == 15:
            b.take(24)
        aot = b.take(5)
    if aot != 2 or chans == 0:   # PCE or non-LC core: not a raptor stream
        sys.exit(1)
    b.take(3)                    # GASpecificConfig flags (raptor: all 0)
    if not sbr and b.left() >= 16:   # backward-compatible syncExtension
        if b.take(11) == 0x2B7:
            ext = b.take(5)
            if ext == 5 and b.take(1):
                sbr = True
                if b.take(4) == 15:
                    b.take(24)
                if b.left() >= 12 and b.take(11) == 0x548:
                    ps = b.take(1) == 1
    return chans, "ps" if ps else "sbr" if sbr else "lc"

sdp = sys.argv[1]
main = None
for sec in re.split(r"(?m)^m=", sdp)[1:]:
    # The backchannel section is camera INPUT (sendonly): a receiver
    # never decodes it, so channel assertions don't apply there.
    if sec.startswith("audio") and not re.search(r"(?mi)^a=(sendonly|inactive)\s*$", sec):
        main = sec
        break
if not main:
    sys.exit(1)
# Codec + declared channels: prefer the rtpmap; fall back to the
# RFC 3551 static payload-type table, since G.711 sections legally
# omit the rtpmap (RTP/AVP 0 and 8 imply PCMU/8000/1 and PCMA/8000/1).
STATIC_PT = {0: ("pcmu", 1), 8: ("pcma", 1), 10: ("l16", 2), 11: ("l16", 1)}
rm = re.search(r"(?mi)^a=rtpmap:\d+\s+([A-Za-z0-9._-]+)/\d+(?:/(\d+))?", main)
if rm:
    codec = rm.group(1).lower()
    rmch = int(rm.group(2) or 1)
else:
    mline = re.match(r"audio\s+\d+\s+\S+\s+(\d+)", main)
    if not mline or int(mline.group(1)) not in STATIC_PT:
        sys.exit(1)
    codec, rmch = STATIC_PT[int(mline.group(1))]
if codec == "mpeg4-generic":
    cm = re.search(r"config=([0-9A-Fa-f]+)", main)
    if not cm:
        sys.exit(1)
    chans, mode = asc_channels(cm.group(1))
    print(f"{chans} {mode}")
elif codec == "opus":
    st = re.search(r"(?i)(?:sprop-)?stereo\s*=\s*1", main)
    print(f"{2 if st else 1} opus")
elif codec in ("l16", "pcmu", "pcma"):
    print(f"{rmch} {codec}")
else:
    sys.exit(1)
EOF
)
    if [ -z "$ASCCH" ]; then
        skip "audio channels (no decodable main audio track in SDP)"
    else
        DCH=${ASCCH% *}
        AMODE=${ASCCH#* }
        EXP=$DCH
        [ "$AMODE" = ps ] && EXP=2   # explicit PS reconstructs stereo
        if [ "${ACH:-0}" = "$EXP" ]; then
            ok "audio channels: decoded $ACH matches declared ($DCH ch, $AMODE)"
        elif [ "$DCH" = 1 ] && [ "${ACH:-0}" = 2 ] && { [ "$AMODE" = sbr ] || [ "$AMODE" = opus ]; }; then
            UPWHY="HE-AAC PS presumption"
            [ "$AMODE" = opus ] && UPWHY="opus stereo layout (rtpmap is always /2)"
            LRRES=$(timeout 60 "$FFMPEG" -nostdin -v quiet -i "$WORK/ts.mkv" -map a -f f32le - 2>/dev/null | python3 -c '
import struct, sys
d = sys.stdin.buffer.read()
n = len(d) // 8
maxd = 0.0
for i in range(n):
    l, r = struct.unpack_from("<ff", d, i * 8)
    if abs(l - r) > maxd:
        maxd = abs(l - r)
print(f"{n} frames, max|L-R|={maxd:.3g}")
sys.exit(0 if n > 1000 and maxd < 1e-6 else 1)
')
            if [ $? -eq 0 ]; then
                ok "audio channels: declared mono shown 2ch by $UPWHY, content mono ($LRRES)"
            else
                bad "audio channels" "declared mono ($AMODE) decodes 2ch with DIFFERENT content ($LRRES)"
            fi
        else
            bad "audio channels" "declared $DCH ch ($AMODE) but decoder emits ${ACH:-none}"
        fi
    fi
fi

# Raw elementary stream: GOP cadence + per-frame SEI presence
VCODEC=$("$FFPROBE" -v error -select_streams v -show_entries stream=codec_name -of csv=p=0 "$WORK/ts.mkv" 2>/dev/null | head -1)
case "$VCODEC" in
h264) RAWFMT=h264 CEN=h264 ;;
hevc) RAWFMT=hevc CEN=h265 ;;
*) RAWFMT="" ;;
esac
if [ -n "$RAWFMT" ]; then
    timeout -k 5 24 "$FFMPEG" -nostdin -v quiet -rtsp_transport tcp -i "$URL" -map 0:v -c copy -t 15 -f "$RAWFMT" -y "$WORK/raw.es" 2>/dev/null
    CENSUS=$(python3 "$PROBES/nal_census.py" "$WORK/raw.es" "$CEN")
    echo "$CENSUS" >"$WORK/census.txt"
    IDRN=$(echo "$CENSUS" | grep -o 'idr=[0-9]*' | cut -d= -f2)
    VCLN=$(echo "$CENSUS" | grep -o 'vcl=[0-9]*' | cut -d= -f2)
    SEIN=$(echo "$CENSUS" | grep -o 'sei=[0-9]*' | cut -d= -f2)
    if [ "${IDRN:-0}" -ge 2 ]; then
        ok "GOP cadence: $IDRN keyframes in 15s ($CENSUS)"
    else
        bad "GOP cadence" "$CENSUS — a joiner may wait forever for a keyframe"
    fi
    if [ "${SEIN:-0}" -ge $((VCLN * 9 / 10)) ] && [ "${VCLN:-0}" -gt 0 ]; then
        ok "per-frame SEI present (${SEIN}/${VCLN} frames)"
    elif [ "${SEIN:-0}" -eq 0 ]; then
        skip "per-frame SEI (none in stream — raptor sei_timecode off or non-raptor server)"
    else
        bad "per-frame SEI coverage" "$SEIN of $VCLN frames"
    fi
    # GOP adherence: keyframes must be strictly periodic (a drifting
    # or elastic GOP breaks recorder segmenting and joiner latency);
    # with --gop the modal interval must equal the configured value.
    GOPI=$(echo "$CENSUS" | grep -o 'gopint=[0-9]*' | cut -d= -f2)
    GOPD=$(echo "$CENSUS" | grep -o 'gopdev=[0-9]*' | cut -d= -f2)
    GOPN=$(echo "$CENSUS" | grep -o 'gopn=[0-9]*' | cut -d= -f2)
    if [ "${GOPN:-0}" -ge 2 ]; then
        if [ "${GOPD:-99}" -le 1 ]; then
            ok "GOP interval regular (${GOPI} frames, maxdev ${GOPD}, ${GOPN} intervals)"
        else
            bad "GOP interval regularity" "modal=${GOPI} maxdev=${GOPD} over ${GOPN} intervals"
        fi
        if [ -n "$GOP_EXPECT" ]; then
            if [ "${GOPI:-0}" -eq "$GOP_EXPECT" ]; then
                ok "GOP interval matches configured ($GOP_EXPECT frames)"
            else
                bad "GOP interval vs configured" "measured ${GOPI}, configured $GOP_EXPECT"
            fi
        fi
    else
        skip "GOP interval regularity (fewer than 3 keyframes in the window)"
    fi
fi

# ── 4d. RFC conformance (RFC 2326 / 4566 / 3550 / 3640) ──
python3 "$PROBES/rfc_check.py" "$HOST" "$PORT" "$RPATH" 8 ${RTSP_USER:+"$RTSP_USER" "$RTSP_PASS"} >"$WORK/rfc.txt" 2>&1
while IFS= read -r line; do
    case "$line" in
    OK\ *) ok "${line#OK }" ;;
    FAIL\ *) bad "${line#FAIL }" ;;
    SKIP\ *) skip "${line#SKIP }" ;;
    esac
done <"$WORK/rfc.txt"

# ── 4e. RTSP parser fuzzing (--fuzz): malformed input, liveness-checked ──
if [ "$FUZZ" = 1 ]; then
    FZ=$(timeout -k 5 100 python3 "$PROBES/fuzz_rtsp.py" "$HOST" "$PORT" 300 \
        "${RTSP_USER:-}" "${RTSP_PASS:-}" 80 2>&1)
    echo "$FZ" | grep -q '^OK ' && ok "$(echo "$FZ" | sed -n 's/^OK //p')" \
        || bad "RTSP fuzzing" "$(echo "$FZ" | sed -n 's/^FAIL //p' | head -1)"
else
