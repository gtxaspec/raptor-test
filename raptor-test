    fi
    if [ -n "$SSH_TARGET" ]; then
        RVD_RSS1=$(rss_of rvd); RSD_RSS1=$(rss_of rsd)
        RVD_FD1=$(fds_of rvd);  RSD_FD1=$(fds_of rsd)
        echo "    soak end: rvd rss=${RVD_RSS1:-?}kB fd=${RVD_FD1:-?} | rsd rss=${RSD_RSS1:-?}kB fd=${RSD_FD1:-?}"
        for d in RVD RSD; do
            R0=$(eval echo \$${d}_RSS0); R1=$(eval echo \$${d}_RSS1)
            F0=$(eval echo \$${d}_FD0);  F1=$(eval echo \$${d}_FD1)
            if [ -n "$R0" ] && [ -n "$R1" ] && [ "$R0" -gt 0 ] 2>/dev/null; then
                if [ $((R1 * 100)) -le $((R0 * 125)) ]; then
