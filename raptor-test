    print(f"FAIL only {len(pkts)} video packets in the probe window")
    sys.exit(0)

head = "".join(pkts[0]["hex"])[:24]
try:
    b = bytes.fromhex(head[: len(head) // 2 * 2])
except ValueError:
    b = b""
nal = -1
for j in range(len(b) - 4):
    if b[j:j + 3] == b"\x00\x00\x01":
        nal = b[j + 3]
        break
if codec == "hevc":
